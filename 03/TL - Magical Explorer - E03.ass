Dialogue: 0,0:00:00.00,0:00:07.00,main - italics,Kousuke,0,0,0,,{\fs17\an7\fe162\b1\fad(400,400)\bord2\blur5\4a&HFF&\fnSweetest Cat Ever\pos(6,-5.67)}\N{\c&HFFFF00&\4c&H8485E4&}SomeSub ekip arkadaşı arıyor!\N{\c&HFFFFFF&}Çevirmen:{\c&HFFFF00&} KaranlıkPasa\N{\c&HFFFFFF&}Encode:{\c&HFFFF00&} Velnoxy\N{\c&HFFFFFF&}Redaktör:{\c&HFFFF00&} Umav\N{\c&HFFFFFF&}Discord:{\c&HFFFF00&} discord.gg/somesub
Dialogue: 0,0:00:05.67,0:00:07.42,main - italics,Kousuke,0,0,0,,Gerçekten de varmış.
Dialogue: 0,0:00:08.21,0:00:10.15,main - italics,Kousuke,0,0,0,,Üç Büyükler'den biri.
Dialogue: 0,0:00:10.15,0:00:13.29,main - italics,Kousuke,0,0,0,,Su büyüsü kullanabildiği için \Nkendisine Su Ejderhası Prensesi de derler.
Dialogue: 0,0:00:13.29,0:00:15.51,main - italics,Kousuke,0,0,0,,Mizumori Yukine.
Dialogue: 0,0:00:22.76,0:00:24.44,main,Yukine,0,0,0,,Birine mi bakmıştın?
Dialogue: 0,0:00:27.36,0:00:29.82,main,Yukine,0,0,0,,Demek akademinin yeni öğrencisi sensin.
Dialogue: 0,0:00:29.82,0:00:30.64,main,Kousuke,0,0,0,,Evet.
Dialogue: 0,0:00:30.64,0:00:32.19,main,Kousuke,0,0,0,,Adım Takioto Kousuke.
Dialogue: 0,0:00:32.70,0:00:35.96,main,Yukine,0,0,0,,Ben de Ahlak Komitesi'nin \Nbaşkan yardımcısıyım.
Dialogue: 0,0:00:35.96,0:00:36.95,main,Yukine,0,0,0,,Adım Mizumori Yukine.
Dialogue: 0,0:00:37.43,0:00:39.66,main,Kousuke,0,0,0,,Ahlak Komitesi Başkan Yardımcısı mı?
Dialogue: 0,0:00:40.44,0:00:43.79,main - italics,Kousuke(M),0,0,0,,Akademinin Ahlak Komitesi'nde \Nyer almak demek...
Dialogue: 0,0:00:43.79,0:00:45.89,main - italics,Kousuke(M),0,0,0,,hem sözünün geçtiği hem de \Nçok güçlü olduğun anlamına gelir.
Dialogue: 0,0:00:46.62,0:00:48.63,main - italics,Kousuke(M),0,0,0,,Şaşırmış gibi yapmak \Nen doğru hamle olacaktır.
Dialogue: 0,0:00:48.63,0:00:51.34,main,Yukine,0,0,0,,O kadar da mühim bir mevki değil ya.
Dialogue: 0,0:00:51.34,0:00:53.51,main,Yukine,0,0,0,,Her zaman senden daha iyileri vardır sonuçta.
Dialogue: 0,0:00:53.51,0:00:57.40,main - italics,Kousuke(M),0,0,0,,Mizumori Yukine sadece dış görünüşüne değil.
Dialogue: 0,0:00:57.40,0:00:59.64,main - italics,Kousuke(M),0,0,0,,Kişiliğine ve diğer her şeyine de \Nhayran olduğum bir karakterdi.
Dialogue: 0,0:00:59.64,0:01:02.03,main - italics,Kousuke(M),0,0,0,,Savaş kadromdan neredeyse \Nhiç çıkarmazdım kendisini.
Dialogue: 0,0:01:02.03,0:01:05.22,main - italics,Kousuke(M),0,0,0,,O da güçlü boss'ları peş peşe \Ndize getirirdi.
Dialogue: 0,0:01:05.22,0:01:06.48,main - italics,Kousuke(M),0,0,0,,Canım tanrıçam benim.
Dialogue: 0,0:01:06.48,0:01:09.26,main,Yukine,0,0,0,,Buranın özel mülk olduğunu biliyor muydun?
Dialogue: 0,0:01:09.26,0:01:12.30,main,Yukine,0,0,0,,Ben de kullanmak için izin alıp geliyorum.
Dialogue: 0,0:01:12.30,0:01:13.77,main,Yukine,0,0,0,,Ama sahibinin kim olduğunu düşünürsek.
Dialogue: 0,0:01:13.77,0:01:16.07,main,Yukine,0,0,0,,Pek de büyük bir sorun teşkil etmez gerçi.
Dialogue: 0,0:01:16.45,0:01:17.59,main,Kousuke,0,0,0,,Sıkıntı yok.
Dialogue: 0,0:01:17.59,0:01:20.32,main,Kousuke,0,0,0,,Marino-san zaten evinde \Nkalmama izin veriyor.
Dialogue: 0,0:01:20.32,0:01:21.40,main,Yukine,0,0,0,,Anladım.
Dialogue: 0,0:01:21.40,0:01:23.15,main,Yukine,0,0,0,,Müdürün yanında kalan kişi sen misin?
Dialogue: 0,0:01:23.62,0:01:24.92,main,Yukine,0,0,0,,O zaman kusura bakma.
Dialogue: 0,0:01:24.92,0:01:26.97,main,Yukine,0,0,0,,Hiç sorun değil.
Dialogue: 0,0:01:27.54,0:01:30.41,main,Kousuke,0,0,0,,Kusura bakmayın, rahatsız ediyorum ama.
Dialogue: 0,0:01:30.41,0:01:32.26,main,Kousuke,0,0,0,,Sizden bir ricam olacaktı, Senpai.
Dialogue: 0,0:01:32.26,0:01:32.75,main,Yukine,0,0,0,,Nedir?
Dialogue: 0,0:01:33.06,0:01:35.57,main,Kousuke,0,0,0,,Beni eğitir misiniz lütfen?
Dialogue: 0,0:01:35.57,0:01:37.63,main,Kousuke,0,0,0,,Mümkünse, "Kalp Gözü" yeteneğini \Nöğrenene kadar.
Dialogue: 0,0:01:41.34,0:01:43.14,main - italics,Kousuke(M),0,0,0,,Eğer Kalp Gözü yeteneğini kazanırsam.
Dialogue: 0,0:01:43.70,0:01:45.58,main - italics,Kousuke(M),0,0,0,,Rahatça savaşabilirim.
Dialogue: 0,0:01:45.58,0:01:48.40,main - italics,Kousuke(M),0,0,0,,Şalım görüşümü kapatsa bile.
Dialogue: 0,0:01:48.40,0:01:49.99,main,Kousuke,0,0,0,,S-S-Senpai!
Dialogue: 0,0:01:49.99,0:01:52.48,main,Kousuke,0,0,0,,Bunun sahiden bir faydası oluyor mu?!
Dialogue: 0,0:01:54.43,0:01:56.24,main,Yukine,0,0,0,,Takioto, aklının başka yerlere kaydığını hissedebiliyorum!
Dialogue: 0,0:01:56.94,0:01:59.19,main,Yukine,0,0,0,,Dünya evi düşünceleri \Nzihninden kovduktan sonra.
Dialogue: 0,0:01:59.19,0:02:01.20,main,Yukine,0,0,0,,Gözlerini kapat ve vücudundaki \Nmanayı harekete geçir!
Dialogue: 0,0:02:01.20,0:02:03.91,main,Kousuke,0,0,0,,Hiçbir şey göremiyorum ki!
Dialogue: 0,0:02:03.91,0:02:06.37,main,Yukine,0,0,0,,Bunu öyle hemen kapamazsın zaten.
Dialogue: 0,0:02:06.71,0:02:08.58,main - italics,Kousuke(M),0,0,0,,Ama oyunda hatırladığım kadarıyla.
Dialogue: 0,0:02:08.58,0:02:12.08,main - italics,Kousuke(M),0,0,0,,Yukine-senpai ile üç tur çalışınca \Nbu yetenek öğreniliyordu.
Dialogue: 0,0:02:12.08,0:02:13.77,main,Yukine,0,0,0,,Acele etmene gerek yok.
Dialogue: 0,0:02:13.77,0:02:16.81,main,Yukine,0,0,0,,Tek yapman gereken adım adım \Nsabırla ilerlemeye devam etmek.
Dialogue: 0,0:02:17.68,0:02:19.09,main,Kousuke,0,0,0,,Senpai!
Dialogue: 0,0:02:21.16,0:02:24.01,main - italics,Kousuke(M),0,0,0,,Dünya evi düşünceleri bir türlü \Nkafamdan atamıyorum ki!
Dialogue: 0,0:04:01.42,0:04:03.97,main,Claris,0,0,0,,Yetenekler mi?
Dialogue: 0,0:04:03.97,0:04:05.93,main,Kousuke,0,0,0,,Temelini anlattı anlatmasına da.
Dialogue: 0,0:04:05.93,0:04:07.60,main,Kousuke,0,0,0,,Öğrenebileceğime dair zerre umudum yok.
Dialogue: 0,0:04:08.60,0:04:10.35,main,Claris,0,0,0,,Bir teoriye göre.
Dialogue: 0,0:04:13.77,0:04:19.36,main,Claris,0,0,0,,Yetenekler ve büyü, kişi onları gerçekten ama \Ngerçekten çok istediğinde daha kolay kazanılırmış.
Dialogue: 0,0:04:19.98,0:04:21.90,main,Claris,0,0,0,,Neden gözünüze gerçekten \Nistediğiniz bir şeyi kestirip.
Dialogue: 0,0:04:21.90,0:04:24.49,main,Claris,0,0,0,,Başlangıç olarak öğrenmesi \Nkolay bir şeyle yola koyulmuyorsunuz?
Dialogue: 0,0:04:24.49,0:04:26.28,main,Kousuke,0,0,0,,Kolay bir şey mi.
Dialogue: 0,0:04:27.28,0:04:30.58,main,Kousuke,0,0,0,,Peki ya manamı başkalarına aktarmak nasıl olur?
Dialogue: 0,0:04:30.91,0:04:32.79,main,Claris,0,0,0,,Yani bağış büyüsü mü?
Dialogue: 0,0:04:32.79,0:04:35.04,main,Claris,0,0,0,,Sizin gibi muazzam mana \Nmiktarına sahip biri için.
Dialogue: 0,0:04:35.04,0:04:36.46,main,Claris,0,0,0,,Oldukça etkili olacaktır.
Dialogue: 0,0:04:36.46,0:04:37.42,main,Kousuke,0,0,0,,Değil mi?
Dialogue: 0,0:04:37.42,0:04:40.42,main,Kousuke,0,0,0,,Özellikle de Ludie mana harcama \Nkonusunda sınır tanımıyor.
Dialogue: 0,0:04:40.96,0:04:45.30,main,Claris,0,0,0,,Ludie-sama henüz o kadar çok mana \Ntüketen büyüler öğrenmedi ki.
Dialogue: 0,0:04:45.30,0:04:47.47,main,Kousuke,0,0,0,,Ben ilerisinden bahsediyorum ya!
Dialogue: 0,0:04:48.05,0:04:52.31,main - italics,Kousuke(M),0,0,0,,Doğru ya, şimdilik sadece \Ntemel büyüleri biliyor.
Dialogue: 0,0:04:53.39,0:04:55.69,main,Ludie,0,0,0,,Kousuke, hazır mısın her şeye?
Dialogue: 0,0:04:55.69,0:04:57.02,main,Kousuke,0,0,0,,Ne için?
Dialogue: 0,0:04:57.02,0:04:59.19,main,Ludie,0,0,0,,Akademi yakında başlıyor ya hani.
Dialogue: 0,0:04:59.61,0:05:00.82,main,Kousuke,0,0,0,,Ben hiçbir hazırlık yapmadım.
Dialogue: 0,0:05:01.15,0:05:02.57,main,Ludie,0,0,0,,Ne şanslısın.
Dialogue: 0,0:05:02.57,0:05:04.78,main,Ludie,0,0,0,,Keşke ben de senin gibi tasasız olabilseydim.
Dialogue: 0,0:05:04.78,0:05:05.74,main,Kousuke,0,0,0,,Al bakalım.
Dialogue: 0,0:05:05.74,0:05:07.41,main,Kousuke,0,0,0,,Çikolatalı çilekli istiyordun, değil mi?
Dialogue: 0,0:05:08.99,0:05:11.66,main,Ludie,0,0,0,,Sana nelerden hoşlandığımı söylemiş miydim ki?
Dialogue: 0,0:05:12.12,0:05:13.33,main,Kousuke,0,0,0,,Şey.
Dialogue: 0,0:05:13.33,0:05:15.66,main - italics,Kousuke(M),0,0,0,,Elbette biliyorum.
Dialogue: 0,0:05:15.66,0:05:18.25,main - italics,Kousuke(M),0,0,0,,Oyunun sonunu defalarca izledim.
Dialogue: 0,0:05:18.25,0:05:21.05,main - italics,Kousuke(M),0,0,0,,Hangi fantezilerden hoşlandığını bile biliyorum.
Dialogue: 0,0:05:21.05,0:05:21.96,main,Kousuke,0,0,0,,Ha, sahi ya!
Dialogue: 0,0:05:21.96,0:05:24.67,main,Kousuke,0,0,0,,Bağış büyüsüyle ilgili ufak bir deneye \Nkatılmanı rica edebilir miyim?
Dialogue: 0,0:05:24.97,0:05:26.30,main,Ludie,0,0,0,,Neden benim?
Dialogue: 0,0:05:26.30,0:05:28.14,main,Kousuke,0,0,0,,Sana bir şeyler ısmarlarım!
Dialogue: 0,0:05:28.14,0:05:29.60,main,Ludie,0,0,0,,O zaman rame—
Dialogue: 0,0:05:30.76,0:05:32.56,main,Ludie,0,0,0,,Yani olur madem.
Dialogue: 0,0:05:35.27,0:05:36.52,main,Kousuke,0,0,0,,Kasma kendini.
Dialogue: 0,0:05:36.52,0:05:37.77,main,Ludie,0,0,0,,Kasmıyorum bir kere!
Dialogue: 0,0:05:42.82,0:05:43.98,main,Ludie,0,0,0,,Geliyor gibi sanki...
Dialogue: 0,0:05:44.40,0:05:46.74,main,Kousuke,0,0,0,,Biraz daha artırayım mı?
Dialogue: 0,0:05:46.74,0:05:50.45,main,Ludie,0,0,0,,Evet, kesinlikle içeri akıyor.
Dialogue: 0,0:05:50.45,0:05:51.08,main,Ludie,0,0,0,,Devam et.
Dialogue: 0,0:05:51.08,0:05:52.12,main,Ludie,0,0,0,,{\an8}ÇN: Noluyoruz hocam
Dialogue: 0,0:05:51.08,0:05:52.12,main,Ludie,0,0,0,,Biraz daha yükle.
Dialogue: 0,0:05:54.54,0:05:56.71,main,Ludie,0,0,0,,Hey!
Dialogue: 0,0:05:57.21,0:05:58.62,main,Ludie,0,0,0,,Bu güvenli mi sahiden?
Dialogue: 0,0:05:58.62,0:06:01.34,main,Ludie,0,0,0,,Çok fena gıdıklıyor?!
Dialogue: 0,0:06:01.34,0:06:03.67,main,Kousuke,0,0,0,,Güvenli olması lazım ya.
Dialogue: 0,0:06:05.05,0:06:06.30,main,Kousuke,0,0,0,,Baksana.
Dialogue: 0,0:06:06.30,0:06:07.67,main,Kousuke,0,0,0,,Tuhaf sesler çıkarıp durma.
Dialogue: 0,0:06:07.67,0:06:09.18,main,Ludie,0,0,0,,Bu tehlikeli.
Dialogue: 0,0:06:09.55,0:06:10.39,main,Ludie,0,0,0,,Durdur şunu.
Dialogue: 0,0:06:10.39,0:06:12.97,main,Kousuke,0,0,0,,Öyle birden durduramam ki.
Dialogue: 0,0:06:12.97,0:06:14.47,main,Ludie,0,0,0,,Aptal!
Dialogue: 0,0:06:26.78,0:06:30.16,main,Ludie,0,0,0,,Yardım et.
Dialogue: 0,0:06:33.74,0:06:34.99,main,Kousuke,0,0,0,,Ludie?!
Dialogue: 0,0:06:37.50,0:06:42.00,main - italics,Kousuke(M),0,0,0,,Bağış büyüsünün böyle bir \Nyan etkisi olduğunu hiç bilmiyordum.
Dialogue: 0,0:06:42.00,0:06:43.38,main - italics,Kousuke(M),0,0,0,,Ne zaman kullanacağıma \Nçok dikkat etmem gerekecek.
Dialogue: 0,0:06:54.56,0:06:56.10,main - italics,Kousuke(M),0,0,0,,Madem doğrudan darbe alacağım.
Dialogue: 0,0:06:56.10,0:06:58.14,main - italics,Kousuke(M),0,0,0,,Bari Ludie'nin çıplak vücuduna \Nbakarak nakavt olayım!
Dialogue: 0,0:06:58.14,0:06:58.85,main - italics,Kousuke(M),0,0,0,,Yapabilir miyim acaba?
Dialogue: 0,0:06:58.85,0:06:59.69,main - italics,Kousuke(M),0,0,0,,Görür müyüm?
Dialogue: 0,0:06:59.69,0:07:01.10,main - italics,Kousuke(M),0,0,0,,Gerçekten görmek istiyorum!
Dialogue: 0,0:07:01.10,0:07:02.94,main - italics,Kousuke(M),0,0,0,,Ne olur görmeme izin ver!
Dialogue: 0,0:07:05.11,0:07:07.07,main - italics,Kousuke(M),0,0,0,,Havluya mı sarınmış?!
Dialogue: 0,0:07:07.07,0:07:09.24,main - italics,Kousuke(M),0,0,0,,O havlu da nereden çıktı?!
Dialogue: 0,0:07:09.86,0:07:11.57,main - italics,Kousuke(M),0,0,0,,Neden havluya sarılmış ki?!
Dialogue: 0,0:07:11.57,0:07:14.53,main - italics,Kousuke(M),0,0,0,,O havlu niye var ki zaten?!
Dialogue: 0,0:07:14.53,0:07:16.33,main - italics,Kousuke(M),0,0,0,,Sanal dünyada.
Dialogue: 0,0:07:16.33,0:07:18.58,main - italics,Kousuke(M),0,0,0,,Onun çıplak hâlini \Nsayısız kez görmüştüm.
Dialogue: 0,0:07:18.58,0:07:20.75,main - italics,Kousuke(M),0,0,0,,Şimdi de kanlı canlı görmek istiyorum.
Dialogue: 0,0:07:20.75,0:07:22.25,main - italics,Kousuke(M),0,0,0,,Neden göremiyorum ya?!
Dialogue: 0,0:07:22.25,0:07:23.21,main - italics,Kousuke(M),0,0,0,,Görmek istiyorum!
Dialogue: 0,0:07:23.21,0:07:25.25,main - italics,Kousuke(M),0,0,0,,Çok istiyorum!
Dialogue: 0,0:07:34.60,0:07:35.60,main - italics,Kousuke(M),0,0,0,,Görüyorum.
Dialogue: 0,0:07:35.60,0:07:36.60,main - italics,Kousuke(M),0,0,0,,Görüyorum!
Dialogue: 0,0:07:36.60,0:07:38.06,main - italics,Kousuke(M),0,0,0,,Kocaman göğüslerinin üzerinde.
Dialogue: 0,0:07:38.06,0:07:40.81,main,Ludie,0,0,0,,Neye dik dik bakıyorsun öyle?!
Dialogue: 0,0:07:42.52,0:07:44.65,main,Kousuke,0,0,0,,Özür dilerim!
Dialogue: 0,0:07:50.28,0:07:52.11,main,Ludie,0,0,0,,Aman, neyse.
Dialogue: 0,0:07:53.45,0:07:55.16,main,Ludie,0,0,0,,Hadi affettim seni.
Dialogue: 0,0:07:55.41,0:07:56.95,main,Ludie,0,0,0,,Nasılsa üzerimde havlu vardı.
Dialogue: 0,0:07:56.95,0:07:59.70,main,Kousuke,0,0,0,,Teşekkür ederim, Ludie-sama.
Dialogue: 0,0:07:59.70,0:08:00.66,main - italics,Kousuke(M),0,0,0,,Özür dilerim ama.
Dialogue: 0,0:08:00.66,0:08:02.37,main - italics,Kousuke(M),0,0,0,,Aslında her şeyi gördüm.
Dialogue: 0,0:08:02.71,0:08:07.29,main,Ludie,0,0,0,,A-Ama sorumluluk almanı istiyorum.
Dialogue: 0,0:08:07.59,0:08:08.21,main,Kousuke,0,0,0,,Ha?
Dialogue: 0,0:08:08.21,0:08:10.76,main - italics,Kousuke(M),0,0,0,,Bir dakika, sorumluluk almak mı?
Dialogue: 0,0:08:10.76,0:08:11.59,main - italics,Kousuke(M),0,0,0,,Yoksa.
Dialogue: 0,0:08:11.88,0:08:15.01,main,Ludie,0,0,0,,Ne de olsa ben yüksek mevki sahibi biriyim.
Dialogue: 0,0:08:15.51,0:08:18.35,main,Ludie,0,0,0,,Kimsenin görmemesi gereken \Nyanlarım var.
Dialogue: 0,0:08:18.64,0:08:21.56,main,Ludie,0,0,0,,Şey ben âşık oldum.
Dialogue: 0,0:08:21.98,0:08:24.31,main,Ludie,0,0,0,,Utandığım için kimseye söyleyemedim.
Dialogue: 0,0:08:24.31,0:08:26.86,main,Ludie,0,0,0,,Ama vücudumun bunu istemesine \Nengel olamıyorum.
Dialogue: 0,0:08:28.23,0:08:29.65,main,Ludie,0,0,0,,Takioto Kousuke!
Dialogue: 0,0:08:29.65,0:08:30.73,main,Kousuke,0,0,0,,Emredin efendim!
Dialogue: 0,0:08:34.70,0:08:37.41,main,Ludie,0,0,0,,Ramen yemek istiyorum.
Dialogue: 0,0:08:41.20,0:08:42.83,main,Kousuke,0,0,0,,O üstündeki kılık kıyafet de ne öyle?
Dialogue: 0,0:08:42.83,0:08:44.41,main,Ludie,0,0,0,,Bir Tréfle olarak.
Dialogue: 0,0:08:44.41,0:08:48.13,main,Ludie,0,0,0,,insanların beni höpürdete höpürdete \Nramen yerken görmesine izin veremem.
Dialogue: 0,0:08:48.13,0:08:50.75,main,Kousuke,0,0,0,,Claris çok endişelenecek ama.
Dialogue: 0,0:08:53.38,0:08:54.72,main,Kousuke,0,0,0,,Şuradaki Yukine-senpai mi?
Dialogue: 0,0:08:58.80,0:09:01.68,main,Yukine,0,0,0,,Sizi burada görmeyi hiç \Nbeklemezdim, Tréfle-sama.
Dialogue: 0,0:09:03.56,0:09:05.44,main,Ludie,0,0,0,,Kousuke'nin hocasıydın, değil mi?
Dialogue: 0,0:09:05.44,0:09:06.65,main,Ludie,0,0,0,,Bana sadece Ludie diyebilirsin.
Dialogue: 0,0:09:06.65,0:09:07.90,main,Yukine,0,0,0,,Anladım.
Dialogue: 0,0:09:07.90,0:09:10.90,main,Yukine,0,0,0,,O hâlde ben de sana Ludie diyeceğim.
Dialogue: 0,0:09:10.90,0:09:11.90,main,Ludie,0,0,0,,Güzel.
Dialogue: 0,0:09:12.23,0:09:16.11,main,Kousuke,0,0,0,,Senpai, bir dahaki sefere bana katılıp \Nmatcha'lı parfe yer misiniz?
Dialogue: 0,0:09:16.11,0:09:18.28,main,Kousuke,0,0,0,,Bir sürü çeşit sipariş edip bölüşebiliriz.
Dialogue: 0,0:09:18.28,0:09:19.32,main,Yukine,0,0,0,,Gerçekten mi?
Dialogue: 0,0:09:19.74,0:09:21.54,main,Kousuke,0,0,0,,Bana her zaman bir şeyler öğretiyorsunuz.
Dialogue: 0,0:09:21.54,0:09:23.00,main,Kousuke,0,0,0,,Bırakın da ben ısmarlayayım.
Dialogue: 0,0:09:24.25,0:09:25.96,main,Yukine,0,0,0,,Takioto!
Dialogue: 0,0:09:25.96,0:09:28.50,main,Ludie,0,0,0,,Kousuke, parfe sever misin ki?
Dialogue: 0,0:09:28.50,0:09:30.84,main,Kousuke,0,0,0,,Tatlı olan her şeye bayılırım.
Dialogue: 0,0:09:30.84,0:09:32.96,main,Kousuke,0,0,0,,Özellikle de matcha'ya hiç dayanamam.
Dialogue: 0,0:09:32.96,0:09:33.92,main,Yukine,0,0,0,,Ben de!
Dialogue: 0,0:09:33.92,0:09:35.30,main,Yukine,0,0,0,,Matcha görünce kendimi kaybediyorum resmen.
Dialogue: 0,0:09:36.43,0:09:37.55,main - italics,Kousuke(M),0,0,0,,Biliyorum zaten!
Dialogue: 0,0:09:37.93,0:09:40.85,main - italics,Kousuke(M),0,0,0,,Hakkınızdaki her şeyi biliyorum, Senpai.
Dialogue: 0,0:09:41.39,0:09:42.51,main,Kousuke,0,0,0,,Sen de bize katılırsın, değil mi?
Dialogue: 0,0:09:43.47,0:09:44.85,main,Ludie,0,0,0,,Olur da.
Dialogue: 0,0:09:46.98,0:09:49.19,main,Kousuke,0,0,0,,Tabii bugün ramen gün—
Dialogue: 0,0:09:47.98,0:09:51.02,main,Ludie,0,0,0,,Sus!
Dialogue: 0,0:09:51.36,0:09:52.44,main,Aurelian,0,0,0,,İşte buradasın.
Dialogue: 0,0:09:59.07,0:10:00.24,main,Kousuke,0,0,0,,Ludie!
Dialogue: 0,0:10:04.70,0:10:07.37,main,Yukine,0,0,0,,Neler oluyor böyle?
Dialogue: 0,0:10:08.71,0:10:13.84,main,Kousuke,0,0,0,,Senpai, benimle oraya girer misiniz?
Dialogue: 0,0:10:14.30,0:10:15.84,main,Kousuke,0,0,0,,İçimde çok kötü bir his var.
Dialogue: 0,0:10:16.59,0:10:17.80,main,Kousuke,0,0,0,,Lütfen!
Dialogue: 0,0:10:23.06,0:10:26.06,main - italics,Kousuke(M),0,0,0,,Bu zindan, Fani Dünyanın Sarayı.
Dialogue: 0,0:10:26.06,0:10:28.39,main - italics,Kousuke(M),0,0,0,,Harap durumda batı tarzı bir konak.
Dialogue: 0,0:10:44.33,0:10:45.54,main,Kousuke,0,0,0,,Bu da ne?
Dialogue: 0,0:10:45.54,0:10:46.83,main,Yukine,0,0,0,,Onlar büyü parçacıkları.
Dialogue: 0,0:10:46.83,0:10:48.41,main,Yukine,0,0,0,,XP de diyebilirsin.
Dialogue: 0,0:10:48.96,0:10:50.62,main,Yukine,0,0,0,,Bu da bir büyü taşı.
Dialogue: 0,0:10:50.62,0:10:52.42,main,Yukine,0,0,0,,Okul başlayınca bunları öğreneceksin zaten.
Dialogue: 0,0:10:58.63,0:11:00.76,main,Yukine,0,0,0,,Şu da ateş büyüsü mühür taşı.
Dialogue: 0,0:11:00.76,0:11:02.43,main - italics,Kousuke(M),0,0,0,,Tıpkı oyundaki gibi.
Dialogue: 0,0:11:02.43,0:11:05.76,main - italics,Kousuke(M),0,0,0,,Mührü etkinleştirdiğinde taşa kazınmış \Nbüyüyü yapan bir eşya.
Dialogue: 0,0:11:06.56,0:11:08.48,main,Kousuke,0,0,0,,Bende kalmasının bir sakıncası var mı?
Dialogue: 0,0:11:08.48,0:11:09.27,main,Yukine,0,0,0,,Tabii.
Dialogue: 0,0:11:09.27,0:11:10.44,main,Yukine,0,0,0,,İşine yarayacaktır.
Dialogue: 0,0:11:10.94,0:11:11.90,main,Yukine,0,0,0,,Acele edelim.
Dialogue: 0,0:11:17.36,0:11:18.86,main,Kousuke,0,0,0,,Yol ayrımı.
Dialogue: 0,0:11:19.49,0:11:20.65,main,Kousuke,0,0,0,,Sağdan gidelim.
Dialogue: 0,0:11:23.16,0:11:25.12,main - italics,Kousuke(M),0,0,0,,Bu, Kötücül Lord Tarikatı'nın \Nhikâye olayı.
Dialogue: 0,0:11:25.12,0:11:26.49,main - italics,Kousuke(M),0,0,0,,Normalde akademiye girdikten sonra.
Dialogue: 0,0:11:26.49,0:11:30.00,main - italics,Kousuke(M),0,0,0,,Ludie'nin hikâyesinde ilerleyince \Ntetiklenmesi gerekiyordu.
Dialogue: 0,0:11:30.00,0:11:32.17,main - italics,Kousuke(M),0,0,0,,Şimdi tetiklenmesi gereken bir şey değildi bu.
Dialogue: 0,0:11:32.17,0:11:33.38,main,Kousuke,0,0,0,,Şimdi de soldan gidelim.
Dialogue: 0,0:11:33.79,0:11:38.13,main - italics,Kousuke(M),0,0,0,,Kesin burada bulunuyor olmam \Nyüzünden böyle oldu.
Dialogue: 0,0:11:41.55,0:11:45.93,main - italics,Kousuke(M),0,0,0,,Ludie'nin şu an bir canavara karşı \Nsavaşı kazanması çok zor.
Dialogue: 0,0:11:50.73,0:11:52.14,main - italics,Kousuke(M),0,0,0,,Acele etmeliyiz.
Dialogue: 0,0:11:52.94,0:11:53.90,main,Yukine,0,0,0,,Ne oldu?
Dialogue: 0,0:11:54.19,0:11:54.94,main,Kousuke,0,0,0,,Yok bir şey.
Dialogue: 0,0:11:54.94,0:11:56.65,main,Kousuke,0,0,0,,Soldaki yoldan devam edelim.
Dialogue: 0,0:11:57.82,0:12:00.99,main - italics,Kousuke(M),0,0,0,,Hikâyeyi bildiğim için \Navantajlı olmam gerekirken.
Dialogue: 0,0:12:01.99,0:12:04.36,main - italics,Kousuke(M),0,0,0,,Sırf biliyorum diye \Nbu kadar acele ediyorum.
Dialogue: 0,0:12:05.45,0:12:06.66,main,Yukine,0,0,0,,Takioto.
Dialogue: 0,0:12:07.41,0:12:09.87,main,Yukine,0,0,0,,Yolu nereden biliyorsun?
Dialogue: 0,0:12:09.87,0:12:12.41,main,Yukine,0,0,0,,Ludie sahiden ileride mi?
Dialogue: 0,0:12:13.29,0:12:15.00,main,Yukine,0,0,0,,Ne biliyorsun sen?
Dialogue: 0,0:12:15.00,0:12:16.59,main,Kousuke,0,0,0,,Özür dilerim.
Dialogue: 0,0:12:16.59,0:12:17.96,main,Kousuke,0,0,0,,Şu anda söyleyemem.
Dialogue: 0,0:12:17.96,0:12:21.47,main,Kousuke,0,0,0,,Ludie'nin burada olmamasını \Nben de çok isterdim.
Dialogue: 0,0:12:21.47,0:12:23.22,main,Kousuke,0,0,0,,Ama eğer buradaysa.
Dialogue: 0,0:12:23.22,0:12:24.93,main,Kousuke,0,0,0,,Ve saldırıya uğruyorsa.
Dialogue: 0,0:12:25.26,0:12:26.89,main - italics,Kousuke(M),0,0,0,,Tek çaremiz ilerlemeye devam etmek.
Dialogue: 0,0:12:28.31,0:12:31.60,main,Kousuke,0,0,0,,Sizi peşimden sürükleyip bir de \Nböyle davrandığım için özür dilerim.
Dialogue: 0,0:12:34.06,0:12:35.15,main,Kousuke,0,0,0,,Şey.
Dialogue: 0,0:12:38.02,0:12:38.90,main,Yukine,0,0,0,,Yok.
Dialogue: 0,0:12:38.90,0:12:40.28,main,Yukine,0,0,0,,Asıl ben özür dilerim.
Dialogue: 0,0:12:40.73,0:12:41.94,main,Kousuke,0,0,0,,Senpai?
Dialogue: 0,0:12:41.94,0:12:43.90,main,Yukine,0,0,0,,Seni yolundan alıkoydum.
Dialogue: 0,0:12:43.90,0:12:44.70,main,Yukine,0,0,0,,Hadi gidelim.
Dialogue: 0,0:12:45.03,0:12:45.99,main,Kousuke,0,0,0,,Bir dahaki sefere.
Dialogue: 0,0:12:49.33,0:12:51.12,main,Kousuke,0,0,0,,lütfen benim de savaşmama izin verin.
Dialogue: 0,0:12:59.04,0:13:00.34,main - italics,Kousuke(M),0,0,0,,Beklediğim gibi,
Dialogue: 0,0:13:00.34,0:13:03.09,main - italics,Kousuke(M),0,0,0,,Kalp Gözü yeteneği sayesinde \Nsavaşmak çok daha kolaylaştı.
Dialogue: 0,0:13:09.60,0:13:11.64,main,Yukine,0,0,0,,Bu nasıl bir güç böyle?
Dialogue: 0,0:13:11.64,0:13:14.60,main,Yukine,0,0,0,,Üstelik Kalp Gözü yeteneğini \Nşimdiden öğrenmiş mi?!
Dialogue: 0,0:13:17.48,0:13:18.44,main,Kousuke,0,0,0,,Bir ogre!
Dialogue: 0,0:13:18.44,0:13:19.40,main - italics,Kousuke(M),0,0,0,,Hay Allah, bu kötü oldu işte.
Dialogue: 0,0:13:19.40,0:13:20.32,main - italics,Kousuke(M),0,0,0,,Acele etmeliyiz.
Dialogue: 0,0:13:23.19,0:13:24.15,main,Kousuke,0,0,0,,Kusura bakmayın!
Dialogue: 0,0:13:24.15,0:13:25.65,main,Kousuke,0,0,0,,Bunları lütfen siz halledin!
Dialogue: 0,0:13:30.16,0:13:31.95,main,Yukine,0,0,0,,Takioto, tek başına gitmen \Nçok tehlikeli!
Dialogue: 0,0:13:32.33,0:13:33.33,main,Yukine,0,0,0,,Geri dön!
Dialogue: 0,0:13:40.79,0:13:41.67,main - italics,Kousuke(M),0,0,0,,Kahretsin!
Dialogue: 0,0:13:41.67,0:13:42.59,main - italics,Kousuke(M),0,0,0,,Umarım geç kalmamışımdır!
Dialogue: 0,0:13:42.92,0:13:44.09,main - italics,Kousuke(M),0,0,0,,Ludie!
Dialogue: 0,0:13:49.64,0:13:51.97,main,Kousuke,0,0,0,,Bırak onu!
Dialogue: 0,0:14:04.99,0:14:06.28,main,Kousuke,0,0,0,,Sana izin vermem!
Dialogue: 0,0:14:14.08,0:14:14.91,main,Ludie,0,0,0,,Kousuke...
Dialogue: 0,0:14:33.89,0:14:35.22,main,Ludie,0,0,0,,Kousuke, çekil oradan!
Dialogue: 0,0:14:39.14,0:14:40.35,main,Ludie,0,0,0,,Başardım!
Dialogue: 0,0:14:48.11,0:14:49.45,main,Ludie,0,0,0,,Ama.
Dialogue: 0,0:14:50.24,0:14:51.82,main - italics,Kousuke(M),0,0,0,,Acımasız Ogre.
Dialogue: 0,0:14:52.16,0:14:55.04,main - italics,Kousuke(M),0,0,0,,Normalde oyunun ortalarında \Nsavaşılan bir zindan boss'u bu.
Dialogue: 0,0:14:55.49,0:14:58.08,main - italics,Kousuke(M),0,0,0,,Ludie ve benim henüz oyunun başındaki \Nyeteneklere sahip olduğumuzu düşünürsek.
Dialogue: 0,0:14:58.08,0:14:59.41,main - italics,Kousuke(M),0,0,0,,Kazanmamızın imkânı yok.
Dialogue: 0,0:15:02.54,0:15:04.38,main - italics,Kousuke(M),0,0,0,,Kötü son canavarı resmen.
Dialogue: 0,0:15:06.00,0:15:06.88,main,Kousuke,0,0,0,,Ludie!
Dialogue: 0,0:15:06.88,0:15:08.76,main,Kousuke,0,0,0,,Ne olursa olsun sakın peşimden gelme!
Dialogue: 0,0:15:08.76,0:15:09.47,main,Ludie,0,0,0,,Ha?
Dialogue: 0,0:15:14.05,0:15:16.10,main,Kousuke,0,0,0,,Bunu burada, bu şekilde \Nkullanacağım hiç aklıma gelmezdi.
Dialogue: 0,0:15:18.89,0:15:20.77,main,Kousuke,0,0,0,,Daha güçlü olsaydım.
Dialogue: 0,0:15:20.77,0:15:23.36,main,Kousuke,0,0,0,,Buna başvurmak zorunda kalmazdım!
Dialogue: 0,0:15:29.86,0:15:32.28,main,Ludie,0,0,0,,Kousuke!
Dialogue: 0,0:15:40.16,0:15:44.46,main,Kousuke,0,0,0,,Hay Allah kahretmesin, niye \Naşağı düşen biz olduk ki?!
Dialogue: 0,0:15:45.63,0:15:46.80,main - italics,Kousuke(M),0,0,0,,Orijinal oyunda.
Dialogue: 0,0:15:46.80,0:15:50.76,main - italics,Kousuke(M),0,0,0,,bu, şehvet dolu bir sahneyi \Ntetikleyen seksi bir tuzaktı.
Dialogue: 0,0:15:50.76,0:15:53.51,main - italics,Kousuke(M),0,0,0,,Yapış yapış balçık manalarını emerken.
Dialogue: 0,0:15:53.51,0:15:56.68,main - italics,Kousuke(M),0,0,0,,Kadın karakterler giderek daha da azıyordu.
Dialogue: 0,0:15:57.68,0:15:59.39,main,Kousuke,0,0,0,,Hey, biliyor muydun?
Dialogue: 0,0:15:59.89,0:16:06.82,main,Kousuke,0,0,0,,RPG erogelerinin yüzde doksan dokuzu \Nsaçma sapan tuzaklarla doludur!
Dialogue: 0,0:16:09.19,0:16:12.53,main,Kousuke,0,0,0,,Hadi bakalım, önce hangisi tükenecek?
Dialogue: 0,0:16:12.53,0:16:14.53,main,Kousuke,0,0,0,,Senin canın mı, yoksa benim manam mı?
Dialogue: 0,0:16:15.37,0:16:17.45,main,Kousuke,0,0,0,,Hodri meydan!
Dialogue: 0,0:16:46.73,0:16:47.44,main,Kousuke,0,0,0,,Selam.
Dialogue: 0,0:16:47.81,0:16:48.36,main,Kousuke,0,0,0,,Beklettiğim için kusura bakma.
Dialogue: 0,0:16:49.73,0:16:50.82,main,Ludie,0,0,0,,Kousuke!
Dialogue: 0,0:16:51.15,0:16:53.90,main,Ludie,0,0,0,,Sen aklını mı kaçırdın?!
Dialogue: 0,0:16:56.53,0:16:58.78,main,Ludie,0,0,0,,Her yerin vıcık vıcık olmuş.
Dialogue: 0,0:16:59.37,0:17:00.74,main,Kousuke,0,0,0,,İyi olmana sevindim.
Dialogue: 0,0:17:01.54,0:17:03.04,main,Ludie,0,0,0,,Teşekkür ederim.
Dialogue: 0,0:17:03.04,0:17:03.71,main,Kousuke,0,0,0,,Lafı bile olmaz.
Dialogue: 0,0:17:07.58,0:17:09.63,main,Yukine,0,0,0,,Beni neden arkada bıraktın?
Dialogue: 0,0:17:09.63,0:17:11.13,main,Kousuke,0,0,0,,Özür dilerim.
Dialogue: 0,0:17:11.13,0:17:13.09,main,Kousuke,0,0,0,,Elimde değildi.
Dialogue: 0,0:17:13.09,0:17:15.84,main,Yukine,0,0,0,,İkinizin de iyi olmasına çok sevindim.
Dialogue: 0,0:17:15.84,0:17:18.47,main,Ludie,0,0,0,,Çok teşekkürler, Yukine-san.
Dialogue: 0,0:17:18.47,0:17:19.55,main,Yukine,0,0,0,,Pekala o zaman.
Dialogue: 0,0:17:19.55,0:17:22.18,main,Yukine,0,0,0,,Bir an önce buradan \Nçıkmak isterdim ama.
Dialogue: 0,0:17:22.68,0:17:25.44,main,Yukine,0,0,0,,Görünüşe göre yanımızda kaçış \Nbüyüsü mühür taşı yok.
Dialogue: 0,0:17:25.73,0:17:29.56,main,Kousuke,0,0,0,,Aslında ben bir çıkış yolu biliyorum.
Dialogue: 0,0:17:33.23,0:17:35.53,main,Yukine,0,0,0,,Yüzün niye asıldı öyle?
Dialogue: 0,0:17:35.53,0:17:39.28,main,Kousuke,0,0,0,,Şey, kolay sayılır ama bir yandan da.
Dialogue: 0,0:17:39.28,0:17:40.37,main,Kousuke,0,0,0,,Nasıl desem, biraz zor?
Dialogue: 0,0:17:44.87,0:17:45.83,main,Kousuke,0,0,0,,İşte burada.
Dialogue: 0,0:17:47.00,0:17:48.75,main,Yukine,0,0,0,,Antik bir dil.
Dialogue: 0,0:17:50.75,0:17:53.71,main,Kousuke,0,0,0,,Bu çubuğu deliğe sokarsanız.
Dialogue: 0,0:17:53.71,0:17:56.97,main,Kousuke,0,0,0,,Karşı tarafta insan şeklinde \Nbir silüet belirecek.
Dialogue: 0,0:17:56.97,0:17:58.34,main,Yukine,0,0,0,,Ha, şu mekanizma.
Dialogue: 0,0:17:59.01,0:18:01.43,main,Kousuke,0,0,0,,Eğer o silüetle aynı pozu verirseniz.
Dialogue: 0,0:18:01.76,0:18:05.64,main,Kousuke,0,0,0,,Kaidedeki mühür çubuğa \Nözel bir tür mana gönderecek.
Dialogue: 0,0:18:05.64,0:18:08.85,main,Kousuke,0,0,0,,Bu da enerji kaynağını devre dışı bırakacak.
Dialogue: 0,0:18:08.85,0:18:10.56,main,Ludie,0,0,0,,Tek yapmamız gereken bu mu yani?
Dialogue: 0,0:18:11.44,0:18:12.82,main,Yukine,0,0,0,,Kulağa yeterince kolay geliyor.
Dialogue: 0,0:18:12.82,0:18:14.82,main - italics,Kousuke(M),0,0,0,,Burası bir eroge zindanı!
Dialogue: 0,0:18:15.32,0:18:17.86,main - italics,Kousuke(M),0,0,0,,Hiç öyle biter mi sandınız!
Dialogue: 0,0:18:18.15,0:18:18.95,main,Ludie,0,0,0,,Ne oldu?
Dialogue: 0,0:18:18.95,0:18:21.32,main,Ludie,0,0,0,,Çıkar ağzındaki baklayı artık.
Dialogue: 0,0:18:21.62,0:18:25.95,main,Kousuke,0,0,0,,Belirecek olan silüetlerin \Nseksi pozlar olması gerekiyormuş.
Dialogue: 0,0:18:27.79,0:18:31.04,main,Kousuke,0,0,0,,Üstelik o mayoları giymezseniz \Nhiçbir işe yaramazmış!
Dialogue: 0,0:18:33.29,0:18:35.51,main,Ludie,0,0,0,,Neden öyle bir şey yapmak zorundaymışım ki?!
Dialogue: 0,0:18:35.80,0:18:37.84,main,Kousuke,0,0,0,,Tek yol bu!
Dialogue: 0,0:18:37.84,0:18:39.76,main,Ludie,0,0,0,,Dalga geçmeyi kessen iyi edersin!
Dialogue: 0,0:18:39.76,0:18:41.18,main,Kousuke,0,0,0,,O seksi pozu verirseniz.
Dialogue: 0,0:18:41.18,0:18:42.97,main,Kousuke,0,0,0,,Mana bir çırpıda birikecek!
Dialogue: 0,0:18:42.97,0:18:44.68,main,Kousuke,0,0,0,,Benim suçum değil ki!
Dialogue: 0,0:18:45.52,0:18:47.39,main,Yukine,0,0,0,,Şu mayodan mı bahsediyorsun?
Dialogue: 0,0:18:48.81,0:18:49.64,main,Kousuke,0,0,0,,Bu arada.
Dialogue: 0,0:18:49.64,0:18:52.77,main,Kousuke,0,0,0,,Bilmeniz gereken bir şey daha var.
Dialogue: 0,0:18:53.23,0:18:54.82,main,Ludie,0,0,0,,Dahası da mı var?!
Dialogue: 0,0:18:54.82,0:18:55.69,main - italics,Kousuke(M),0,0,0,,Aynen öyle.
Dialogue: 0,0:18:55.69,0:18:58.32,main - italics,Kousuke(M),0,0,0,,Akıl almaz bir şart daha devreye girecek.
Dialogue: 0,0:18:58.86,0:19:00.95,main - italics,Kousuke(M),0,0,0,,İşte {\i0}Magical Explorer{\i1} dediğin böyle olur.
Dialogue: 0,0:19:00.95,0:19:02.95,main,Kousuke,0,0,0,,Pozu yanlış verirseniz.
Dialogue: 0,0:19:02.95,0:19:05.91,main,Kousuke,0,0,0,,İnsanı azdıran bir gaz salınacak.
Dialogue: 0,0:19:07.58,0:19:10.17,main,Kousuke,0,0,0,,Ama söylenene göre bittikten sonra.
Dialogue: 0,0:19:10.17,0:19:11.71,main,Kousuke,0,0,0,,İçiniz sıcacık olacak.
Dialogue: 0,0:19:11.71,0:19:12.58,main,Kousuke,0,0,0,,Üşümeye karşı direnç kazanacak.
Dialogue: 0,0:19:12.58,0:19:13.50,main,Kousuke,0,0,0,,Omuzlarınız gevşeyecek.
Dialogue: 0,0:19:13.50,0:19:14.79,main,Kousuke,0,0,0,,Ve kan dolaşımınız\Nhızlanacakmış.
Dialogue: 0,0:19:14.79,0:19:17.38,main,Ludie,0,0,0,,Burada kaplıca etkisine \Nihtiyacım yok benim!
Dialogue: 0,0:19:17.38,0:19:21.26,main,Ludie,0,0,0,,Hem insanı azdıran bir şey \Nbaşlı başına felaket!
Dialogue: 0,0:19:21.26,0:19:22.26,main,Kousuke,0,0,0,,Haklısın!
Dialogue: 0,0:19:22.26,0:19:24.39,main,Kousuke,0,0,0,,Ama sahiden başka yolu yok.
Dialogue: 0,0:19:24.72,0:19:26.72,main,Ludie,0,0,0,,Madem öyle, sen yapsana o zaman?
Dialogue: 0,0:19:26.72,0:19:28.60,main,Kousuke,0,0,0,,Ben o mayoyu nasıl giyeyim?
Dialogue: 0,0:19:28.60,0:19:29.98,main,Kousuke,0,0,0,,Edep diye bir şey kalmaz bende!
Dialogue: 0,0:19:29.98,0:19:32.06,main,Ludie,0,0,0,,Çırılçıplak yap o zaman!
Dialogue: 0,0:19:32.06,0:19:33.44,main,Kousuke,0,0,0,,O kadar da değil artık!
Dialogue: 0,0:19:33.44,0:19:35.27,main,Kousuke,0,0,0,,Kıyafetlerimle yapsam olmaz mı?
Dialogue: 0,0:19:35.27,0:19:36.86,main,Ludie,0,0,0,,Çıkar şunu hemen!
Dialogue: 0,0:19:36.86,0:19:37.73,main,Kousuke,0,0,0,,Dur!
Dialogue: 0,0:19:37.73,0:19:38.74,main,Kousuke,0,0,0,,Bırak şunu!
Dialogue: 0,0:19:38.74,0:19:39.61,main,Kousuke,0,0,0,,Çırılçıplak olmaz diyorum!
Dialogue: 0,0:19:39.61,0:19:42.28,main,Kousuke,0,0,0,,Bari donum üstümde kalsın!
Dialogue: 0,0:19:42.28,0:19:44.37,main,Yukine,0,0,0,,Ben Takioto'ya güvenmeye hazırım.
Dialogue: 0,0:19:44.37,0:19:45.03,main,Kousuke,0,0,0,,Senpai!
Dialogue: 0,0:19:45.03,0:19:49.41,main,Yukine,0,0,0,,Evet, kabul ediyorum, bazen bize öyle bir bakıyor ki.
Dialogue: 0,0:19:49.41,0:19:51.29,main,Yukine,0,0,0,,nasıl desem tam bilemiyorum.
Dialogue: 0,0:19:51.29,0:19:53.04,main,Yukine,0,0,0,,Ama bazen yiyecekmiş gibi süzüyor.
Dialogue: 0,0:19:53.04,0:19:54.54,main,Kousuke(M),0,0,0,,Demek fark etmişler.
Dialogue: 0,0:19:55.29,0:19:57.55,main,Yukine,0,0,0,,Yine de kendi kendime sordum.
Dialogue: 0,0:19:57.55,0:20:00.88,main,Yukine,0,0,0,,Takioto böyle bir durumda yalan söyler miydi?
Dialogue: 0,0:20:00.88,0:20:04.05,main,Yukine,0,0,0,,Hayır, muhtemelen bunu yapmaktan \Nbaşka çaremiz yok.
Dialogue: 0,0:20:09.18,0:20:10.89,main,Ludie,0,0,0,,İyi, pekala.
Dialogue: 0,0:20:11.23,0:20:14.19,main,Ludie,0,0,0,,Ama sadece bu seferlik.
Dialogue: 0,0:20:15.73,0:20:16.65,main,Kousuke,0,0,0,,Teşekkürler.
Dialogue: 0,0:20:16.98,0:20:19.61,main,Kousuke,0,0,0,,Üç farklı mayo seçeneği var.
Dialogue: 0,0:20:19.61,0:20:21.99,main,Ludie,0,0,0,,Hangisi olursa olsun fark etmez!
Dialogue: 0,0:20:23.95,0:20:27.74,main,Yukine,0,0,0,,O kadar dik dik bakarsan şey oluyor ama...
Dialogue: 0,0:20:27.74,0:20:31.33,main,Ludie,0,0,0,,Aynen, çok utanç verici bir kere.
Dialogue: 0,0:20:33.21,0:20:33.75,main,Kousuke,0,0,0,,Kusura bakmayın.
Dialogue: 0,0:20:34.67,0:20:36.13,main,Kousuke,0,0,0,,Hemen başlayalım.
Dialogue: 0,0:21:08.16,0:21:10.12,main,Yukine,0,0,0,,Tamamdır, bitti!
Dialogue: 0,0:21:10.12,0:21:11.33,main,Yukine,0,0,0,,N-Nasıl ya?
Dialogue: 0,0:21:11.33,0:21:12.08,main,Ludie,0,0,0,,Hey!
Dialogue: 0,0:21:12.08,0:21:13.50,main,Ludie,0,0,0,,Hiç mantıklı değil bu!
Dialogue: 0,0:21:16.50,0:21:17.96,main,Yukine,0,0,0,,Çabuk ol, Ludie!
Dialogue: 0,0:21:17.96,0:21:19.25,main,Yukine,0,0,0,,Takioto'nun dediği gibi.
Dialogue: 0,0:21:19.25,0:21:23.67,main,Yukine,0,0,0,,B-Bizi azdıracak olan gaz\Nsalınmak üzere!
Dialogue: 0,0:21:23.67,0:21:26.05,Default,Ludie,0,0,0,,Böyle bir poz veremem ki ben!
Dialogue: 0,0:21:49.07,0:21:50.24,main,Yukine,0,0,0,,Güzel.
Dialogue: 0,0:21:50.24,0:21:52.16,main,Yukine,0,0,0,,Doldu.
Dialogue: 0,0:21:57.17,0:21:58.67,main,Marino,0,0,0,,Kötücül Lord Tarikatı'nın.
Dialogue: 0,0:21:58.67,0:22:00.13,main,Marino,0,0,0,,Kalan üyeleri hâlâ \Nyakalanabilmiş değil.
Dialogue: 0,0:22:00.13,0:22:02.46,main,Marino,0,0,0,,Hedef alındığının artık \Nfarkında mısın bari?
Dialogue: 0,0:22:02.46,0:22:04.34,main,Marino,0,0,0,,Değilsin, değil mi?
Dialogue: 0,0:22:05.51,0:22:08.47,main - italics,Kousuke(M),0,0,0,,Böyle oturmaya da \Nalıştım iyice.
Dialogue: 0,0:22:08.84,0:22:11.18,main,Marino,0,0,0,,Kou-chan, dinliyor musun beni?
Dialogue: 0,0:22:14.64,0:22:17.35,main - italics,Kousuke(M),0,0,0,,Son yaşananlar bir şeyi anlamamı sağladı.
Dialogue: 0,0:22:17.35,0:22:20.81,main - italics,Kousuke(M),0,0,0,,Ben {\i0}Magical Explorer{\i1}'ı seviyorum.
Dialogue: 0,0:22:20.81,0:22:24.86,main - italics,Kousuke(M),0,0,0,,Ludie, Senpai, Abla, \NMarino-san ve Claris-san.
Dialogue: 0,0:22:24.86,0:22:27.74,main - italics,Kousuke(M),0,0,0,,Bu dünyada karşılaştığım herkesi seviyorum.
Dialogue: 0,0:22:27.74,0:22:30.49,main - italics,Kousuke(M),0,0,0,,Henüz tanışmadığım kadın kahramanları da öyle.
Dialogue: 0,0:22:36.08,0:22:39.71,main - italics,Kousuke(M),0,0,0,,Bu yüzden tüm kadın kahramanların \Nmutlu olmasını istiyorum.
Dialogue: 0,0:22:39.71,0:22:41.67,main - italics,Kousuke(M),0,0,0,,Daha doğrusu, mutlu olmak zorundalar.
Dialogue: 0,0:22:43.09,0:22:48.59,main - italics,Kousuke(M),0,0,0,,Acaba bu dünyanın ana karakteri \Nhepsini kurtarabilecek mi?
Dialogue: 0,0:22:48.59,0:22:51.09,main - italics,Kousuke(M),0,0,0,,Eğer en kötüsü gerçekleşecek olursa.
Dialogue: 0,0:22:51.09,0:22:53.05,main - italics,Kousuke(M),0,0,0,,Kendimi affedebilir miyim?
Dialogue: 0,0:22:53.81,0:22:55.72,main - italics,Kousuke(M),0,0,0,,Ben ana karakter değilim.
Dialogue: 0,0:22:55.72,0:22:56.93,main - italics,Kousuke(M),0,0,0,,İşte tam da bu yüzden.
Dialogue: 0,0:22:56.93,0:22:58.89,main - italics,Kousuke(M),0,0,0,,daha da güçlenmeliyim!
Dialogue: 0,0:22:59.23,0:23:00.48,main - italics,Kousuke(M),0,0,0,,Herkesi koruyabilmek için.
Dialogue: 0,0:23:01.60,0:23:04.40,main - italics,Kousuke(M),0,0,0,,Kötü sonların önüne geçebilmek için!
Dialogue: 0,0:23:09.40,0:23:12.45,main - italics,Kousuke(M),0,0,0,,{\i0}Magical Explorer{\i1}'ın ana \Nkarakteri Hijiri Iori.
Dialogue: 0,0:23:12.45,0:23:16.04,main - italics,Kousuke(M),0,0,0,,İblis Kralı'nı bile tek başına \Nyenebilecek biri.
Dialogue: 0,0:23:17.29,0:23:20.83,main - italics,Kousuke(M),0,0,0,,Onu bile aşıp en güçlüsü olacağım.
Dialogue: 0,0:23:23.04,0:23:28.67,main - italics,Kousuke(M),0,0,0,,Ve o zaman herkesi mutlu \Nbir sona ulaştıracağım.
Dialogue: 0,0:23:29.05,0:23:32.64,main - italics,Kousuke(M),0,0,0,,Bunun için de yakında gidip \Nonu almam gerekecek!
