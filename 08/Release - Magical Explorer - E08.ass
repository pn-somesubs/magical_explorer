Dialogue: 0,0:00:00.00,0:00:10.00,main - italics,,0,0,0,,{\fs17\an7\fe162\fad(400,400)\bord2\blur5\4a&HFF&\fnSweetest Cat Ever}\N{\pos(20,-2)\c&HFFFF00&\4c&H8485E4&}SomeSub ekip arkadaşı arıyor!\N{\c&HFFFFFF&}Çevirmen:{\c&HFFFF00&} KaranlıkPaşa\N{\c&HFFFFFF&}Encode:{\c&HFFFF00&} Velnoxy\N{\c&HFFFFFF&}Redaktör:{\c&HFFFF00&} Myoupie\N{\c&HFFFFFF&}Discord:{\c&HFFFF00&} discord.gg/somesub
Dialogue: 9,0:00:00.97,0:00:03.18,main - italics,Kousuke(M),0,0,0,,Bir eroge oyununun başrolüyseniz,
Dialogue: 9,0:00:03.18,0:00:06.18,main - italics,Kousuke(M),0,0,0,,Genelde gösterişli bir özel hayatınız olur.
Dialogue: 9,0:00:13.49,0:00:15.49,main - italics,Kousuke(M),0,0,0,,Sırtınızı yaslayabileceğiniz bir senpai,
Dialogue: 9,0:00:15.49,0:00:17.25,main - italics,Kousuke(M),0,0,0,,Size hayran kadın kahramanlar,
Dialogue: 9,0:00:17.25,0:00:19.88,main - italics,Kousuke(M),0,0,0,,Ve mutlu sonla bitmesi\Ngaranti bir hikaye.
Dialogue: 9,0:00:19.88,0:00:22.39,main - italics,Kousuke(M),0,0,0,,Böyle kurgulanması\Nson derece normal,
Dialogue: 9,0:00:22.39,0:00:27.02,main - italics,Kousuke(M),0,0,0,,Çünkü oyuncuların çoğu tam da\Nböyle mutlu bir masal arıyor.
Dialogue: 9,0:00:27.02,0:00:28.73,main,Marino,0,0,0,,Günaydın, Kou-chan.
Dialogue: 9,0:00:28.73,0:00:31.71,main,Marino,0,0,0,,Gidip Hatsumi'yi uyandırabilir misin?
Dialogue: 9,0:00:31.71,0:00:32.78,main,Kousuke,0,0,0,,Anlaşıldı.
Dialogue: 9,0:00:33.00,0:00:35.92,main - italics,Kousuke(M),0,0,0,,Peki ya bir erogedeki\Nyan karakter ne âlemde?
Dialogue: 9,0:00:35.92,0:00:38.78,main - italics,Kousuke(M),0,0,0,,Her zaman keyfinin yerinde\Nolduğunu iddia edemem,
Dialogue: 9,0:00:39.63,0:00:40.69,main,Kousuke,0,0,0,,Hatsumi Abla.
Dialogue: 9,0:00:40.69,0:00:42.79,main,Kousuke,0,0,0,,Kahvaltı vakti geldi de,
Dialogue: 9,0:00:45.89,0:00:46.96,main,Kousuke,0,0,0,,Kalk artık, Abla.
Dialogue: 9,0:00:47.23,0:00:49.34,main,Kousuke,0,0,0,,Uyanmazsan geç kala—
Dialogue: 9,0:00:53.39,0:00:55.93,main,Hatsumi,0,0,0,,Bana ablacığım demen gerekiyordu.
Dialogue: 9,0:00:58.00,0:01:00.20,main - italics,Kousuke(M),0,0,0,,Ama bu yan karakter bayağı keyif sürüyor.
Dialogue: 9,0:01:00.20,0:01:03.06,main - italics,Kousuke(M),0,0,0,,Hatta herhangi bir eroge başrolü\Nkadar iyi durumdayım diyebilirim.
Dialogue: 9,0:01:03.06,0:01:04.98,main - italics,Kousuke(M),0,0,0,,En azından ben öyle sanıyorum,
Dialogue: 9,0:01:06.40,0:01:07.51,main - italics,Kousuke(M),0,0,0,,Değil mi?
Dialogue: 9,0:02:44.40,0:02:46.59,main,Kousuke,0,0,0,,Bizim de yavaştan gitmemiz lazım.
Dialogue: 9,0:02:49.43,0:02:51.55,main,Ludie,0,0,0,,Peki ya sıradaki ders?
Dialogue: 9,0:02:51.55,0:02:54.88,main,Kousuke,0,0,0,,Sorun yok. Yeterince derse katıldım zaten.
Dialogue: 9,0:02:54.88,0:02:55.57,main,Ludie,0,0,0,,Ama!
Dialogue: 9,0:02:57.78,0:03:00.12,main,Katorina,0,0,0,,Yine mi dersi ekiyor?
Dialogue: 9,0:03:00.71,0:03:01.91,main,Iori,0,0,0,,Kousuke-kun,
Dialogue: 9,0:03:02.13,0:03:04.81,main,Classmates,0,0,0,,Lanet olasıca, Ludivine-sama'yı\Nyine kızdırdı.
Dialogue: 9,0:03:04.81,0:03:06.79,main,Classmates,0,0,0,,Haddini bilmesi lazım.
Dialogue: 9,0:03:06.79,0:03:08.67,main,Classmates,0,0,0,,Tam bir serseri, işe yaramaz öğrenci.
Dialogue: 9,0:03:08.67,0:03:11.76,main,Classmates,0,0,0,,Ders çalışmak istemiyorsa\Nburaya niye geliyor ki?
Dialogue: 9,0:03:12.39,0:03:15.47,main,Nanami,0,0,0,,Efendim, yine zindana mı gidiyoruz?
Dialogue: 9,0:03:15.47,0:03:18.14,main,Kousuke,0,0,0,,Öyle görünüyor. Almak\Nistediğim bir beceri var.
Dialogue: 9,0:03:18.84,0:03:21.88,main - italics,Kousuke(M),0,0,0,,Ama oraya gitmek için izin almam gerek.
Dialogue: 9,0:03:21.88,0:03:23.56,main,Ruija,0,0,0,,Takioto-kun!
Dialogue: 9,0:03:24.51,0:03:26.01,main,Kousuke,0,0,0,,R-Ruija Hocam?
Dialogue: 9,0:03:26.01,0:03:27.07,main,Ruija,0,0,0,,İnanamıyorum!
Dialogue: 9,0:03:27.07,0:03:29.11,main,Ruija,0,0,0,,Dersi ektiğini biliyordum!
Dialogue: 9,0:03:29.11,0:03:30.97,main,Ruija,0,0,0,,Hemen benimle gelsen iyi olur!
Dialogue: 9,0:03:30.97,0:03:31.65,main,Kousuke,0,0,0,,Ha?
Dialogue: 9,0:03:32.79,0:03:35.26,main,Ruija,0,0,0,,Seni hemen bulduğuma çok sevindim.
Dialogue: 9,0:03:36.07,0:03:37.23,main,Ruija,0,0,0,,Her neyse.
Dialogue: 9,0:03:37.23,0:03:44.36,main,Ruija,0,0,0,,Aslında Hatsumi bana senin\N"mana salımı yapamadığından" bahsetti.
Dialogue: 9,0:03:44.36,0:03:45.57,main,Kousuke,0,0,0,,Ablam mı?
Dialogue: 9,0:03:46.68,0:03:48.67,main,Ruija,0,0,0,,Hatsumi benim kouhai'mdir!
Dialogue: 9,0:03:49.10,0:03:51.33,main,Ruija,0,0,0,,Eskiden birlikte zindanlara dalardık.
Dialogue: 9,0:03:51.33,0:03:52.92,main,Kousuke,0,0,0,,Bunu bilmiyordum.
Dialogue: 9,0:03:53.15,0:03:54.06,main,Ruija,0,0,0,,Gerçekten.
Dialogue: 9,0:03:54.06,0:03:56.36,main,Ruija,0,0,0,,Ne, Hatsumi sana anlatmadı mı?
Dialogue: 9,0:03:56.36,0:03:58.80,main,Kousuke,0,0,0,,Ablam böyle şeylerden\Npek bahsetmez.
Dialogue: 9,0:03:58.80,0:04:03.31,main,Ruija,0,0,0,,Ama bana senin hakkında\Nalışılmadık derecede çok konuştu.
Dialogue: 9,0:04:03.31,0:04:06.77,main,Ruija,0,0,0,,Bunu da o söylediği için ödünç aldım.
Dialogue: 9,0:04:09.17,0:04:10.19,main,Ruija,0,0,0,,Ta da!
Dialogue: 9,0:04:10.19,0:04:12.44,main,Ruija,0,0,0,,Bu bir mana ölçüm cihazı!
Dialogue: 9,0:04:13.38,0:04:15.21,main,Kousuke,0,0,0,,Mana ölçüm cihazı mı?
Dialogue: 9,0:04:16.01,0:04:18.20,main,Nanami,0,0,0,,Şekli oldukça ilginçmiş.
Dialogue: 9,0:04:18.41,0:04:20.65,main,Kousuke,0,0,0,,Üzerinde neden boynuzlar var?
Dialogue: 9,0:04:20.65,0:04:21.53,main,Ruija,0,0,0,,Bilmiyorum.
Dialogue: 9,0:04:21.82,0:04:24.96,main,Kousuke,0,0,0,,Peki ya şu bir sürü\Nkuru kafa sembolü ne?
Dialogue: 9,0:04:24.96,0:04:25.79,main,Ruija,0,0,0,,Bilmiyorum.
Dialogue: 9,0:04:25.79,0:04:28.46,main,Kousuke,0,0,0,,Hem bu düğmelerin bazıları\Nnasıl açık duruyor?
Dialogue: 9,0:04:28.46,0:04:29.63,main,Ruija,0,0,0,,Bilmiyorum.
Dialogue: 9,0:04:29.63,0:04:31.17,main,Kousuke,0,0,0,,Aklıma çok acil bir randevum geldi.
Dialogue: 9,0:04:31.17,0:04:33.39,main,Ruija,0,0,0,,Lütfen bekle!
Dialogue: 9,0:04:33.92,0:04:35.32,main,Ruija,0,0,0,,Güvenli!
Dialogue: 9,0:04:35.32,0:04:39.60,main,Ruija,0,0,0,,İlk gördüğümde ben de biraz\Nendişelenmiştim ama güvenli!
Dialogue: 9,0:04:39.60,0:04:42.40,main,Ruija,0,0,0,,Bunu Akademi'nin bir numaralı\Ndahi mucidinden ödünç aldım,
Dialogue: 9,0:04:42.40,0:04:44.47,main,Ruija,0,0,0,,Yani güvenli diyorsam güvenlidir!
Dialogue: 9,0:04:44.47,0:04:45.35,main,Ruija,0,0,0,,Muhtemelen.
Dialogue: 9,0:04:46.35,0:04:49.05,main,Kousuke,0,0,0,,Bu şey daha önce test edildi mi?
Dialogue: 9,0:04:50.17,0:04:52.84,main,Kousuke,0,0,0,,Bunu kim icat etti ki zaten?
Dialogue: 9,0:04:53.24,0:04:55.63,main,Ruija,0,0,0,,Muhtemelen tanımıyorsundur ama,
Dialogue: 9,0:04:55.63,0:04:57.57,main,Ruija,0,0,0,,Üçüncü sınıflardan Anemone-san yaptı.
Dialogue: 9,0:04:59.31,0:05:02.23,main,Kousuke,0,0,0,,Saygısızlık etmek istemem ama,\Nbunu geri vermeliyiz.
Dialogue: 9,0:05:02.80,0:05:06.99,main,Ruija,0,0,0,,Ama ya gerçekten bir mucize olursa?!
Dialogue: 9,0:05:06.99,0:05:08.29,main - italics,Kousuke(M),0,0,0,,Hım,
Dialogue: 9,0:05:08.87,0:05:15.36,main - italics,Kousuke(M),0,0,0,,Anemone-san, MagiEx'teki garanti\Nseksi bilim insanı yoldaşlardan biridir.
Dialogue: 9,0:05:15.69,0:05:18.17,main - italics,Kousuke(M),0,0,0,,Dahi olduğu doğru ama,
Dialogue: 9,0:05:18.71,0:05:20.99,main,Kousuke,0,0,0,,Önce sizin kullanmanız gerekmez mi?
Dialogue: 9,0:05:20.99,0:05:22.19,main,Ruija,0,0,0,,O imkansız.
Dialogue: 9,0:05:22.19,0:05:25.13,main,Ruija,0,0,0,,Hem ona senin durumundan\Nbahsettiğimde,
Dialogue: 9,0:05:25.13,0:05:28.13,main,Ruija,0,0,0,,Elinde tam buna göre bir şey\Nolduğunu söyleyip bunu ödünç verdi.
Dialogue: 9,0:05:28.13,0:05:30.25,main,Ruija,0,0,0,,Ve sonucu ona bildirirsem,
Dialogue: 9,0:05:30.25,0:05:33.15,main,Ruija,0,0,0,,"O şeyi" sır olarak\Nsaklayacağını söyledi.
Dialogue: 9,0:05:33.15,0:05:34.61,main,Kousuke,0,0,0,,Hangi şeyi?
Dialogue: 9,0:05:34.86,0:05:38.07,main,Ruija,0,0,0,,Şey!
Dialogue: 9,0:05:38.43,0:05:39.40,main - italics,Kousuke(M),0,0,0,,Şimdi hatırladım.
Dialogue: 9,0:05:39.40,0:05:43.32,main - italics,Kousuke(M),0,0,0,,MagiEx'te, elinde Ruija Hoca hakkında\Nbir koz tuttuğu yazıyordu.
Dialogue: 9,0:05:45.79,0:05:46.91,main,Nanami,0,0,0,,Efendim?
Dialogue: 9,0:05:46.91,0:05:48.01,main,Kousuke,0,0,0,,Pekâla.
Dialogue: 9,0:05:48.01,0:05:49.22,main,Kousuke,0,0,0,,Yapalım şu işi.
Dialogue: 9,0:05:49.22,0:05:51.94,main,Kousuke,0,0,0,,Ama bize tam olarak\Nne sakladığınızı söyleyeceksiniz.
Dialogue: 9,0:05:51.94,0:05:53.80,main,Ruija,0,0,0,,Ne? Ama bu,
Dialogue: 9,0:05:53.80,0:05:56.13,main,Ruija,0,0,0,,Şey, şu an Akademi'deyiz,
Dialogue: 9,0:05:56.13,0:05:57.55,main,Ruija,0,0,0,,Yani kurallara uygunluk açısından,
Dialogue: 9,0:05:57.55,0:05:58.30,main - italics,Kousuke(M),0,0,0,,Oyunda,
Dialogue: 9,0:05:58.30,0:06:01.88,main - italics,Kousuke(M),0,0,0,,Ruija Hoca ile yakınlaşma\NAkademi'de gerçekleşmez.
Dialogue: 9,0:06:02.93,0:06:04.43,main - italics,Kousuke(M),0,0,0,,Onunla karşılaşılan yer,
Dialogue: 9,0:06:04.96,0:06:07.31,main - italics,Kousuke(M),0,0,0,,İnsanların kırmızı fener\Nmahallesi dediği yerdir.
Dialogue: 9,0:06:08.07,0:06:11.73,main - italics,Kousuke(M),0,0,0,,Takioto merakına yenik düşer ve\NIori'yi de peşinden sürükler.
Dialogue: 9,0:06:11.73,0:06:15.09,main - italics,Kousuke(M),0,0,0,,İşte Iori orada tesadüfen karşılaşır,
Dialogue: 9,0:06:25.28,0:06:27.87,main - italics,Kousuke(M),0,0,0,,Oyun bu konuyu detaylı\Nşekilde açıklamıyordu,
Dialogue: 9,0:06:27.87,0:06:31.91,main - italics,Kousuke(M),0,0,0,,Ama görünüşe göre paraya sıkıştığı\Niçin ek iş yapmaya başlamış.
Dialogue: 9,0:06:32.37,0:06:35.78,main - italics,Kousuke(M),0,0,0,,Eğer karakteri beyler arasında\Nçok popüler olsaydı,
Dialogue: 9,0:06:35.78,0:06:40.98,main - italics,Kousuke(M),0,0,0,,Paraya neden ihtiyacı olduğunu\Naçıklayan bir ek içerik yaması ile yeni bir hikaye eklenebilirdi.
Dialogue: 9,0:06:42.85,0:06:44.49,main,Kousuke,0,0,0,,Meseleyi az çok anladım.
Dialogue: 9,0:06:44.49,0:06:46.48,main,Kousuke,0,0,0,,Ama yine de sırrınızı\Ndökülmenizi istiyorum.
Dialogue: 9,0:06:46.48,0:06:48.66,main,Ruija,0,0,0,,Ne?! Anladığını sanıyordum.
Dialogue: 9,0:06:48.66,0:06:49.08,main,Kousuke,0,0,0,,Ölümcül bakış!
Dialogue: 9,0:06:49.08,0:06:50.68,main,Ruija,0,0,0,,Çok, çok özür dilerim.
Dialogue: 9,0:06:51.51,0:06:52.88,main,Kousuke,0,0,0,,Sorun değil.
Dialogue: 9,0:06:52.88,0:06:56.64,main,Kousuke,0,0,0,,Şu makineyi çalıştıralım da\Nbir an önce bitsin bu iş.
Dialogue: 9,0:06:56.64,0:06:57.78,main,Kousuke,0,0,0,,Sonrasında ise,
Dialogue: 9,0:06:57.78,0:06:58.77,main,Ruija,0,0,0,,E-Evet!
Dialogue: 9,0:06:58.77,0:07:02.03,main,Ruija,0,0,0,,Şey, bu makineyi kullanmakta\Ngerçekten sorun yok mu?
Dialogue: 9,0:07:02.28,0:07:05.57,main,Kousuke,0,0,0,,Neden "salım büyüsünü iyi\Nkullanamadığımı",
Dialogue: 9,0:07:05.57,0:07:07.87,main,Kousuke,0,0,0,,Çözeceksiniz, değil mi?
Dialogue: 9,0:07:08.98,0:07:12.33,main,Kousuke,0,0,0,,Peki, neden tamamen çıplağım?
Dialogue: 9,0:07:12.60,0:07:15.08,main,Nanami,0,0,0,,Kullanma kılavuzunda böyle yazıyor.
Dialogue: 9,0:07:16.83,0:07:18.80,main,Ruija,0,0,0,,İnanılmaz,
Dialogue: 9,0:07:18.80,0:07:21.19,main,Nanami,0,0,0,,Sırada tüm vücuda\Nvantuzları yapıştırmak var.
Dialogue: 9,0:07:21.19,0:07:22.67,main,Ruija,0,0,0,,Y-Yardım edeyim!
Dialogue: 9,0:07:28.79,0:07:30.46,main,Kousuke,0,0,0,,Biraz acele edebilir misiniz?
Dialogue: 9,0:07:30.46,0:07:32.12,main,Ruija,0,0,0,,Çok, özür dilerim!
Dialogue: 9,0:07:33.42,0:07:35.36,main - italics,Kousuke(M),0,0,0,,Ödüllendiriliyor muyum ne?!
Dialogue: 9,0:07:35.36,0:07:36.94,main - italics,Kousuke(M),0,0,0,,Bu her açıdan çok sakat,
Dialogue: 9,0:07:36.94,0:07:38.44,main - italics,Kousuke(M),0,0,0,,Lütfen hemen ayağa kalkın artık!
Dialogue: 9,0:07:38.44,0:07:39.71,main,Ruija,0,0,0,,Özür dilerim!
Dialogue: 9,0:07:39.71,0:07:41.69,main,Kousuke,0,0,0,,Nanami, lütfen çabuk ol!
Dialogue: 9,0:07:41.69,0:07:44.49,main,Nanami,0,0,0,,Öyleyse çalıştırıyorum.
Dialogue: 9,0:07:52.58,0:07:55.00,main,Ruija,0,0,0,,İ-İyi misin?
Dialogue: 9,0:07:55.65,0:08:00.46,main,Kousuke,0,0,0,,Fiziksel olarak evet ama zihinsel\Nolarak pamuk ipliğine bağlıyım.
Dialogue: 9,0:08:00.46,0:08:02.02,main,Ruija,0,0,0,,Çok özür dilerim!
Dialogue: 9,0:08:02.02,0:08:04.74,main,Ruija,0,0,0,,Ama bir miktar veri\Nelde etmeyi başardık!
Dialogue: 9,0:08:06.51,0:08:08.93,main,Nanami,0,0,0,,Görünüşe göre makine sizin\Nkadar kalın derili değilmiş.
Dialogue: 9,0:08:09.19,0:08:13.81,main - italics,Kousuke(M),0,0,0,,Tahmin ettiğim gibi, Anemone-san'ın\Nicatlarına hiç güven olmuyor.
Dialogue: 9,0:08:16.14,0:08:17.72,main,Kousuke,0,0,0,,Bir şey anlayabildiniz mi?
Dialogue: 9,0:08:17.72,0:08:19.19,main,Ruija,0,0,0,,Biraz.
Dialogue: 9,0:08:19.19,0:08:21.65,main,Ruija,0,0,0,,Az önce gördüklerime bakılırsa,
Dialogue: 9,0:08:21.65,0:08:24.78,main,Ruija,0,0,0,,Büyünün maddeselleşmesini daha\Noluşmadan engelleyen bir şey var gibi.
Dialogue: 9,0:08:24.78,0:08:26.19,main,Ruija,0,0,0,,Ya da belki,
Dialogue: 9,0:08:26.19,0:08:28.74,main,Ruija,0,0,0,,Dışarıdan müdahale eden\Nbir şey mi var?
Dialogue: 9,0:08:29.31,0:08:34.37,main,Nanami,0,0,0,,Bununla birlikte, gizli mana\Nkapasitenizin bu kadar yüksek olması inanılmaz.
Dialogue: 9,0:08:34.88,0:08:37.91,main,Nanami,0,0,0,,Vücudunuzun bunu nasıl\Nbarındırabildiği bile bir muamma.
Dialogue: 9,0:08:37.91,0:08:39.33,main,Kousuke,0,0,0,,Gerçekten mi?
Dialogue: 9,0:08:39.33,0:08:43.09,main,Ruija,0,0,0,,Acaba farklı olan şey\Nmiktarı değil de,
Dialogue: 9,0:08:43.09,0:08:46.18,main,Ruija,0,0,0,,Depolandığı yerin temelden\Nfarklı olması olabilir mi?
Dialogue: 9,0:08:46.18,0:08:47.34,main,Ruija,0,0,0,,Eğer durum buysa,
Dialogue: 9,0:08:47.56,0:08:50.56,main,Ruija,0,0,0,,Hatsumi'nin öne sürdüğü mananın\Nbaşka boyutlarda çoğalması ve,
Dialogue: 9,0:08:50.56,0:08:53.63,main,Ruija,0,0,0,,Depolanması teorilerini\Ndesteklemiş olur.
Dialogue: 9,0:08:53.63,0:08:56.28,main,Ruija,0,0,0,,Ama o doğruysa, Faust'un\Nsavunduğu ve birçok bilim insanının,
Dialogue: 9,0:08:54.35,0:08:56.71,main - top,Nanami,0,0,0,,Bu bir çözüme\Nulaşmamızı sağlar mı acaba?
Dialogue: 9,0:08:56.28,0:08:58.85,main,Ruija,0,0,0,,Kısmen kanıtladığı teori,
Dialogue: 9,0:08:56.71,0:08:57.85,main - top,Kousuke,0,0,0,,Ben de merak ediyorum.
Dialogue: 9,0:09:01.62,0:09:03.07,main,Ruija,0,0,0,,Bu inanılmaz!
Dialogue: 9,0:09:03.07,0:09:06.23,main,Ruija,0,0,0,,Bunu çözersem, tarihi\Nbir keşif olacak!
Dialogue: 9,0:09:06.63,0:09:09.06,main,Ruija,0,0,0,,Bundan harika bir\Naraştırma konusu çıkar!
Dialogue: 9,0:09:09.06,0:09:11.70,main,Kousuke,0,0,0,,O zaman lütfen bu analiz\Nüzerinde çalışın.
Dialogue: 9,0:09:11.96,0:09:13.76,main,Kousuke,0,0,0,,Ama bunu şimdilik bir kenara bırakırsak,
Dialogue: 9,0:09:14.14,0:09:16.90,main,Kousuke,0,0,0,,Umarım sözünüzü tutarsınız.
Dialogue: 9,0:09:16.90,0:09:17.84,main,Ruija,0,0,0,,Efendim?
Dialogue: 9,0:09:18.47,0:09:19.71,main,Ruija,0,0,0,,Hıçk!
Dialogue: 9,0:09:19.71,0:09:21.42,main,Kousuke,0,0,0,,Borç mu?!
Dialogue: 9,0:09:21.42,0:09:22.54,main,Ruija,0,0,0,,Çok özür dilerim.
Dialogue: 9,0:09:23.06,0:09:24.24,main,Kousuke,0,0,0,,Doğru mu anladım bakalım.
Dialogue: 9,0:09:24.24,0:09:27.68,main,Kousuke,0,0,0,,Borçlar ve vergiler yüzünden\Nparanız suyunu çekti.
Dialogue: 9,0:09:27.68,0:09:29.96,main,Kousuke,0,0,0,,Kira geciktiği için evden atıldınız.
Dialogue: 9,0:09:29.96,0:09:33.74,main,Kousuke,0,0,0,,Tam kırmızı fener mahallesinde\Nek işe başlamak üzereyken,
Dialogue: 9,0:09:33.74,0:09:35.84,main,Kousuke,0,0,0,,Anemone-san bunu öğrendi,
Dialogue: 9,0:09:35.84,0:09:40.65,main,Kousuke,0,0,0,,Siz de sessiz kalması karşılığında\Nne isterse yapmayı kabul ettiniz, öyle mi?
Dialogue: 9,0:09:40.65,0:09:41.90,main,Ruija,0,0,0,,Evet.
Dialogue: 9,0:09:42.13,0:09:44.13,main,Nanami,0,0,0,,Ortada bir sözleşme var mı?
Dialogue: 9,0:09:44.13,0:09:45.19,main,Ruija,0,0,0,,Hayır, yok.
Dialogue: 9,0:09:45.50,0:09:47.10,main,Ruija,0,0,0,,Ama oradakiler benim için,
Dialogue: 9,0:09:47.10,0:09:50.82,main,Ruija,0,0,0,,Her ay ödeyebileceğim miktarda,\Nstressiz bir geri ödeme planı hazırladı.
Dialogue: 9,0:09:51.07,0:09:53.05,main,Kousuke,0,0,0,,Bence siz dolandırılıyorsunuz.
Dialogue: 9,0:09:53.05,0:09:53.63,main,Ruija,0,0,0,,Ha?
Dialogue: 9,0:09:53.63,0:09:56.33,main,Kousuke,0,0,0,,İşler bu raddeye gelene kadar\Nnasıl ihmal ettiniz?
Dialogue: 9,0:09:57.22,0:09:59.03,main,Kousuke,0,0,0,,Kaç yaşındasınız siz?
Dialogue: 9,0:09:59.03,0:10:00.96,main,Kousuke,0,0,0,,Kaç yıldır kendi ayakları\Nüzerinde duran bir yetişkinsiniz?!
Dialogue: 9,0:10:00.96,0:10:03.51,main,Ruija,0,0,0,,Özür dilerim!
Dialogue: 9,0:10:03.51,0:10:06.51,main - italics,Kousuke(M),0,0,0,,Haklı, benim de ağlayasım gelirdi.
Dialogue: 9,0:10:04.50,0:10:09.19,main - top,Ruija,0,0,0,,Ama, ama!
Dialogue: 9,0:10:06.51,0:10:09.77,main - italics,Kousuke(M),0,0,0,,Yani, bir öğrenciden para\Nkonusunda azar işitiyor sonuçta.
Dialogue: 9,0:10:10.11,0:10:11.97,main,Nanami,0,0,0,,Efendim, ne yapacaksınız?
Dialogue: 9,0:10:12.81,0:10:14.72,main,Kousuke,0,0,0,,Yani,
Dialogue: 9,0:10:18.22,0:10:19.62,main,Kousuke,0,0,0,,Şey, Marino-san?
Dialogue: 9,0:10:19.62,0:10:21.69,main,Ruija,0,0,0,,Müdür mü?! O hariç her şey olur!
Dialogue: 9,0:10:26.75,0:10:29.82,main,Marino,0,0,0,,Şimdiye kadar organlarını\Nsatmamayı başarmış olmana şaşırdım.
Dialogue: 9,0:10:30.09,0:10:35.31,main - italics,Kousuke(M),0,0,0,,Sonuçta, Ruija Hoca'nın borcunu\Nhatırı sayılır ölçüde azaltmayı başardık.
Dialogue: 9,0:10:35.71,0:10:39.64,main - italics,Kousuke(M),0,0,0,,Bunun için Hanamura ailesinin tuttuğu\Nbir avukat ve vergi danışmanı gerekti,
Dialogue: 9,0:10:39.64,0:10:45.00,main - italics,Kousuke(M),0,0,0,,Bir de korkutucu tiplerle\Ngidip meseleyi tatlıya bağlamak,
Dialogue: 9,0:10:46.77,0:10:48.94,main,Marino,0,0,0,,Borcun geri kalanına gelince,
Dialogue: 9,0:10:48.94,0:10:51.61,main,Marino,0,0,0,,Tüm meblağı Hanamura ailesinin\Nüstlenmesine karar verdik.
Dialogue: 9,0:10:52.19,0:10:55.18,main,Kousuke,0,0,0,,Hayal edebileceğim en\Ngüvenilir alacaklı bu.
Dialogue: 9,0:10:55.42,0:10:57.23,main,Marino,0,0,0,,Aman Tanrım.
Dialogue: 9,0:10:57.23,0:10:59.93,main,Marino,0,0,0,,Sıradan bir öğretmen olsaydın,\Nseni oracıkta kovardım.
Dialogue: 9,0:11:00.54,0:11:03.34,main,Marino,0,0,0,,Hem Kou-chan'a hem de bu kadar\Nsağlam bir sicilin olmasına şükret.
Dialogue: 9,0:11:03.34,0:11:04.54,main,Ruija,0,0,0,,Elbette!
Dialogue: 9,0:11:04.54,0:11:06.65,main,Ruija,0,0,0,,Çok teşekkür ederim!
Dialogue: 9,0:11:06.65,0:11:09.02,main,Marino,0,0,0,,Kampüste bu şekilde\Nyaşamana izin veremem,
Dialogue: 9,0:11:09.50,0:11:12.49,main,Marino,0,0,0,,Bu yüzden Hanamura ailesinin\Nyönettiği bir apartmana taşınacaksın.
Dialogue: 9,0:11:13.20,0:11:16.07,main,Marino,0,0,0,,Kira ve borç taksitlerini\Nmaaşından keseceğim.
Dialogue: 9,0:11:16.79,0:11:18.61,main,Marino,0,0,0,,Radikal bir adım atmazsan,
Dialogue: 9,0:11:18.61,0:11:20.77,main,Marino,0,0,0,,Borcu bitirmen yaklaşık\Non yıl sürecektir.
Dialogue: 9,0:11:20.77,0:11:22.04,main,Ruija,0,0,0,,On yıl mı?
Dialogue: 9,0:11:22.31,0:11:24.12,main,Kousuke,0,0,0,,Evet, gayet mantıklı.
Dialogue: 9,0:11:24.12,0:11:28.38,main,Marino,0,0,0,,Ayrıca bir gözetmene ihtiyacı\Nolduğuna karar verdim.
Dialogue: 9,0:11:28.64,0:11:30.75,main,Kousuke,0,0,0,,Evet, gayet mantıklı.
Dialogue: 9,0:11:31.63,0:11:33.35,main - italics,Kousuke(M),0,0,0,,Bunca yaptığı şeyden sonra,
Dialogue: 9,0:11:33.35,0:11:36.43,main - italics,Kousuke(M),0,0,0,,Başında göz kulak olacak biri\Nolmazsa gözüm arkada kalırdı.
Dialogue: 9,0:11:36.43,0:11:38.72,main - italics,Kousuke(M),0,0,0,,En büyük sorun da şu ki\Nher şeye çok çabuk kanıyor.
Dialogue: 9,0:11:38.97,0:11:40.40,main,Marino,0,0,0,,O yüzden Kou-chan,
Dialogue: 9,0:11:40.40,0:11:42.10,main,Marino,0,0,0,,Bu işin başında sen varsın.
Dialogue: 9,0:11:42.10,0:11:43.41,main,Kousuke,0,0,0,,Evet, gayet mantıkl—
Dialogue: 9,0:11:43.41,0:11:44.46,main,Kousuke,0,0,0,,Ne?!
Dialogue: 9,0:11:44.46,0:11:48.06,main,Nanami,0,0,0,,Apartman çoktan sizin\Nüzerinize geçirildi.
Dialogue: 9,0:11:48.06,0:11:49.90,main,Nanami,0,0,0,,Elbette binanın tamamı.
Dialogue: 9,0:11:49.90,0:11:50.99,main,Kousuke,0,0,0,,Anladım.
Dialogue: 9,0:11:50.99,0:11:52.52,main,Kousuke,0,0,0,,O zaman sorun yok!
Dialogue: 9,0:11:52.52,0:11:54.11,main,Kousuke,0,0,0,,Hayır, hiç de sorun yok değil!
Dialogue: 9,0:11:54.11,0:11:55.70,main,Marino,0,0,0,,Sorun yok canım.
Dialogue: 9,0:11:55.70,0:11:56.07,main,Marino,0,0,0,,Değil mi?
Dialogue: 9,0:11:57.58,0:12:01.24,main,Nanami,0,0,0,,O halde tüm kontrolünüzü Efendim'e\Ndevretmek için lütfen burayı imzalayın.
Dialogue: 0,0:11:58.41,0:12:01.24,main,SIGN,0,0,0,,{\an7\bord0\p1\c&HF8F7FA&\3c&HF8F7FA&\4c&HF8F7FA&\1a&H21&\pos(398,11)}m 0 0 l 225 0 225 280 0 280
Dialogue: 9,0:12:01.24,0:12:02.60,main,Ruija,0,0,0,,Ah, elbette!
Dialogue: 9,0:12:02.60,0:12:06.16,main,Kousuke,0,0,0,,Önünüze gelen rastgele sözleşmeyi\Nimzalamamanız gerektiğini daha demin söyledim!
Dialogue: 9,0:12:07.02,0:12:08.11,main,Ruija,0,0,0,,İçim rahatladı.
Dialogue: 9,0:12:08.11,0:12:10.67,main,Ruija,0,0,0,,Artık huzur içinde uyuyabilirim.
Dialogue: 9,0:12:10.91,0:12:12.48,main,Kousuke,0,0,0,,İyi bari.
Dialogue: 9,0:12:12.48,0:12:14.95,main,Kousuke,0,0,0,,Lütfen parayı geri ödemek\Niçin elinizden geleni yapın.
Dialogue: 9,0:12:14.95,0:12:16.17,main,Ruija,0,0,0,,Elbette!
Dialogue: 9,0:12:16.17,0:12:17.40,main,Kousuke,0,0,0,,Ha doğru ya.
Dialogue: 9,0:12:17.40,0:12:20.01,main,Kousuke,0,0,0,,Sizden bir iyilik istemem gerekiyor.
Dialogue: 9,0:12:29.17,0:12:33.81,main,Nanami,0,0,0,,Efendim, neden bir başlangıç\Nzindanına girmekle uğraşıyorsunuz?
Dialogue: 9,0:12:34.93,0:12:36.31,main,Kousuke,0,0,0,,Çünkü,
Dialogue: 9,0:12:36.31,0:12:38.53,main,Kousuke,0,0,0,,RTA yapmayı düşünüyordum da.
Dialogue: 9,0:12:38.53,0:12:41.68,main,Nanami,0,0,0,,Anladım. Özel ödülün peşindesiniz, değil mi?
Dialogue: 9,0:12:41.68,0:12:43.76,main,Kousuke,0,0,0,,Bir Zindan Hizmetçisinin\Nhemen anlayacağını biliyordum.
Dialogue: 9,0:12:48.08,0:12:48.91,main,Kousuke,0,0,0,,Hadi gidelim!
Dialogue: 9,0:12:48.91,0:12:49.64,main,Nanami,0,0,0,,Emredersiniz!
Dialogue: 9,0:12:51.34,0:12:55.02,main - italics,Kousuke(M),0,0,0,,Zamana karşı yarışta, çöp yaratıklarla\Nsavaşmak vakit kaybıdır.
Dialogue: 9,0:12:56.10,0:13:00.17,main - italics top,Kousuke(M),0,0,0,,Yolda hiç XP toplamamıza\Ngerek olmadığı için,
Dialogue: 9,0:13:00.17,0:13:03.26,main - italics top,Kousuke(M),0,0,0,,Düşmanları görmezden gelip\Ndoğrudan bir sonraki kata geçiyoruz.
Dialogue: 9,0:13:09.00,0:13:10.41,main,Nanami,0,0,0,,Özür dilerim.
Dialogue: 9,0:13:10.41,0:13:11.69,main,Kousuke,0,0,0,,Takma kafana.
Dialogue: 9,0:13:12.61,0:13:17.15,main - italics top,Kousuke(M),0,0,0,,Oyunda hiç dinlenmeden\Nzindanı koşarak geçebilirsiniz,
Dialogue: 9,0:13:17.15,0:13:18.74,main - italics top,Kousuke(M),0,0,0,,Ama gerçek hayatta bu mümkün değil.
Dialogue: 9,0:13:18.74,0:13:20.04,main - italics top,Kousuke(M),0,0,0,,Nefes nefese kalıyorsunuz,
Dialogue: 9,0:13:20.04,0:13:21.51,main - italics top,Kousuke(M),0,0,0,,Bacaklarınız kurşun gibi ağırlaşıyor,
Dialogue: 9,0:13:21.51,0:13:23.75,main - italics top,Kousuke(M),0,0,0,,Ve dikkatiniz dağıldığı için,
Dialogue: 9,0:13:23.75,0:13:25.95,main - italics top,Kousuke(M),0,0,0,,Pusuya bile düşebilirsiniz.
Dialogue: 9,0:13:26.79,0:13:29.12,main - italics top,Kousuke(M),0,0,0,,Görünüşe göre bir mola vermemiz şart.
Dialogue: 9,0:13:31.36,0:13:33.15,main,Kousuke,0,0,0,,Nanami, iyi misin?
Dialogue: 9,0:13:33.15,0:13:35.54,main,Nanami,0,0,0,,Evet. Yetişebilecek miyiz?
Dialogue: 9,0:13:36.35,0:13:37.96,main,Kousuke,0,0,0,,1 saat 25 dakika.
Dialogue: 9,0:13:38.49,0:13:40.91,main,Kousuke,0,0,0,,Evet, vaktinde yetişeceğiz gibi duruyor.
Dialogue: 9,0:13:41.53,0:13:47.20,main - top,Kousuke,0,0,0,,1 saat 40 dakika içinde\N10. kata ulaşabilirsen,
Dialogue: 9,0:13:47.20,0:13:48.51,main - top,Kousuke,0,0,0,,Özel bir kata geçebiliyorsun.
Dialogue: 9,0:13:49.09,0:13:52.14,main - top,Kousuke,0,0,0,,Ve oraya yetişeceğiz gibi görünüyor.
Dialogue: 9,0:13:55.45,0:13:57.41,main,Nanami,0,0,0,,Burası, bir labirent katı mı?
Dialogue: 9,0:13:57.86,0:13:59.46,main,Kousuke,0,0,0,,Koşarken anlatırım.
Dialogue: 9,0:13:59.46,0:14:00.39,main,Kousuke,0,0,0,,Hadi!
Dialogue: 9,0:14:01.55,0:14:05.19,main,Kousuke,0,0,0,,Bu 10. katın özel alanında\Nsekiz farklı harita düzeni var.
Dialogue: 9,0:14:05.61,0:14:07.41,main,Kousuke,0,0,0,,Her birinin kendi yol ayrımları var,
Dialogue: 9,0:14:07.41,0:14:11.04,main,Kousuke,0,0,0,,Ve bazı düzenlerin içinde\Ninsafsız sonsuz döngüler gizli.
Dialogue: 9,0:14:11.57,0:14:13.57,main,Kousuke,0,0,0,,Rotaları aklında tutabilir misin?
Dialogue: 9,0:14:13.57,0:14:14.46,main,Nanami,0,0,0,,Bana bırakın!
Dialogue: 9,0:14:18.56,0:14:19.88,main,Nanami,0,0,0,,İlk başta bir T kavşağı vardı,
Dialogue: 9,0:14:19.88,0:14:21.61,main,Nanami,0,0,0,,Doğuda ise dört yol ağzı.
Dialogue: 9,0:14:21.61,0:14:25.59,main,Nanami,0,0,0,,Sonra kuzeye gittik ve\Nyine dört yol ağzına çıktık.
Dialogue: 9,0:14:25.59,0:14:26.30,main,Kousuke,0,0,0,,Tamamdır!
Dialogue: 9,0:14:26.67,0:14:29.57,main - italics,Kousuke(M),0,0,0,,İş tamamdır, bu D düzeni.
Dialogue: 9,0:14:29.57,0:14:35.60,main - italics,Kousuke(M),0,0,0,,Öyleyse buradan doğu, güney,\Nbatı, güney, güney, doğu, kuzey yapmalıyız!
Dialogue: 9,0:14:38.50,0:14:40.27,main,Kousuke,0,0,0,,İşte bu.
Dialogue: 9,0:14:40.76,0:14:41.81,main,Kousuke,0,0,0,,Süre?
Dialogue: 9,0:14:41.81,0:14:43.81,main,Nanami,0,0,0,,1 saat 56 dakika.
Dialogue: 9,0:14:44.15,0:14:45.57,main - italics,Kousuke(M),0,0,0,,Ödülü almanın şartı,
Dialogue: 9,0:14:45.57,0:14:50.66,main - italics,Kousuke(M),0,0,0,,1. kattan son boss'a kadar her şeyi\N2 saat içinde temizlemek.
Dialogue: 9,0:14:53.12,0:14:55.08,main,Kousuke,0,0,0,,4 dakika kaldı,
Dialogue: 9,0:14:57.58,0:14:59.16,main,Nanami,0,0,0,,Bırakın ben hallederim.
Dialogue: 9,0:14:59.16,0:15:03.01,main,Kousuke,0,0,0,,Hayır, bu herifi yenmenin\Nhızlı bir yolu var.
Dialogue: 9,0:15:11.13,0:15:12.12,main,Nanami,0,0,0,,Efendim!
Dialogue: 9,0:15:12.12,0:15:13.09,main,Kousuke,0,0,0,,Geri çekil!
Dialogue: 9,0:15:22.82,0:15:24.00,main,Kousuke,0,0,0,,Harika!
Dialogue: 9,0:15:24.00,0:15:26.00,main,Kousuke,0,0,0,,Bir dakika bile sürmedi.
Dialogue: 9,0:15:31.09,0:15:35.87,main,GoddessStatue,0,0,0,,Kötülüğü alt edip huzuruma\Nçıkmayı iyi başardın.
Dialogue: 9,0:15:36.71,0:15:40.29,main,GoddessStatue,0,0,0,,Bu başarın için,\Nsana bir beceri bahşedeceğim.
Dialogue: 9,0:15:43.38,0:15:46.69,main,Nanami,0,0,0,,Görünüşe göre bir Dayanıklılık\NArtırma büyüsü kazandınız.
Dialogue: 9,0:15:46.69,0:15:47.47,main,Kousuke,0,0,0,,Aynen.
Dialogue: 9,0:15:48.77,0:15:50.53,main - italics,Kousuke(M),0,0,0,,Beş farklı beceri türü var.
Dialogue: 9,0:15:50.53,0:15:52.59,main - italics,Kousuke(M),0,0,0,,Rastgele bir tanesini alıyorsunuz.
Dialogue: 9,0:15:53.02,0:15:55.07,main - italics,Kousuke(M),0,0,0,,En güçlü karakteri\Ngeliştirmek istiyorsanız,
Dialogue: 9,0:15:55.07,0:15:57.31,main - italics,Kousuke(M),0,0,0,,Bunları toplamayı es geçemezsiniz.
Dialogue: 9,0:15:58.08,0:16:00.81,main - italics,Kousuke(M),0,0,0,,Görünüşe göre bir süre\Nburaya gelip gideceğiz.
Dialogue: 9,0:16:02.04,0:16:06.56,main,Kousuke,0,0,0,,Şimdi ne kadar daha uzağa\Nkoşabildiğimizi görmemiz lazım!
Dialogue: 9,0:16:06.56,0:16:08.64,main,Kousuke,0,0,0,,Tekrar bir zindana girmekte\Nsorun yok ama,
Dialogue: 9,0:16:08.64,0:16:10.45,main,Kousuke,0,0,0,,Okul çoktan bitti,
Dialogue: 9,0:16:10.45,0:16:12.39,main,Nanami,0,0,0,,Güzel bir fikrim var.
Dialogue: 9,0:16:15.64,0:16:18.04,main - top,Nanami,0,0,0,,Koşu bandı!
Dialogue: 9,0:16:18.97,0:16:22.10,main,Nanami,0,0,0,,Sağanak yağmur, tayfun,\Nyoğun kar, yoğun Nanami,
Dialogue: 9,0:16:22.10,0:16:23.37,main,Nanami,0,0,0,,Koşullar ne olursa olsun,
Dialogue: 9,0:16:23.37,0:16:26.17,main,Nanami,0,0,0,,Artık istediğiniz zaman\Nkoşabilirsiniz, Efendim.
Dialogue: 9,0:16:26.17,0:16:28.72,main,Kousuke,0,0,0,,Yoğun Nanami de neymiş öyle?
Dialogue: 9,0:16:28.72,0:16:32.24,main,Nanami,0,0,0,,Bilirsiniz işte, haftada\Nyedi kez gelen şey.
Dialogue: 9,0:16:32.24,0:16:35.09,main,Kousuke,0,0,0,,Ne dediğinden hiçbir şey anlamadım.
Dialogue: 9,0:16:35.09,0:16:37.39,main,Yukine,0,0,0,,Yalnız bayağı havalı bir makineymiş.
Dialogue: 9,0:16:37.39,0:16:39.62,main,Claris,0,0,0,,Tuhaf bir şekli var.
Dialogue: 9,0:16:39.62,0:16:43.35,main,Nanami,0,0,0,,Geçen gün şüpheli bir\Nantikacı dükkanı buldum.
Dialogue: 9,0:16:43.65,0:16:46.33,main,Nanami,0,0,0,,İndirim sepetinden bir sürü parça aldım,
Dialogue: 9,0:16:46.33,0:16:49.53,main,Nanami,0,0,0,,Gizemli parçaları kendi\Nteorilerime göre yorumladım,
Dialogue: 9,0:16:49.53,0:16:51.03,main,Nanami,0,0,0,,Sonra da bunu birleştirdim.
Dialogue: 9,0:16:51.83,0:16:55.70,main,Kousuke,0,0,0,,Az önce hiç hoşuma gitmeyen\Nbir sürü kelime duydum.
Dialogue: 9,0:16:56.43,0:16:58.84,main,Nanami,0,0,0,,Bir deneyip görmeye ne dersiniz?
Dialogue: 9,0:16:58.84,0:17:00.96,main,Nanami,0,0,0,,Kullanması çok kolay.
Dialogue: 9,0:17:01.44,0:17:06.16,main,Kousuke,0,0,0,,İçimdeki kötü his tavan yaptı ama\Nneyse, neden olmasın.
Dialogue: 9,0:17:06.16,0:17:08.34,main,Ludie,0,0,0,,Tavan yaptığı halde\Nyine de üstüne çıkıyorsun.
Dialogue: 9,0:17:10.30,0:17:11.76,main,Kousuke,0,0,0,,Bu mu?
Dialogue: 9,0:17:12.43,0:17:16.05,main - top,Nanami,0,0,0,,Kullanıcı kaydınızı\Nçoktan tamamladım.
Dialogue: 9,0:17:16.05,0:17:19.36,main,Nanami,0,0,0,,Ad, cinsiyet, fiziksel veriler ve benzeri.
Dialogue: 9,0:17:19.36,0:17:20.07,main,Kousuke,0,0,0,,Hı?
Dialogue: 9,0:17:20.45,0:17:24.81,main,Kousuke,0,0,0,,Ölçülerimi virgülüne kadar\Nnasıl biliyorsun sen?
Dialogue: 9,0:17:25.04,0:17:29.94,main,Nanami,0,0,0,,Vücut yağ oranınız ve yakılan kalori\Nverilerini de görebilirsiniz.
Dialogue: 9,0:17:30.38,0:17:33.06,main,Nanami,0,0,0,,Bunlar Tsukuyomi Gezgininize\Nde gönderilebiliyor.
Dialogue: 9,0:17:33.06,0:17:36.49,main,Yukine,0,0,0,,Oldukça kullanışlıymış.\NBen de kullanmak isterim.
Dialogue: 9,0:17:36.49,0:17:38.20,main,Claris,0,0,0,,Benim de çok ilgimi çekti!
Dialogue: 9,0:17:38.79,0:17:40.49,main,Nanami,0,0,0,,Endişelenmeyin.
Dialogue: 9,0:17:40.49,0:17:44.83,main,Nanami,0,0,0,,Buradaki herkesi çoktan\Nkullanıcı olarak kaydettim.
Dialogue: 9,0:17:45.37,0:17:47.73,main,Nanami,0,0,0,,Ancak, Efendim dışındaki herkesin,
Dialogue: 9,0:17:47.73,0:17:52.06,main,Nanami,0,0,0,,Önce bir baş hizmetçi ya da\Nbaş uşak seçmesi gerekecek.
Dialogue: 9,0:17:52.06,0:17:55.03,main,Kousuke,0,0,0,,Baş hizmetçi de ne demek oluyor?
Dialogue: 9,0:17:55.03,0:17:56.59,main,Nanami,0,0,0,,Koşarken size yardımcı olan kişi.
Dialogue: 9,0:17:57.08,0:17:58.23,main,Nanami,0,0,0,,Şöyle yapmanız yeterli,
Dialogue: 9,0:17:58.81,0:18:00.41,main - italics,NanamiVoice,0,0,0,,Lütfen dokunmatik ekranı kullanın.
Dialogue: 9,0:18:00.41,0:18:02.35,main - italics,NanamiVoice,0,0,0,,Ya da sesli komut verin.
Dialogue: 9,0:18:02.35,0:18:04.52,main,Kousuke,0,0,0,,A, bu senin sesin mi?!
Dialogue: 9,0:18:04.52,0:18:07.31,main,Nanami,0,0,0,,Doğal olarak, sizin baş hizmetçiniz benim.
Dialogue: 9,0:18:07.63,0:18:11.85,main,Nanami,0,0,0,,Baş uşak içinse, izninizle\NEfendim'in sesini kullandım.
Dialogue: 9,0:18:11.85,0:18:14.34,main,Ludie,0,0,0,,Çok eğlenceli duruyor!
Dialogue: 9,0:18:14.34,0:18:17.28,main,Yukine,0,0,0,,Evet, bayağı pratik bir\Nözelliğe benziyor.
Dialogue: 9,0:18:17.69,0:18:19.78,main,Nanami,0,0,0,,O hâlde bir hedef belirleyelim.
Dialogue: 9,0:18:20.09,0:18:24.16,main,Nanami,0,0,0,,Varsayılan değer 42,195 km'ye ayarlı.
Dialogue: 9,0:18:24.16,0:18:25.29,main,Ludie,0,0,0,,Bu çok fazla!
Dialogue: 9,0:18:25.29,0:18:27.48,main,Yukine,0,0,0,,Gayet normal bir mesafe bence.
Dialogue: 9,0:18:27.48,0:18:29.69,main,Yukine,0,0,0,,Claris-dono, sen de katılmıyor musun?
Dialogue: 9,0:18:30.50,0:18:34.03,main,Claris,0,0,0,,Sanırım bu mesafe daha çok\NTakioto-sama ve size göre.
Dialogue: 9,0:18:34.03,0:18:35.83,main,Hatsumi,0,0,0,,Ben yapamam.
Dialogue: 9,0:18:41.31,0:18:42.83,main,Kousuke,0,0,0,,Bu düğmeler ne işe yarıyor?
Dialogue: 9,0:18:43.30,0:18:47.63,main,Nanami,0,0,0,,Ne yaptıklarını henüz tam\Nolarak çözemedim,
Dialogue: 9,0:18:47.63,0:18:49.15,main,Nanami,0,0,0,,O yüzden lütfen basmaktan kaçının.
Dialogue: 9,0:18:49.55,0:18:51.88,main,Kousuke,0,0,0,,Tam çözemedim derken neyi kastediyorsun?
Dialogue: 9,0:18:51.88,0:18:54.36,main,Nanami,0,0,0,,Yani, zindandan çıkma\Nikinci el bir eşya sonuçta.
Dialogue: 9,0:18:54.36,0:18:55.74,main,Hatsumi,0,0,0,,Merak ettim.
Dialogue: 9,0:18:55.74,0:18:56.24,main,Kousuke,0,0,0,,Ne?!
Dialogue: 9,0:18:57.20,0:19:00.45,main,Kousuke,0,0,0,,Duramıyorum!
Dialogue: 9,0:19:05.75,0:19:07.96,main,Kousuke,0,0,0,,Bu da ne?!
Dialogue: 9,0:19:07.96,0:19:09.45,main,Nanami,0,0,0,,Bu ilahi rüzgar işlevi olmalı.
Dialogue: 9,0:19:09.45,0:19:12.06,main,Nanami,0,0,0,,Rüzgarın şiddeti koşu\Nhızınıza göre ayarlanıyor.
Dialogue: 9,0:19:12.06,0:19:14.17,main,Nanami,0,0,0,,Görünüşe göre üç seviyesi var,
Dialogue: 9,0:19:14.17,0:19:16.47,main,Nanami,0,0,0,,Alan ihlali, haysiyet\Nkayıpları ve Sukhavati.
Dialogue: 9,0:19:16.47,0:19:18.88,main - italics,Kousuke(M),0,0,0,,Bu düpedüz iç çamaşırı\Ngörme işleviymiş ya!
Dialogue: 9,0:19:18.93,0:19:20.26,main,Kousuke,0,0,0,,Bir dakika! Yapamıyorum!
Dialogue: 9,0:19:20.26,0:19:21.00,main,Kousuke,0,0,0,,Daha fazla olmaz!
Dialogue: 9,0:19:21.00,0:19:23.18,main,Kousuke,0,0,0,,İnemiyorum, durdurun şunu!
Dialogue: 9,0:19:23.41,0:19:25.93,main,Claris,0,0,0,,Hatsumi-sama! Durdurma düğmesine basın!
Dialogue: 9,0:19:32.19,0:19:34.15,main,Nanami,0,0,0,,Herkesin nesi var böyle?
Dialogue: 9,0:19:34.15,0:19:37.05,main,Ludie,0,0,0,,B-Bu makine çok saçma!
Dialogue: 9,0:19:37.05,0:19:38.81,main,Yukine,0,0,0,,Ne kadar da edepsiz!
Dialogue: 9,0:19:38.81,0:19:41.23,main,Nanami,0,0,0,,Dedim ya, zindandan çıkma\Nikinci el bir eşya.
Dialogue: 9,0:19:41.23,0:19:44.87,main,Nanami,0,0,0,,Ama endişelerinizi anlıyorum.
Dialogue: 9,0:19:45.21,0:19:46.91,main,Nanami,0,0,0,,Buradaki düğmeye basarsanız,
Dialogue: 9,0:19:47.78,0:19:49.80,main,Kousuke,0,0,0,,Çok güzel kokuyor.
Dialogue: 9,0:19:49.80,0:19:52.29,main,Nanami,0,0,0,,Özel bir aroma işlevi ekledim.
Dialogue: 9,0:19:52.70,0:19:55.23,main,Kousuke,0,0,0,,Şey, gerçekten de rahatlatıcıymış.
Dialogue: 9,0:19:55.23,0:19:56.80,main,Nanami,0,0,0,,Nanami özütü karışımıdır.
Dialogue: 9,0:19:56.80,0:19:58.83,main,Kousuke,0,0,0,,Nanami özütü de ne demek oluyor?!
Dialogue: 9,0:19:58.83,0:20:00.21,main,Kousuke,0,0,0,,Yoksa midyelerle akraba mısın?!
Dialogue: 9,0:20:00.21,0:20:02.66,main,Nanami,0,0,0,,İnanamıyorum, bunu bana\Nsöyletiyorsunuz resmen.
Dialogue: 9,0:20:02.66,0:20:04.39,main,Kousuke,0,0,0,,Sen niye utanıyorsun ki şimdi?
Dialogue: 9,0:20:04.79,0:20:08.44,main,Nanami,0,0,0,,Üstelik soğuk ya da sıcak\Nhava üflemesini sağlayabilirsiniz.
Dialogue: 9,0:20:08.44,0:20:09.36,main,Hatsumi,0,0,0,,Bastım.
Dialogue: 9,0:20:10.82,0:20:13.06,main,Kousuke,0,0,0,,Oo, biraz ısındı.
Dialogue: 9,0:20:13.37,0:20:16.17,main,Ludie,0,0,0,,Bu hiç doğru değil!
Dialogue: 9,0:20:16.17,0:20:21.02,main,Ludie,0,0,0,,Koşmaktan zaten yanmışken\Nneden üstümüze sıcak hava üflüyor?!
Dialogue: 9,0:20:21.02,0:20:22.92,main,Claris,0,0,0,,Ludie-sama, lütfen sakin olun!
Dialogue: 9,0:20:22.92,0:20:25.15,main,Kousuke,0,0,0,,Ha? Gittikçe daha da ısınıyor,
Dialogue: 9,0:20:25.62,0:20:28.77,main,Kousuke,0,0,0,,Sıcak! Sıcak! Gerçekten çok sıcak oldu?!
Dialogue: 9,0:20:28.77,0:20:30.35,main,Kousuke,0,0,0,,Yanıyorum!
Dialogue: 9,0:20:30.35,0:20:31.83,main,Yukine,0,0,0,,İyi misin, Takioto?!
Dialogue: 9,0:20:31.83,0:20:33.15,main,Yukine,0,0,0,,Soğuk hava düğmesi!
Dialogue: 9,0:20:33.15,0:20:35.17,main,Hatsumi,0,0,0,,Göremedim.
Dialogue: 9,0:20:35.17,0:20:37.20,main,Kousuke,0,0,0,,Bir şey yapın artık!
Dialogue: 9,0:20:37.20,0:20:38.05,main,NanamiVoice,0,0,0,,Anlaşıldı.
Dialogue: 9,0:20:42.17,0:20:46.64,main,Nanami,0,0,0,,Efendim'in başına koruma büyüsü\Nyapıldığı için hiçbir zararı yok.
Dialogue: 9,0:20:46.88,0:20:50.64,main,Nanami,0,0,0,,Bunu ben de denemiştim ve\Noldukça ferahlatıcıydı.
Dialogue: 9,0:20:50.64,0:20:52.98,main,Ludie,0,0,0,,Kousuke!
Dialogue: 9,0:20:54.68,0:20:57.42,main,Kousuke,0,0,0,,Demek bu çukuru açan sendin.
Dialogue: 9,0:20:59.67,0:21:02.57,main,Yukine,0,0,0,,Gerçekten iyi misin, Takioto?
Dialogue: 9,0:21:03.32,0:21:04.46,main,Kousuke,0,0,0,,İyiyim.
Dialogue: 9,0:21:04.46,0:21:05.57,main,Kousuke,0,0,0,,Ve Nanami'nin o makineyi,
Dialogue: 9,0:21:05.57,0:21:09.16,main,Kousuke,0,0,0,,Claris-san'ın gözetimi altında\Ntamir etmesine karar verildi.
Dialogue: 9,0:21:09.71,0:21:13.24,main,Yukine,0,0,0,,Doğru, bunun için Claris-dono'ya\Nteşekkür etmeliyiz.
Dialogue: 9,0:21:13.24,0:21:14.23,main,Yukine,0,0,0,,Her neyse,
Dialogue: 9,0:21:14.23,0:21:16.95,main,Yukine,0,0,0,,Neden kendini bu kadar zorluyorsun?
Dialogue: 9,0:21:17.32,0:21:19.63,main,Yukine,0,0,0,,Biraz fazla abartmıyor musun?
Dialogue: 9,0:21:19.63,0:21:21.88,main,Yukine,0,0,0,,Dinlenmek de şarttır.
Dialogue: 9,0:21:22.15,0:21:23.18,main,Kousuke,0,0,0,,Bunu söyleyen de kimmiş.
Dialogue: 9,0:21:23.18,0:21:25.92,main,Kousuke,0,0,0,,Sen benden daha çok çalışıyorsun.
Dialogue: 9,0:21:25.92,0:21:26.95,main,Kousuke,0,0,0,,Hem,
Dialogue: 9,0:21:26.95,0:21:29.00,main,Kousuke,0,0,0,,En güçlü olmak istiyorsam,
Dialogue: 9,0:21:29.00,0:21:31.10,main,Kousuke,0,0,0,,Şimdiden işimi sağlam tutmam gerek.
Dialogue: 9,0:21:32.07,0:21:33.81,main - italics,Kousuke(M),0,0,0,,Gerçi asıl sebebimin,
Dialogue: 9,0:21:34.32,0:21:37.68,main - italics,Kousuke(M),0,0,0,,Tüm kadın kahramanları mutlu sona\Nulaştırmak istemem olduğunu,
Dialogue: 0,0:21:37.68,0:21:50.62,main - italics,,0,0,0,,{\an8}Ç.N: Değerli izleyicilerim çevirmeninizle tanışmak \Nisterseniz discord sunucumuza bekleriz.
Dialogue: 9,0:21:37.68,0:21:39.41,main - italics,Kousuke(M),0,0,0,,Açıklamaya pek niyetim yok.
Dialogue: 9,0:21:39.85,0:21:41.11,main,Yukine,0,0,0,,En güçlü,
Dialogue: 9,0:21:41.42,0:21:44.44,main,Kousuke,0,0,0,,Sen de güçlenmek istemiyor musun?
Dialogue: 9,0:21:44.76,0:21:45.95,main,Yukine,0,0,0,,İstiyorum.
Dialogue: 9,0:21:46.28,0:21:48.16,main,Kousuke,0,0,0,,O zaman birlikte güçlenelim!
Dialogue: 9,0:21:49.70,0:21:50.62,main,Yukine,0,0,0,,Olur!
Dialogue: 0,0:21:50.62,0:22:07.41,main,,0,0,0,,{\an8}Ç.N: discord.gg/somesub
Dialogue: 9,0:21:50.62,0:21:54.53,main,Kousuke,0,0,0,,Ha doğru ya, birlikte bir\Nzindana gitmek ister misin?
Dialogue: 9,0:21:54.53,0:21:55.81,main,Yukine,0,0,0,,Zindana mı?
Dialogue: 9,0:21:56.25,0:21:58.74,main,Kousuke,0,0,0,,Bir sorun mu olur?
Dialogue: 9,0:21:58.74,0:22:02.22,main,Yukine,0,0,0,,Hayır. Görevim olmadığı sürece\Ngitmemde bir sakınca yok.
Dialogue: 9,0:22:05.93,0:22:07.41,main,Kousuke,0,0,0,,Söz verdin bak!
