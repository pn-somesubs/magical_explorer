Dialogue: 0,0:00:00.00,0:00:10.00,Default,,0,0,0,,{\fs17\an7\fe162\b1\fad(400,400)\bord2\blur5\4a&HFF&\fnSweetest Cat Ever}\N{\pos(20,-2)\c&HFFFF00&\4c&H8485E4&}\NSomeSub ekip arkadaşı arıyor!\N{\c&HFFFFFF&}Çevirmen:{\c&HFFFF00&} KaranlıkPasa\N{\c&HFFFFFF&}Encode:{\c&HFFFF00&} Velnoxy\N{\c&HFFFFFF&}Redaktör:{\c&HFFFF00&} Itsu\N{\c&HFFFFFF&}Discord:{\c&HFFFF00&} discord.gg/somesub \N
Dialogue: 0,0:00:06.33,0:00:08.82,main - italics,Kousuke(M),0,0,0,,Bir erogenin figüran karakteri olarak\Nreenkarne olduğuma
Dialogue: 0,0:00:08.82,0:00:12.04,main - italics,Kousuke(M),0,0,0,,ve herkesi mutlu sona ulaştırmaya\Nkarar verdiğime göre,
Dialogue: 0,0:00:12.04,0:00:13.88,main - italics,Kousuke(M),0,0,0,,yapmam gereken bir şey var.
Dialogue: 0,0:00:14.20,0:00:17.57,main - italics,Kousuke(M),0,0,0,,O da olabildiğince çabuk\Ngüçlenmek.
Dialogue: 0,0:00:18.14,0:00:20.85,main - italics,Kousuke(M),0,0,0,,MagiEx'te zaman sınırlı\Nbazı olaylar var.
Dialogue: 0,0:00:21.25,0:00:28.49,main - italics,Kousuke(M),0,0,0,,Kızlara yardım edebilmek için gelişimimin yavaş\Nkalmasını ne pahasına olursa olsun önlemeliyim.
Dialogue: 0,0:00:29.09,0:00:32.16,main - italics,Kousuke(M),0,0,0,,Peki o zaman, kendimi geliştirmenin\Nen iyi yolu nedir?
Dialogue: 0,0:00:32.16,0:00:33.50,main - italics,Kousuke(M),0,0,0,,Ortalıkta birkaç teori dolaşıyor,
Dialogue: 0,0:00:33.50,0:00:38.08,main - italics,Kousuke(M),0,0,0,,ama hepsinin ortak noktası,\Ntek başına girmenin iyi bir fikir olmadığı.
Dialogue: 0,0:00:38.91,0:00:41.64,main - italics,Kousuke(M),0,0,0,,İşte bu yüzden Alacakaranlık Mağarası'ndayım;
Dialogue: 0,0:00:41.64,0:00:45.03,main - italics,Kousuke(M),0,0,0,,İlk çıkışa özel bir bonus içerik yamasıyla\Neklenmiş olan,
Dialogue: 0,0:00:45.03,0:00:47.12,main - italics,Kousuke(M),0,0,0,,Yalnızca tek kişilik girilen bir zindan.
Dialogue: 0,0:00:49.80,0:00:51.96,main - italics,Kousuke(M),0,0,0,,Su büyüsü mühür taşlarını yanıma aldım.
Dialogue: 0,0:00:51.96,0:00:54.26,main - italics,Kousuke(M),0,0,0,,İyileştirme iksirlerim hazır,
Dialogue: 0,0:00:54.26,0:00:56.67,main - italics,Kousuke(M),0,0,0,,ve atkımın su büyülemesi de\Ntamamlandı.
Dialogue: 0,0:01:13.85,0:01:16.57,main,Kousuke,0,0,0,,En güçlüsü olmak için...
Dialogue: 0,0:01:19.78,0:01:21.45,main,Kousuke,0,0,0,,Hadi yapalım şunu!
Dialogue: 0,0:02:53.98,0:02:56.86,main - flashback,Yukine,0,0,0,,Atkın dışında başka ne mi kuşanmalısın?
Dialogue: 0,0:02:56.86,0:03:00.49,main - flashback,Kousuke,0,0,0,,Kalkan kullanmayı düşündüm aslında,
Dialogue: 0,0:03:00.49,0:03:02.32,main - flashback,Kousuke,0,0,0,,Ama pek içime sinmedi.
Dialogue: 0,0:03:02.32,0:03:04.07,main - flashback,Yukine,0,0,0,,Bana kalırsa,
Dialogue: 0,0:03:04.07,0:03:08.12,main - flashback,Yukine,0,0,0,,Daha önce kullanıp eline yatkın\Nbulduğun bir silahı seçmelisin.
Dialogue: 0,0:03:08.12,0:03:12.37,main - flashback,Kousuke,0,0,0,,Yani her türlü silahı\Ndenemeliyim.
Dialogue: 0,0:03:12.58,0:03:14.13,main - flashback,Yukine,0,0,0,,Aynen öyle.
Dialogue: 0,0:03:14.13,0:03:14.88,main - flashback,Yukine,0,0,0,,Yine de...
Dialogue: 0,0:03:15.13,0:03:18.05,main - flashback,Yukine,0,0,0,,Katana ve naginata harika silahlardır,
Dialogue: 0,0:03:18.05,0:03:19.55,main - flashback,Yukine,0,0,0,,büyü gücüyle efsunlamaları da epey kolaydır.
Dialogue: 0,0:03:19.55,0:03:20.84,main - flashback,Yukine,0,0,0,,O yüzden benim tavsiyem bunlar!
Dialogue: 0,0:03:21.59,0:03:23.09,main - flashback,Yukine,0,0,0,,Üstelik Zihin Gözü becerisini de\Nöğrendin,
Dialogue: 0,0:03:23.09,0:03:25.60,main - flashback,Yukine,0,0,0,,ayrıca bir Üçüncü Elin ve Dördüncü Elin var,
Dialogue: 0,0:03:25.60,0:03:27.56,main - flashback,Yukine,0,0,0,,Hiçbir dezavantajı olmadan bir katananın
Dialogue: 0,0:03:27.56,0:03:30.39,main - flashback,Yukine,0,0,0,,tüm potansiyelini açığa çıkarabileceğine\Ngönülden inanıyorum.
Dialogue: 0,0:03:30.39,0:03:31.52,main - flashback,Yukine,0,0,0,,Ne dersin?!
Dialogue: 0,0:03:33.35,0:03:36.36,main - flashback,Kousuke,0,0,0,,Ş-Şey, katanayı bir deneyeyim\No zaman.
Dialogue: 0,0:03:41.99,0:03:43.53,main - flashback,Yukine,0,0,0,,Bu günün geleceğini biliyordum,
Dialogue: 0,0:03:43.53,0:03:44.82,main - flashback,Yukine,0,0,0,,O yüzden hazırlıklı geldim.
Dialogue: 0,0:03:45.87,0:03:50.04,main - italics,Kousuke(M),0,0,0,,Bana bu katanayı verirken\Nböyle demişti.
Dialogue: 0,0:03:50.04,0:03:52.96,main - italics,Kousuke(M),0,0,0,,Ondan sonra beni epey bir\Nhırpaladı gerçi...
Dialogue: 0,0:04:10.43,0:04:12.56,main,Kousuke,0,0,0,,Ç-Çok korkunç...
Dialogue: 0,0:04:37.46,0:04:41.67,main,Kousuke,0,0,0,,Bunun için her gün bedenimi eğittim\Nve kılıç çalıştım.
Dialogue: 0,0:04:43.38,0:04:46.14,main,Kousuke,0,0,0,,Kılıçta hiç yeteneğim olmasa bile,
Dialogue: 0,0:04:46.72,0:04:49.51,main,Kousuke,0,0,0,,tek beceride ustalaşacağım.
Dialogue: 0,0:04:52.27,0:04:55.02,main - italics,Kousuke(M),0,0,0,,Kılıç Çekme Sanatı ─Işıltı─!
Dialogue: 0,0:05:20.04,0:05:21.34,main,Kousuke,0,0,0,,Vayy.
Dialogue: 0,0:05:21.34,0:05:23.30,main,Kousuke,0,0,0,,Çok güzelmiş.
Dialogue: 0,0:05:23.30,0:05:26.43,main,Kousuke,0,0,0,,Buraya neden Meleklerin Merdiveni\Ndediklerini şimdi anlıyorum.
Dialogue: 0,0:05:29.85,0:05:31.68,main,Kousuke,0,0,0,,Şu tek nokta çimlerle kaplı değil.
Dialogue: 0,0:05:36.73,0:05:39.44,main,Kousuke,0,0,0,,Oyundakinden farklı görünüyor,
Dialogue: 0,0:05:40.40,0:05:42.15,main,Kousuke,0,0,0,,ama burası olmalı, değil mi?
Dialogue: 0,0:05:42.73,0:05:46.53,main - italics,Kousuke(M),0,0,0,,MagiEx'te kristale benzeyen\Nmühürlü bir mücevherdi.
Dialogue: 0,0:05:46.95,0:05:48.91,main,Kousuke,0,0,0,,Vay, yumuşacıkmış.
Dialogue: 0,0:05:55.79,0:05:59.00,main - italics,Kousuke(M),0,0,0,,Ana karakter bunun içine\Nbiraz mana akıtmıştı.
Dialogue: 0,0:06:01.46,0:06:03.34,main - italics,Kousuke(M),0,0,0,,Her gün yaptığım antrenmanlar sayesinde,
Dialogue: 0,0:06:03.34,0:06:05.84,main - italics,Kousuke(M),0,0,0,,Manam kayda değer ölçüde arttı.
Dialogue: 0,0:06:05.84,0:06:07.47,main - italics,Kousuke(M),0,0,0,,Mana kapasitemi artırmak için,
Dialogue: 0,0:06:07.47,0:06:09.84,main - italics,Kousuke(M),0,0,0,,Uyuduğum zamanlar hariç efsunları\Nsürekli aktif tuttum.
Dialogue: 0,0:06:09.84,0:06:11.26,main - italics,Kousuke(M),0,0,0,,Koşularımda ve dövüşlerimde de,
Dialogue: 0,0:06:11.26,0:06:13.39,main - italics,Kousuke(M),0,0,0,,manamı son sınırına kadar\Ntükettim.
Dialogue: 0,0:06:13.89,0:06:17.10,main - italics,Kousuke(M),0,0,0,,Zaten çılgınca bir miktarda\Nmanam olmalıydı...
Dialogue: 0,0:06:18.39,0:06:20.65,main - italics,Kousuke(M),0,0,0,,Ama hâlâ mı yetmiyor?
Dialogue: 0,0:06:20.94,0:06:22.52,main - italics,Kousuke(M),0,0,0,,Bu kötü! Yani bu demek oluyor ki...
Dialogue: 0,0:06:30.95,0:06:33.70,main - italics,System,0,0,0,,Mana kaydedildi.
Dialogue: 0,0:06:36.75,0:06:37.96,main,Kousuke,0,0,0,,Hiçbir şey okuyamıyorum...
Dialogue: 0,0:06:38.87,0:06:41.04,main - italics,System,0,0,0,,Lütfen bir form seçiniz.
Dialogue: 0,0:06:42.42,0:06:46.38,main,Kousuke,0,0,0,,Buradaki seçeneklerin ilkbahar, yaz,\Nsonbahar ve kış olması gerekiyordu.
Dialogue: 0,0:06:46.38,0:06:48.26,main,Kousuke,0,0,0,,Cennet Formu da neyin nesi?
Dialogue: 0,0:06:48.63,0:06:50.09,main,Kousuke,0,0,0,,Ama nedense,
Dialogue: 0,0:06:50.09,0:06:53.47,main,Kousuke,0,0,0,,içimden bir ses cenneti seçmemi söylüyor.
Dialogue: 0,0:06:53.47,0:06:55.60,main,System,0,0,0,,Gerçekten emin misiniz?
Dialogue: 0,0:07:37.39,0:07:40.73,main,Nanami,0,0,0,,A&A Şirketi'ne bağlantı kurulamadı.
Dialogue: 0,0:07:40.73,0:07:43.85,main,Nanami,0,0,0,,Yerel ağ üzerinden veri alımı başarısız oldu.
Dialogue: 0,0:07:43.85,0:07:46.40,main,Nanami,0,0,0,,Zindan Ağı tamamen koptu.
Dialogue: 0,0:07:46.40,0:07:49.53,main,Nanami,0,0,0,,AA terminalinin saati\Nayarlanamıyor.
Dialogue: 0,0:07:49.53,0:07:51.20,main,Nanami,0,0,0,,İşlevsellik kısıtlı olacaktır.
Dialogue: 0,0:07:54.95,0:07:57.66,main,Nanami,0,0,0,,İyi günler, sözleşme sahibi.
Dialogue: 0,0:07:58.08,0:08:03.67,main,Nanami,0,0,0,,Ben A&A Şirketi üretimi,\N"Hizmetçi-Şövalye Hizmetkârı, 73. Modelim"
Dialogue: 0,0:08:05.42,0:08:07.96,main - italics,Kousuke,0,0,0,,"Hizmetçi-Şövalye Hizmetkârı, 73. Model,"
Dialogue: 0,0:08:07.96,0:08:12.84,main - italics,Kousuke,0,0,0,,İlk çıkıştaki bir bonus olarak sunulan\Nsüper faydalı bir karakterdir.
Dialogue: 0,0:08:13.26,0:08:15.55,main - italics,Kousuke,0,0,0,,İlkbahar, yaz, sonbahar, kış.
Dialogue: 0,0:08:15.55,0:08:18.22,main - italics,Kousuke,0,0,0,,Hangi formu seçtiğine göre kişiliği\Nve saç rengi değişir,
Dialogue: 0,0:08:18.22,0:08:20.39,main - italics,Kousuke,0,0,0,,ama hepsi de oldukça popülerdi.
Dialogue: 0,0:08:21.02,0:08:23.69,main - italics,Kousuke(M),0,0,0,,Peki ya şu karşımda duran?
Dialogue: 0,0:08:23.69,0:08:26.27,main - italics,Kousuke(M),0,0,0,,Saçları parlak ve\Ngüzel bir gümüş renginde.
Dialogue: 0,0:08:26.27,0:08:28.11,main - italics,Kousuke(M),0,0,0,,Gözleri farklı renklerde;
Dialogue: 0,0:08:28.11,0:08:30.36,main - italics,Kousuke(M),0,0,0,,Kırmızımsı mor ve mavimsi mor,\Nona mesafeli bir hava katıyor.
Dialogue: 0,0:08:30.61,0:08:32.78,main - italics,Kousuke(M),0,0,0,,Göğüsleri ablamınkiler kadar olmasa da
Dialogue: 0,0:08:32.78,0:08:34.57,main - italics,Kousuke(M),0,0,0,,Yeterince dolgun.
Dialogue: 0,0:08:34.57,0:08:37.45,main,Nanami,0,0,0,,Adınızı öğrenebilir miyim?
Dialogue: 0,0:08:37.45,0:08:39.79,main,Kousuke,0,0,0,,Takioto Kousuke.
Dialogue: 0,0:08:47.54,0:08:49.00,main,Nanami,0,0,0,,Kaydedildi.
Dialogue: 0,0:08:50.80,0:08:54.01,main,Nanami,0,0,0,,Bir Hizmetçi-Şövalye Hizmetkârı ile\Nsözleşme yaptığınız için teşekkürler.
Dialogue: 0,0:08:54.80,0:08:56.39,main,Nanami,0,0,0,,Lütfen kusuruma bakmayın,
Dialogue: 0,0:08:56.39,0:08:59.64,main,Nanami,0,0,0,,ancak Zindan Ağı ile bağlantım\Nkesildiği için,
Dialogue: 0,0:08:59.64,0:09:02.14,main,Nanami,0,0,0,,mevcut durumu değerlendirmek\Nistiyorum.
Dialogue: 0,0:09:02.14,0:09:05.23,main,Kousuke,0,0,0,,Şey, Zindan Ağı da nedir?
Dialogue: 0,0:09:05.69,0:09:08.36,main - italics,Kousuke(M),0,0,0,,Garip, bu oyunda hiç olmamıştı.
Dialogue: 0,0:09:08.77,0:09:10.69,main - italics,Kousuke(M),0,0,0,,Benim bildiğim MagiEx'te...
Dialogue: 0,0:09:11.98,0:09:16.45,main - italics,Kousuke(M),0,0,0,,Ana karakterin küçücük odasında\Nyaşamaya başlayan davetsiz bir hizmetçiydi,
Dialogue: 0,0:09:16.45,0:09:19.41,main - italics,Kousuke(M),0,0,0,,"Az önce kaderindeki kişiyle karşılaştın"\Ngibi laflar eder
Dialogue: 0,0:09:19.41,0:09:22.16,main - italics,Kousuke(M),0,0,0,,Ve büyük bir sadakatle ona bakardı.
Dialogue: 0,0:09:22.66,0:09:23.75,main - italics,Kousuke(M),0,0,0,,Dahası,
Dialogue: 0,0:09:23.75,0:09:26.50,main - italics,Kousuke(M),0,0,0,,Sadakati sadece son seviyede olmakla kalmayıp
Dialogue: 0,0:09:26.50,0:09:27.58,main - italics,Kousuke(M),0,0,0,,tüm sınırları aşan yüzsüz bir hizmetçiydi.
Dialogue: 0,0:09:28.08,0:09:31.04,main - italics,Kousuke(M),0,0,0,,Neden sana bu kadar minnettar\Nolduğunu merak ettiğinde,
Dialogue: 0,0:09:31.04,0:09:35.97,main - italics,Kousuke(M),0,0,0,,asla uyandırılmayıp zindanda çürümeye\Nbırakılabileceği için olduğunu söylerdi.
Dialogue: 0,0:09:35.97,0:09:38.09,main - italics,Kousuke(M),0,0,0,,Asla uyandırılmadan...
Dialogue: 0,0:09:38.55,0:09:39.51,main - italics,Kousuke(M),0,0,0,,Arayı iyice ilerletince,
Dialogue: 0,0:09:39.51,0:09:41.10,main - italics,Kousuke(M),0,0,0,,özel bir yan olay açılırdı;
Dialogue: 0,0:09:41.10,0:09:42.76,main - italics,Kousuke(M),0,0,0,,Orada şunu itiraf ederdi:
Dialogue: 0,0:09:42.76,0:09:44.98,main - italics,Kousuke(M),0,0,0,,"O zaman söylediklerimin hepsi numaraydı.
Dialogue: 0,0:09:44.98,0:09:46.77,main - italics,Kousuke(M),0,0,0,,Manasını kaydeden o kişiye.
Dialogue: 0,0:09:46.77,0:09:48.56,main - italics,Kousuke(M),0,0,0,,Sadakat yemini etmiş gibi \N davranmak zorundaydım.
Dialogue: 0,0:09:48.56,0:09:51.11,main - italics,Kousuke(M),0,0,0,,Ama artık, sen gerçekten benim..."
Dialogue: 0,0:09:51.11,0:09:54.57,main - italics,Kousuke(M),0,0,0,,Pek çok kişi tam o anda bu seksi\Nhizmetçiye sırılsıklam aşık olmuştu!
Dialogue: 0,0:09:54.57,0:09:55.78,main - italics,Kousuke(M),0,0,0,,Ben de dahil!
Dialogue: 0,0:09:56.07,0:09:59.24,main,Nanami,0,0,0,,Afedersiniz, elinizi tutabilir miyim?
Dialogue: 0,0:09:59.66,0:10:00.57,main,Kousuke,0,0,0,,Ş-Şey, tabii.
Dialogue: 0,0:10:00.57,0:10:01.74,main,Nanami,0,0,0,,Müsaadenizle.
Dialogue: 0,0:10:04.87,0:10:06.91,main,Kousuke,0,0,0,,İyi misin?
Dialogue: 0,0:10:06.91,0:10:08.37,main,Nanami,0,0,0,,Lütfen beni bağışlayın.
Dialogue: 0,0:10:08.37,0:10:11.29,main,Nanami,0,0,0,,Düşüncelerimi toparlamak için\Nbiraz zaman rica edebilir miyim?
Dialogue: 0,0:10:11.59,0:10:16.26,main - italics,Kousuke(M),0,0,0,,Görünüşe göre onun da sakin kafayla\Nbir şeyleri düşünmeye ihtiyacı var.
Dialogue: 0,0:10:18.22,0:10:21.05,main,Kousuke,0,0,0,,Yani temelde ters giden bir şey mi var?
Dialogue: 0,0:10:21.05,0:10:21.93,main,Nanami,0,0,0,,Doğru.
Dialogue: 0,0:10:21.93,0:10:23.93,main,Nanami,0,0,0,,Normalde Hizmetçi-Şövalye Serisi'nin,
Dialogue: 0,0:10:23.93,0:10:28.39,main,Nanami,0,0,0,,Zindan Efendisi'ne yakın biriyle\Nsözleşme yapması gerekirdi.
Dialogue: 0,0:10:28.39,0:10:31.90,main,Kousuke,0,0,0,,Sıradan bir insandan fazlası gibi\Ngörünmememe rağmen,
Dialogue: 0,0:10:31.90,0:10:33.73,main,Kousuke,0,0,0,,Bu sözleşmeyi yapabilmiş olmam\Nakıl alır gibi değil.
Dialogue: 0,0:10:33.73,0:10:37.19,main,Nanami,0,0,0,,Anormal derecede yüksek bir mana\Nkapasitesi potansiyeline sahip olsanız da,
Dialogue: 0,0:10:37.19,0:10:38.45,main,Nanami,0,0,0,,Kesinlikle haklısınız.
Dialogue: 0,0:10:38.45,0:10:41.16,main,Kousuke,0,0,0,,Bu arada, Zindan Efendisi\Nde nedir tam olarak?
Dialogue: 0,0:10:41.70,0:10:43.28,main,Nanami,0,0,0,,Ayrıntılar, sıradan insanlara
Dialogue: 0,0:10:43.28,0:10:47.33,main,Nanami,0,0,0,,açıklanamayacak gizli\Nbilgiler içermektedir.
Dialogue: 0,0:10:47.79,0:10:52.63,main,Nanami,0,0,0,,Bununla birlikte, siz benim\Nişverenim olarak ayarlandınız.
Dialogue: 0,0:10:52.63,0:10:53.79,main,Kousuke,0,0,0,,Yani...
Dialogue: 0,0:10:53.79,0:10:56.30,main,Nanami,0,0,0,,Size karşı gelemem,
Dialogue: 0,0:10:56.30,0:10:57.84,main,Nanami,0,0,0,,Bu yüzden her şeyi anlatmamı emrederseniz,
Dialogue: 0,0:10:57.84,0:10:59.34,main,Nanami,0,0,0,,muhtemelen anlatırım.
Dialogue: 0,0:10:59.88,0:11:03.10,main,Kousuke,0,0,0,,Anlıyorum, yani bir zindan hakkında\Nbilgi almak istersem,
Dialogue: 0,0:11:03.10,0:11:05.06,main,Kousuke,0,0,0,,bir emirle bunu zorlayabilirim.
Dialogue: 0,0:11:05.85,0:11:07.02,main,Kousuke,0,0,0,,Ama bilirsin ya...
Dialogue: 0,0:11:10.60,0:11:13.86,main,Kousuke,0,0,0,,O bilgiye o kadar da muhtaç değilim.
Dialogue: 0,0:11:14.36,0:11:15.36,main,Kousuke,0,0,0,,Daha da önemlisi...
Dialogue: 0,0:11:16.23,0:11:18.44,main,Kousuke,0,0,0,,Yanımda yürür müsün lütfen?
Dialogue: 0,0:11:28.37,0:11:29.66,main,Nanami,0,0,0,,Çok naziksiniz.
Dialogue: 0,0:11:37.80,0:11:40.76,main,Nanami,0,0,0,,Sözleşmeyle ilgili adımlar\Ntamamlandığına göre...
Dialogue: 0,0:11:42.55,0:11:45.14,main,Nanami,0,0,0,,Lütfen bu kadar yaramaz olduğu için
Dialogue: 0,0:11:45.14,0:11:47.06,main,Nanami,0,0,0,,Popülaritesi tavan yapan bir
Dialogue: 0,0:11:47.06,0:11:50.02,main,Nanami,0,0,0,,Hizmetçi-Şövalye Serisi karakterine\Nyakışır bir isim verin!
Dialogue: 0,0:11:50.02,0:11:52.85,main,Kousuke,0,0,0,,Ne?! Elindeki de ne öyle?!
Dialogue: 0,0:11:52.85,0:11:54.44,main,Nanami,0,0,0,,Benimle birlikte gelen bir kostüm.
Dialogue: 0,0:11:54.44,0:11:56.27,main,Kousuke,0,0,0,,Neden okul mayosu peki?
Dialogue: 0,0:11:56.98,0:12:01.40,main,Nanami,0,0,0,,Eskiden A&A Şirketi bizi sadece\Nhizmetçi kıyafetleriyle gönderirdi.
Dialogue: 0,0:12:01.40,0:12:04.28,main,Nanami,0,0,0,,Ancak okul mayoları eklendiğinde,
Dialogue: 0,0:12:04.28,0:12:06.24,main,Nanami,0,0,0,,    Satışlar açısından son derece\Nolumlu sonuçlar verdi;
Dialogue: 0,0:12:06.24,0:12:08.24,main,Nanami,0,0,0,,O günden beri bu uygulamanın sürdüğünü\Ndüşünüyorum.
Dialogue: 0,0:12:08.66,0:12:10.75,main,Nanami,0,0,0,,İsterseniz hemen üzerime geçirebilirim.
Dialogue: 0,0:12:10.75,0:12:13.12,main,Kousuke,0,0,0,,Hayır, hiç gerek yok.
Dialogue: 0,0:12:13.12,0:12:14.54,main,Nanami,0,0,0,,Anlıyorum.
Dialogue: 0,0:12:14.54,0:12:16.42,main,Nanami,0,0,0,,Sadece hafızanıza kaydedeceksiniz,
Dialogue: 0,0:12:16.42,0:12:18.34,main,Nanami,0,0,0,,Değil mi Takioto Kousuke-sama?
Dialogue: 0,0:12:19.09,0:12:22.30,main,Nanami,0,0,0,,O halde kıyafetimin üzerinde tutayım.
Dialogue: 0,0:12:23.43,0:12:24.93,main,Kousuke,0,0,0,,Biraz çömelir misin—
Dialogue: 0,0:12:24.93,0:12:27.22,main,Kousuke,0,0,0,,Yani şey, asıl işimize dönelim!
Dialogue: 0,0:12:27.85,0:12:29.31,main,Nanami,0,0,0,,Özür dilerim.
Dialogue: 0,0:12:29.31,0:12:33.06,main,Nanami,0,0,0,,O halde bana bir isim vererek başlayın.
Dialogue: 0,0:12:33.06,0:12:35.60,main,Kousuke,0,0,0,,Şey, sana bir isim vermem gerektiğine göre
Dialogue: 0,0:12:35.60,0:12:39.61,main,Kousuke,0,0,0,,Homunkulus benzeri bir şey olduğunu\Ndüşünmekte haklı mıyım?
Dialogue: 0,0:12:39.61,0:12:42.03,main,Nanami,0,0,0,,Hayır, ben bir meleğim.
Dialogue: 0,0:12:42.03,0:12:43.40,main,Kouske,0,0,0,,Bir melek mi?!
Dialogue: 0,0:12:43.90,0:12:45.28,main - italics,Kousuke(M),0,0,0,,Benim bildiğim MagiEx'te,
Dialogue: 0,0:12:45.28,0:12:47.82,main - italics,Kousuke(M),0,0,0,,İlk kadın karakterler arasında\Nhiç melek yoktu.
Dialogue: 0,0:12:47.82,0:12:49.24,main - italics,Kousuke(M),0,0,0,,Cennet Formu inanılmazmış!
Dialogue: 0,0:12:49.91,0:12:51.62,main,Nanami,0,0,0,,Bunu dert ettiğinizden eminim,
Dialogue: 0,0:12:51.62,0:12:56.21,main,Nanami,0,0,0,,ancak çiftleşebileceğim ve hatta çocuk\Ndoğurabileceğim konusunda içinizi rahatlatabilirim.
Dialogue: 0,0:12:56.21,0:12:58.92,main,Kousuke,0,0,0,,Bunu hiç dert etmiyordum ki!
Dialogue: 0,0:12:58.92,0:13:00.05,main,Nanami,0,0,0,,Pekala o zaman.
Dialogue: 0,0:13:00.59,0:13:03.30,main,Kousuke,0,0,0,,Şey, Japoncada 73 nana ve mi diye okunur,
Dialogue: 0,0:13:03.30,0:13:04.97,main,Kousuke,0,0,0,,Nanami'ye ne dersin?
Dialogue: 0,0:13:05.26,0:13:06.43,main,Nanami,0,0,0,,Cidden mi?
Dialogue: 0,0:13:06.72,0:13:11.14,main,Nanami,0,0,0,,Kimlik numaramı olduğu gibi\Nkullandığınıza inanamıyorum.
Dialogue: 0,0:13:11.14,0:13:13.85,main,Kousuke,0,0,0,,Affedersin, başka bir şey düşüneyim.
Dialogue: 0,0:13:13.85,0:13:17.52,main,Nanami,0,0,0,,Kaydedildi, Takioto Kousuke-sama\Nuslanmazın teki.
Dialogue: 0,0:13:21.44,0:13:23.61,main,Nanami,0,0,0,,Neyse, Nanami yeterince iyi.
Dialogue: 0,0:13:23.61,0:13:25.61,main,Kousuke,0,0,0,,Aslında hoşuna gitti, değil mi?
Dialogue: 0,0:13:25.95,0:13:29.07,main,Nanami,0,0,0,,Sizin için Nanami.
Dialogue: 0,0:13:29.07,0:13:30.95,main,Nanami,0,0,0,,Veya bana Nanamin de diyebilirsiniz.
Dialogue: 0,0:13:30.95,0:13:31.66,main,Kousuke,0,0,0,,Şey...
Dialogue: 0,0:13:32.16,0:13:36.37,main,Nanami,0,0,0,,Sıradaki adım, size yönelik\Nhitap unvanını belirlemek.
Dialogue: 0,0:13:36.37,0:13:37.58,main,Kousuke,0,0,0,,Hitap unvanı mı?
Dialogue: 0,0:13:37.58,0:13:39.71,main,Nanami,0,0,0,,Seçenekleriniz oldukça çeşitli;
Dialogue: 0,0:13:39.71,0:13:41.29,main,Nanami,0,0,0,,Takioto Kousuke-sama,
Dialogue: 0,0:13:41.29,0:13:45.88,main,Nanami,0,0,0,,Lordum, Efendim, Usta, Oyakata, Şirket Müdürü,
Dialogue: 0,0:13:45.88,0:13:48.34,main,Nanami,0,0,0,,Bölüm Başkanı, İblis Tanrısı,\Nİmparator Danışmanı,
Dialogue: 0,0:13:48.34,0:13:51.30,main,Nanami,0,0,0,,Yüce Birleştirici Şogun ve daha fazlası.
Dialogue: 0,0:13:51.56,0:13:53.18,main,Kousuke,0,0,0,,Varsayılanı nedir?
Dialogue: 0,0:13:53.18,0:13:55.06,main,Nanami,0,0,0,,\"Efendim\" olarak ayarlı.
Dialogue: 0,0:13:55.06,0:13:57.27,main,Kousuke,0,0,0,,Mantıklı olanı da bu zaten.
Dialogue: 0,0:13:57.27,0:13:59.27,main,Nanami,0,0,0,,O halde size Efendim diyeceğim.
Dialogue: 0,0:13:59.77,0:14:03.11,main,Nanami,0,0,0,,Peki, Efendim dışında size\Nbaşka ne demeliyim?
Dialogue: 0,0:14:03.57,0:14:06.32,main,Nanami,0,0,0,,Varsayılanı \"aşağılık solucan.\"
Dialogue: 0,0:14:06.32,0:14:07.78,main,Kousuke,0,0,0,,Berbat bir varsayılan bu!
Dialogue: 0,0:14:07.78,0:14:09.36,main,Kousuke,0,0,0,,Hemen değiştiriyoruz bunu!
Dialogue: 0,0:14:09.36,0:14:12.20,main,Kousuke,0,0,0,,Ama bu hitabı nerede kullanırsın ki?
Dialogue: 0,0:14:12.45,0:14:15.04,main,Nanami,0,0,0,,Merhaba, hava çok güzel, değil mi\Naşağılık solucan?
Dialogue: 0,0:14:15.04,0:14:16.83,main,Kousuke,0,0,0,,Söyleyiş tarzı gayet cana yakın,
Dialogue: 0,0:14:16.83,0:14:19.25,main,Kousuke,0,0,0,,Ama kelimeler kendimi çöpten bile\Ndeğersiz hissettiriyor.
Dialogue: 0,0:14:19.25,0:14:21.17,main,Nanami,0,0,0,,O halde "çöpten bile değersiz"\Nolarak değiştiriyorum.
Dialogue: 0,0:14:21.17,0:14:23.75,main,Kousuke,0,0,0,,Şimdi canlı bile sayılmıyorum!
Dialogue: 0,0:14:23.75,0:14:27.30,main,Kousuke,0,0,0,,Lütfen asgari düzeyde saygı içeren\Nkelimelerde kalalım!
Dialogue: 0,0:14:27.55,0:14:29.18,main,Nanami,0,0,0,,Tüh. Anlaşıldı.
Dialogue: 0,0:14:29.18,0:14:32.72,main,Kouske,0,0,0,,"Tüh" mü?! Biri şununla beni\N yer değiştirsin, lütfen!
Dialogue: 0,0:14:39.69,0:14:41.10,main,Kousuke,0,0,0,,Ben geldim.
Dialogue: 0,0:14:41.10,0:14:42.19,main,Ludie,0,0,0,,Hoş geldin.
Dialogue: 0,0:14:43.57,0:14:44.90,main,Nanami,0,0,0,,Rahatsızlık verdiysem affola.
Dialogue: 0,0:14:49.95,0:14:51.70,main,Ludie,0,0,0,,Kousuke-san, bir bakar mısın?
Dialogue: 0,0:14:53.99,0:14:55.62,main,Ludie,0,0,0,,Şu hizmetçi de neyin nesi?
Dialogue: 0,0:14:55.62,0:14:57.75,main,Ludie,0,0,0,,Onu tam olarak ne için tuttun?
Dialogue: 0,0:14:57.75,0:14:59.37,main,Kousuke,0,0,0,,Aslında tutmadım sayılır,
Dialogue: 0,0:14:59.37,0:15:01.08,main,Kousuke,0,0,0,,Daha çok gidip aldım diyebiliriz.
Dialogue: 0,0:15:01.08,0:15:03.42,main,Ludie,0,0,0,,Gidip aldın mı?! Neyse, peki.
Dialogue: 0,0:15:03.79,0:15:04.96,main,Ludie,0,0,0,,Tanıştığımıza memnun oldum.
Dialogue: 0,0:15:04.96,0:15:06.96,main,Ludie,0,0,0,,Peki, sen kimsin bakalım?
Dialogue: 0,0:15:06.96,0:15:08.97,main,Nanami,0,0,0,,Tanıştığımıza memnun oldum.
Dialogue: 0,0:15:08.97,0:15:13.39,main,Nanami,0,0,0,,Az önce Takioto Kousuke-sama'nın\Nhizmetçisi oldum.
Dialogue: 0,0:15:13.39,0:15:14.93,main,Nanami,0,0,0,,Adım Nanami.
Dialogue: 0,0:15:14.93,0:15:16.47,main,Ludie,0,0,0,,Nanami-san, öyle mi?
Dialogue: 0,0:15:16.47,0:15:18.77,main,Ludie,0,0,0,,Benim adım da Ludivine.
Dialogue: 0,0:15:18.77,0:15:23.31,main,Ludie,0,0,0,,Peki söyle bakalım, seni bu şeyin\Nyörüngesine sokan ne oldu?
Dialogue: 0,0:15:23.61,0:15:26.15,main,Nanami,0,0,0,,Eşi olarak endişenizi anlıyorum,
Dialogue: 0,0:15:26.15,0:15:27.94,main,Nanami,0,0,0,,Ancak öyle bir şey asla olmayacak.
Dialogue: 0,0:15:27.94,0:15:29.61,main,Ludie,0,0,0,,Olmayacak, demek ha?
Dialogue: 0,0:15:29.61,0:15:30.90,main,Ludie,0,0,0,,E-Eşi mi?!
Dialogue: 0,0:15:30.90,0:15:33.37,main,Nanami,0,0,0,,Efendimin hizmetçisi olarak,
Dialogue: 0,0:15:33.37,0:15:35.70,main,Nanami,0,0,0,,Ona tüm kalbimle ve sadakatle\Nhizmet edeceğim
Dialogue: 0,0:15:35.70,0:15:39.25,main,Nanami,0,0,0,,ve onu olumsuz etkileyecek hiçbir\Neylemde bulunmayacağım.
Dialogue: 0,0:15:40.04,0:15:43.42,main,Nanami,0,0,0,,Elbette aynı şey eşi olarak\Nsizin için de geçerlidir.
Dialogue: 0,0:15:43.42,0:15:46.17,main,Ludie,0,0,0,,Bir dakika bekle bakalım,\Nonun karısı olduğumu kim söyledi?
Dialogue: 0,0:15:46.42,0:15:50.80,main,Nanami,0,0,0,,Efendim bu dünyada en çok\Nsize güvendiğini söyledi
Dialogue: 0,0:15:50.80,0:15:53.18,main,Nanami,0,0,0,,Ve aranız çok yakın görünüyor.
Dialogue: 0,0:15:53.18,0:15:56.26,main,Kousuke,0,0,0,,Şey, sana her şeyden çok\Ngüvendiğim doğru.
Dialogue: 0,0:15:56.26,0:15:57.26,main,Ludie,0,0,0,,G-Gerçekten mi?!
Dialogue: 0,0:15:57.26,0:15:59.81,main - italics,Kousuke(M),0,0,0,,Yani, Senpai ve ablamla aynı seviyede,
Dialogue: 0,0:15:59.81,0:16:02.56,main - italics,Kousuke(M),0,0,0,,ama sonuna kadar güvenebileceğim birisin.
Dialogue: 0,0:16:11.82,0:16:13.11,main,Hatsumi,0,0,0,,Çok mu hevesin kaçtı?
Dialogue: 0,0:16:13.11,0:16:15.74,main,Kousuke,0,0,0,,İlk söylediğin laf bu mu yani?
Dialogue: 0,0:16:15.74,0:16:18.03,main,Hatsumi,0,0,0,,İstediğin bir hizmetçi kıyafetiyse,\Nben giyerim.
Dialogue: 0,0:16:18.03,0:16:20.08,main,Nanami,0,0,0,,Tanıştığımıza memnun oldum.
Dialogue: 0,0:16:20.08,0:16:21.50,main,Nanami,0,0,0,,Adım Nanami.
Dialogue: 0,0:16:25.58,0:16:27.59,main,Hatsumi,0,0,0,,Hizmetçilik rolü yapmak istiyorsan,\Nben yaparım.
Dialogue: 0,0:16:27.88,0:16:29.09,main,Kousuke,0,0,0,,Buna bayılırdım!
Dialogue: 0,0:16:29.09,0:16:31.13,main,Kousuke,0,0,0,,Hayır, mesele o değil!
Dialogue: 0,0:16:31.13,0:16:33.01,main,Kousuke,0,0,0,,Onu normal bir hizmetçi olarak tutmak istiyorum!
Dialogue: 0,0:16:33.01,0:16:33.76,main,Hatsumi,0,0,0,,Ben karşıyım.
Dialogue: 0,0:16:33.76,0:16:35.47,main,Kousuke,0,0,0,,Abla, bir dinle...
Dialogue: 0,0:16:35.47,0:16:36.26,main,Hatsumi,0,0,0,,Karşıyım!
Dialogue: 0,0:16:36.26,0:16:38.18,main,Hatsumi,0,0,0,,Hiç gerek yok, ben varım ya.
Dialogue: 0,0:16:38.18,0:16:39.51,main,Kousuke,0,0,0,,Abla!
Dialogue: 0,0:16:39.51,0:16:41.22,main,Nanami,0,0,0,,Lütfen endişelenmeyin, hanımefendi.
Dialogue: 0,0:16:42.89,0:16:45.27,main,Nanami,0,0,0,,Efendimin hizmetçisi olarak,
Dialogue: 0,0:16:45.27,0:16:47.36,main,Nanami,0,0,0,,Ona tüm kalbimle ve sadakatle\Nhizmet edeceğim
Dialogue: 0,0:16:48.06,0:16:51.53,main,Nanami,0,0,0,,ve onu olumsuz etkileyecek hiçbir\Neylemde bulunmayacağım.
Dialogue: 0,0:16:52.44,0:16:56.53,main,Nanami,0,0,0,,Elbette aynı şey eşi olarak\Nsizin için de geçerlidir.
Dialogue: 0,0:16:56.99,0:16:57.95,main,Hatsumi,0,0,0,,Kousuke.
Dialogue: 0,0:16:58.74,0:17:00.45,main,Hatsumi,0,0,0,,Ne kadar da harika bir hizmetçi.
Dialogue: 0,0:17:00.45,0:17:01.54,main,Hatsumi,0,0,0,,Onu bulmakla çok iyi yapmışsın.
Dialogue: 0,0:17:01.54,0:17:02.70,main,Hatsumi,0,0,0,,Kesinlikle işe almalıyız.
Dialogue: 0,0:17:02.95,0:17:07.17,main,Nanami,0,0,0,,Hanımefendi, lütfen adınızı\Nbenimle paylaşır mısınız?
Dialogue: 0,0:17:07.17,0:17:08.50,main,Hatsumi,0,0,0,,Hanamura Hatsumi.
Dialogue: 0,0:17:08.50,0:17:12.34,main,Nanami,0,0,0,,Hatsumi-sama, size hizmet etmeyi\Ndört gözle bekliyorum.
Dialogue: 0,0:17:12.34,0:17:13.17,main,Hatsumi,0,0,0,,Ben de.
Dialogue: 0,0:17:15.76,0:17:19.14,main,Nanami,0,0,0,,Efendim, akşam yemeği vakti yaklaşıyor.
Dialogue: 0,0:17:19.14,0:17:20.85,main,Nanami,0,0,0,,Bana malzemeleri sağlarsanız,
Dialogue: 0,0:17:20.85,0:17:23.02,main,Nanami,0,0,0,,Çok çeşitli yemekler pişirebilirim.
Dialogue: 0,0:17:23.39,0:17:25.69,main,Nanami,0,0,0,,Hanımefendi, siz yemek yediniz mi?
Dialogue: 0,0:17:25.69,0:17:27.35,main,Hatsumi,0,0,0,,Daha kimse yemedi.
Dialogue: 0,0:17:27.35,0:17:29.81,main,Hatsumi,0,0,0,,Ama hiç zahmet etme, bu akşam\Niçin dışarıdan suşi söyledik.
Dialogue: 0,0:17:29.81,0:17:31.23,main,Nanami,0,0,0,,Anlaşıldı.
Dialogue: 0,0:17:31.78,0:17:35.15,main,Nanami,0,0,0,,O halde o zamana kadar uyuyacak\Nbir yer ayarlamak isterim.
Dialogue: 0,0:17:35.15,0:17:36.82,main,Hatsumi,0,0,0,,Bir sürü boş oda var.
Dialogue: 0,0:17:36.82,0:17:41.53,main,Nanami,0,0,0,,Yok canım, öyle lüks bir şeye\Nihtiyacım yok.
Dialogue: 0,0:17:41.53,0:17:44.20,main,Nanami,0,0,0,,Beni Efendim'in yorgan dolabına\Nkoyabilirsiniz.
Dialogue: 0,0:17:44.20,0:17:45.29,main,Kousuke,0,0,0,,Saçmalama!
Dialogue: 0,0:17:45.29,0:17:47.25,main,Hatsumi,0,0,0,,Bu fikre bayıldım.
Dialogue: 0,0:17:47.25,0:17:49.92,main,Nanami,0,0,0,,O zaman siz üst katta kalırsınız,
Dialogue: 0,0:17:49.92,0:17:51.59,main,Nanami,0,0,0,,ben de alt katta kalırım.
Dialogue: 0,0:17:51.59,0:17:53.51,main,Kousuke,0,0,0,,Benim yorgan dolabım bile yok ki!
Dialogue: 0,0:17:53.51,0:17:54.59,main,Kousuke,0,0,0,,Sadece normal bir gardırop!
Dialogue: 0,0:17:54.92,0:17:58.47,main,Nanami,0,0,0,,O halde Hatsumi-sama Efendim'in yatağının\Nsol tarafında uyur,
Dialogue: 0,0:17:58.47,0:18:00.55,main,Nanami,0,0,0,,Ben de sağ tarafında olurum.
Dialogue: 0,0:18:00.55,0:18:02.35,main,Hatsumi,0,0,0,,Evet, kulağa gerçekten şahane geliyor.
Dialogue: 0,0:18:02.35,0:18:03.77,main,Kousuke,0,0,0,,Rıza mı gösteriyorsun yani?!
Dialogue: 0,0:18:03.77,0:18:05.52,main,Kousuke,0,0,0,,Hayır, ciddiyim, bir durun!
Dialogue: 0,0:18:05.52,0:18:08.48,main,Nanami,0,0,0,,Efendim, lütfen, sadece şakaydı.
Dialogue: 0,0:18:08.48,0:18:10.40,main,Nanami,0,0,0,,Böyle bir şeyin gerçekleşme ihtimali yok.
Dialogue: 0,0:18:10.73,0:18:13.44,main,Kousuke,0,0,0,,Yahu, madem öyle neden dedin bunları?
Dialogue: 0,0:18:13.44,0:18:14.11,main,Hatsumi,0,0,0,,Ne?
Dialogue: 0,0:18:14.78,0:18:15.94,main,Hatsumi,0,0,0,,Gerçek değil mi yani?
Dialogue: 0,0:18:15.94,0:18:16.65,main,Both,0,0,0,,Ha?
Dialogue: 0,0:18:17.11,0:18:18.53,main,Ludie,0,0,0,,Kousuke...
Dialogue: 0,0:18:18.95,0:18:21.32,main,Ludie,0,0,0,,O dedikleri hakkında...
Dialogue: 0,0:18:21.32,0:18:22.87,main,Marino,0,0,0,,Ben geldim!
Dialogue: 0,0:18:22.87,0:18:25.12,main,Marino,0,0,0,,Suşiler birazdan gelir!
Dialogue: 0,0:18:25.12,0:18:25.87,main,Marino,0,0,0,,Ha?
Dialogue: 0,0:18:28.29,0:18:29.29,main,Marino,0,0,0,,Güzel.
Dialogue: 0,0:18:30.42,0:18:32.42,main,Marino,0,0,0,,E, nedir bu tantana bakalım?
Dialogue: 0,0:18:32.42,0:18:35.92,main,Kousuke,0,0,0,,Şey, bir zindan temizledim ve onu buldum.
Dialogue: 0,0:18:36.26,0:18:37.38,main,Kousuke,0,0,0,,Sözleşmeyi çoktan yaptık,
Dialogue: 0,0:18:37.38,0:18:40.05,main,Kousuke,0,0,0,,bu yüzden onu burada hizmetçimiz\Nolarak tutmak istiyorum.
Dialogue: 0,0:18:40.34,0:18:41.76,main,Marino,0,0,0,,Anlıyorum.
Dialogue: 0,0:18:42.60,0:18:45.27,main,Marino,0,0,0,,Peki neden o kadar tehlikeli\Nbir işe kalkıştın, hm?
Dialogue: 0,0:18:45.27,0:18:46.98,main,Kousuke,0,0,0,,Hiçbir bahanem yok.
Dialogue: 0,0:18:48.31,0:18:51.48,main,Marino,0,0,0,,Nanami-san'a gelince...
Dialogue: 0,0:18:51.48,0:18:53.11,main,Marino,0,0,0,,A, sen bir melek misin?
Dialogue: 0,0:18:54.86,0:18:56.07,main,Claris,0,0,0,,Ben karşıyım.
Dialogue: 0,0:18:57.28,0:18:58.99,main,Claris,0,0,0,,Kaba gelebilir ama
Dialogue: 0,0:18:58.99,0:19:00.53,main,Claris,0,0,0,,onun hakkında en ufak bir şey\Nbile bilmiyoruz.
Dialogue: 0,0:19:00.53,0:19:03.03,main,Claris,0,0,0,,Ludie-sama'yı korumak benim görevim.
Dialogue: 0,0:19:03.41,0:19:05.29,main,Claris,0,0,0,,Bir şey olursa iş işten geçmiş olur.
Dialogue: 0,0:19:05.29,0:19:08.00,main,Marino,0,0,0,,Hm, bence bir sakıncası yok.
Dialogue: 0,0:19:08.00,0:19:11.67,main,Marino,0,0,0,,Bir meleğin sözleşmesinin güvenliğine\Nkefil olabilirim.
Dialogue: 0,0:19:11.67,0:19:13.13,main,Marino,0,0,0,,Eğer bir sorun çıkacaksa,
Dialogue: 0,0:19:13.13,0:19:16.55,main,Marino,0,0,0,,mesele sözleşmenin yapıldığı Kou-chan'a\Ngüvenip güvenemeyeceğinize kalıyor.
Dialogue: 0,0:19:17.21,0:19:19.42,main,Marino,0,0,0,,Ama bence Kou-chan güvenilirdir.
Dialogue: 0,0:19:19.42,0:19:20.93,main,Nanami,0,0,0,,Dediğiniz gibi,
Dialogue: 0,0:19:20.93,0:19:23.05,main,Nanami,0,0,0,,Sözleşmeyi hiçbir sorun yaşamadan\Ntamamladık.
Dialogue: 0,0:19:23.05,0:19:25.72,main,Claris,0,0,0,,Ama... peki.
Dialogue: 0,0:19:25.72,0:19:27.77,main,Claris,0,0,0,,Hatsumi-sama, siz ne düşünüyorsunuz?
Dialogue: 0,0:19:27.77,0:19:29.14,main,Claris,0,0,0,,İtaatkâr olabilir ama
Dialogue: 0,0:19:29.14,0:19:31.56,main,Claris,0,0,0,,yine de evinizdeki tamamen bir yabancı.
Dialogue: 0,0:19:31.56,0:19:33.15,main,Hatsumi,0,0,0,,Benim için sorun değil.
Dialogue: 0,0:19:33.15,0:19:33.90,main,Claris,0,0,0,,Ne?
Dialogue: 0,0:19:33.90,0:19:35.57,main,Claris,0,0,0,,L-Ludie-sama?
Dialogue: 0,0:19:35.57,0:19:36.57,main,Claris,0,0,0,,Yoksa siz de mi—
Dialogue: 0,0:19:36.57,0:19:41.07,main,Ludie,0,0,0,,B-Ben de Kousuke'ye, şey, \Nher şeyden çok güveniyorum.
Dialogue: 0,0:19:41.07,0:19:42.03,main,Claris,0,0,0,,Ne?!
Dialogue: 0,0:19:42.03,0:19:44.07,main,Marino,0,0,0,,Madem bu iş halloldu,
Dialogue: 0,0:19:44.07,0:19:44.91,main,Marino,0,0,0,,Hadi yemeğe geçelim.
Dialogue: 0,0:19:45.24,0:19:46.20,main,Hatsumi,0,0,0,,Evet.
Dialogue: 0,0:19:46.95,0:19:48.58,main,Hatsumi,0,0,0,,Tatlı yaptım.
Dialogue: 0,0:19:48.91,0:19:50.66,main,Hatsumi,0,0,0,,Okulun başlamasını kutlamak için.
Dialogue: 0,0:19:57.25,0:19:59.30,main,Kousuke,0,0,0,,Bu berbattı...
Dialogue: 0,0:20:14.94,0:20:16.52,main - italics,Kousuke(M),0,0,0,,A-Abla?!
Dialogue: 0,0:20:24.70,0:20:26.41,main - italics,Kousuke(M),0,0,0,,Yarın okul açılış töreni var,
Dialogue: 0,0:20:26.41,0:20:27.62,main - italics,Kousuke(M),0,0,0,,ama uyuyamıyorum.
Dialogue: 0,0:20:28.12,0:20:30.04,main - italics,Kousuke(M),0,0,0,,İçimdeki bu heyecanı atacak yer yokken
Dialogue: 0,0:20:30.04,0:20:31.96,main - italics,Kousuke(M),0,0,0,,ne yapmam gerekiyor ki benim?!
Dialogue: 0,0:20:35.17,0:20:38.67,main - italics,Kousuke(M),0,0,0,,"Okul açılış töreni" dendiğinde\Naklınıza ne gelir?
Dialogue: 0,0:20:39.13,0:20:41.01,main - italics,Kousuke(M),0,0,0,,Normal bir Japon için
Dialogue: 0,0:20:41.01,0:20:43.55,main - italics,Kousuke(M),0,0,0,,Yepyeni üniformalar içindeki öğrenciler
Dialogue: 0,0:20:43.55,0:20:47.26,main - italics,Kousuke(M),0,0,0,,ve hayatlarının yeni dönemini kutlarcasına\Naçan kiraz çiçekleridir.
Dialogue: 0,0:20:48.26,0:20:50.85,main - italics,Kousuke(M),0,0,0,,Kiraz çiçekleri çoğu insan tarafından sevilir.
Dialogue: 0,0:20:50.85,0:20:52.43,main - italics,Kousuke(M),0,0,0,,Erogelerde veya bishoujo oyunlarında da
Dialogue: 0,0:20:52.43,0:20:54.23,main - italics,Kousuke(M),0,0,0,,Kiraz çiçekleri çok sevilen bir çiçektir.
Dialogue: 0,0:20:55.02,0:20:58.19,main - italics,Kousuke(M),0,0,0,,Magical Explorer'da da kiraz çiçekleri yer alır.
Dialogue: 0,0:20:58.19,0:21:00.90,main - italics,Kousuke(M),0,0,0,,Ana karakter yurdundan akademiye gitmek için
Dialogue: 0,0:21:00.90,0:21:04.11,main - italics,Kousuke(M),0,0,0,,Kiraz ağaçlarıyla çevrili bir yoldan geçer.
Dialogue: 0,0:21:05.07,0:21:08.07,main - italics,Kousuke(M),0,0,0,,Ama ben kesinlikle ana karakter değilim.
Dialogue: 0,0:21:13.50,0:21:17.33,main - italics,Kousuke(M),0,0,0,,Bu bilinen hikaye akışlarını\Nbozmayı planlıyordum...
Dialogue: 0,0:21:18.92,0:21:20.30,main - italics,Kousuke(M),0,0,0,,Ama bilirsiniz ya...
Dialogue: 0,0:21:20.84,0:21:23.38,main - italics,Kousuke(M),0,0,0,,Belki de kader diye bir şey vardır.
Dialogue: 0,0:21:23.38,0:21:26.93,main - italics,Kousuke(M),0,0,0,,Ama bir erkekle ilgili olunca "kader" lafı\Nneden kulağa bu kadar imalı geliyor?
Dialogue: 0,0:21:28.01,0:21:30.22,main,Kousuke,0,0,0,,Hadi ya, kapalıymış.
Dialogue: 0,0:21:30.89,0:21:32.68,main,Kousuke,0,0,0,,Selam, sen de mi yeni öğrencisin?
Dialogue: 0,0:21:32.68,0:21:34.89,main,Iori,0,0,0,,E-Evet, öyleyim.
Dialogue: 0,0:21:35.18,0:21:37.69,main,Kousuke,0,0,0,,Gördüğün gibi ben de yeniyim.
Dialogue: 0,0:21:46.32,0:21:50.62,main - italics,Kousuke(M),0,0,0,,Oyundaki Takioto Kousuke ile aynı replikleri\Nkullanmayı pek sevmiyorum
Dialogue: 0,0:21:51.08,0:21:53.49,main - italics,Kousuke(M),0,0,0,,Ama bu replik hem klişe hem de çok havalıydı,
Dialogue: 0,0:21:53.49,0:21:54.83,main - italics,Kousuke(M),0,0,0,,O yüzden görmezden geleceğim.
Dialogue: 0,0:21:55.54,0:21:57.29,main,Kousuke,0,0,0,,Kendimi henüz tanıtmadım.
Dialogue: 0,0:21:57.75,0:21:59.67,main,Kousuke,0,0,0,,Benim adım Takioto Kousuke.
Dialogue: 0,0:22:00.42,0:22:04.42,main,Kousuke,0,0,0,,Tsukuyomi Büyü Akademisi'nin en güçlüsü\Nolacak adamım!
