Dialogue: 0,0:00:00.91,0:00:02.27,main - italics top,Kousuke(M),0,0,0,,Oyunun orijinalinde,
Dialogue: 0,0:00:02.27,0:00:03.92,main - italics top,Kousuke(M),0,0,0,,Ludie erkeklerden korkan bir karakterdi.
Dialogue: 0,0:00:03.92,0:00:06.78,main - italics top,Kousuke(M),0,0,0,,Daha doğrusu, insanlardan korkuyordu.
Dialogue: 0,0:00:07.60,0:00:09.63,main - italics top,Kousuke(M),0,0,0,,Aslında soğukkanlı biridir,
Dialogue: 0,0:00:09.63,0:00:11.82,main - italics top,Kousuke(M),0,0,0,,ama insanlara karşı sık sık sert konuşur.
Dialogue: 0,0:00:11.82,0:00:14.81,main,Ludie,0,0,0,,Kimseye güvenmediğimi söyledim!
Dialogue: 0,0:00:14.81,0:00:16.84,main,Ludie,0,0,0,,Benimle konuşmayı kes!
Dialogue: 0,0:00:17.44,0:00:18.31,main,Ludie,0,0,0,,Aptal!
Dialogue: 0,0:00:18.68,0:00:23.07,main - italics,Kousuke(M),0,0,0,,Ondan azar işitmekten hoşlanan erkekler
Dialogue: 0,0:00:23.07,0:00:25.21,main - italics,Kousuke(M),0,0,0,,“Ludie Sendromu hastaları” diye anılırdı.
Dialogue: 0,0:00:25.90,0:00:28.95,main - italics,Kousuke(M),0,0,0,,Ama belli bir olaydan sonra \Nseninle çıkmaya başlar.
Dialogue: 0,0:00:28.95,0:00:32.76,main - italics,Kousuke(M),0,0,0,,Sana tamamen tutulur, \Ngözü senden başkasını görmez.
Dialogue: 0,0:00:33.24,0:00:36.07,main - italics,Kousuke(M),0,0,0,,Oyuncu dışındaki herkese tepeden bakar,
Dialogue: 0,0:00:36.07,0:00:39.89,main - italics,Kousuke(M),0,0,0,,Takioto Kousuke'ye kanatlı\N böcekten beter davranır.
Dialogue: 0,0:00:40.75,0:00:43.55,main - italics,Kousuke(M),0,0,0,,Belki de herkesin onu \Nsahiplenmek istemesi bundandı,
Dialogue: 0,0:00:43.55,0:00:45.94,main - italics,Kousuke(M),0,0,0,,çünkü eşi benzeri yoktu.
Dialogue: 0,0:00:46.30,0:00:50.86,main - italics,Kousuke(M),0,0,0,,Ama Ludie insanlardan, özellikle erkeklerden neden bu kadar nefret ediyor?
Dialogue: 0,0:00:51.62,0:00:55.16,main - italics,Kousuke(M),0,0,0,,Belki de buna yol açan olayı\Nşu an yaşıyorumdur.
Dialogue: 0,0:00:56.04,0:00:57.29,main - italics,Kousuke(M),0,0,0,,Şimdi hatırladım...
Dialogue: 0,0:00:57.29,0:01:01.83,main,Developer,0,0,0,,Ludie'nin erkeklerden bu kadar nefret etmesinin bir nedeni vardı.
Dialogue: 0,0:01:02.60,0:01:06.67,main,Developer,0,0,0,,Ama bu, bakireliğini kaybetmesi demekti.\NO yüzden o kısmı çıkardık.
Dialogue: 0,0:01:06.98,0:01:12.97,italics,Kousuke(M),0,0,0,,Yetişkin oyunu oyuncularını çıldırtacak\Nbir hikâye düşünmüşlerdi.
Dialogue: 0,0:02:46.09,0:02:49.01,main,Ludie,0,0,0,,Keşke büyüde daha iyi olsaydım...
Dialogue: 0,0:02:50.72,0:02:51.96,main,Ludie,0,0,0,,Claris!
Dialogue: 0,0:02:52.96,0:02:55.31,main - italics,Kousuke(M),0,0,0,,Şimdi ne yapacağım?
Dialogue: 0,0:02:57.73,0:02:59.81,main - italics,Kousuke(M),0,0,0,,Keşke Zihin Gözü yeteneğim olsaydı.
Dialogue: 0,0:03:00.34,0:03:01.73,main,Kousuke,0,0,0,,Bana yardım eder misin?
Dialogue: 0,0:03:02.63,0:03:04.82,main,Kousuke,0,0,0,,Daha savunma büyüsü\N yapamıyorsun, değil mi?
Dialogue: 0,0:03:06.42,0:03:09.48,main,Kousuke,0,0,0,,Ben işaret verince büyü yapıyormuş\N gibi davranıp öne atıl.
Dialogue: 0,0:03:09.88,0:03:10.70,main,Ludie,0,0,0,,Yapıyormuş gibi mi?
Dialogue: 0,0:03:11.01,0:03:12.76,main,Kousuke,0,0,0,,Aslında onları kör edeceksin.
Dialogue: 0,0:03:13.45,0:03:14.91,main,Kousuke,0,0,0,,Bunu yapabilirsin, değil mi?
Dialogue: 0,0:03:15.86,0:03:16.62,main,Ludie,0,0,0,,Evet.
Dialogue: 0,0:03:16.89,0:03:18.96,main,Kousuke,0,0,0,,Kalkan büyüsü yapabilir misin?
Dialogue: 0,0:03:21.05,0:03:23.88,main - italics,Kousuke(M),0,0,0,,Onları yem olarak kullanmak içime sinmiyor.
Dialogue: 0,0:03:24.74,0:03:26.62,main,Kousuke,0,0,0,,Gerisini bana bırak!
Dialogue: 0,0:03:28.84,0:03:31.50,main,Aurealian,0,0,0,,Şu kumaş çok sinir bozucu.
Dialogue: 0,0:03:31.50,0:03:32.47,main,GuyA,0,0,0,,Yakıp kül edin!
Dialogue: 0,0:03:37.05,0:03:38.64,main - italics,Kousuke(M),0,0,0,,Kahretsin! Vaktim yok!
Dialogue: 0,0:03:41.81,0:03:42.76,main,Kousuke,0,0,0,,Hadi!
Dialogue: 0,0:03:42.76,0:03:43.40,main,Kousuke,0,0,0,,On saniye sonra!
Dialogue: 0,0:03:44.77,0:03:47.74,main,Kousuke,0,0,0,,On, dokuz, sekiz.
Dialogue: 0,0:03:47.74,0:03:50.70,main,Kousuke,0,0,0,,Yedi, altı, beş.
Dialogue: 0,0:03:50.94,0:03:51.66,main,Kousuke,0,0,0,,Dört.
Dialogue: 0,0:03:51.66,0:03:52.61,main,Kousuke,0,0,0,,Üç.
Dialogue: 0,0:03:52.88,0:03:53.80,main,Kousuke,0,0,0,,İki.
Dialogue: 0,0:03:53.80,0:03:54.74,main,Kousuke,0,0,0,,Bir.
Dialogue: 0,0:03:54.74,0:03:55.24,main,Kousuke,0,0,0,,Ludie!
Dialogue: 0,0:03:57.41,0:03:58.07,main,Kousuke,0,0,0,,Şimdi!
Dialogue: 0,0:03:58.07,0:03:59.22,main,Kousuke,0,0,0,,Kalkan büyüsü!
Dialogue: 0,0:03:59.22,0:03:59.87,main,Ludie,0,0,0,,Aegis!
Dialogue: 0,0:04:01.72,0:04:03.60,main,Aurealian,0,0,0,,Çocuk işi bir kalkan.
Dialogue: 0,0:04:03.60,0:04:05.00,main,GuyA,0,0,0,,Trefl Prensesi'ni hedef alın.
Dialogue: 0,0:04:07.57,0:04:08.21,main,Ludie,0,0,0,,Işık!
Dialogue: 0,0:04:35.64,0:04:36.83,main,Kousuke,0,0,0,,Bu kadarı yeter.
Dialogue: 0,0:04:47.71,0:04:48.89,main,Marino,0,0,0,,İşimiz bitti.
Dialogue: 0,0:04:50.04,0:04:51.38,main,Marino,0,0,0,,Ayağa kalkabilir misin?
Dialogue: 0,0:04:51.91,0:04:53.38,main,Claris,0,0,0,,E-Evet.
Dialogue: 0,0:04:56.16,0:04:57.36,main,Claris,0,0,0,,Vay canına.
Dialogue: 0,0:04:58.22,0:05:00.22,main,Marino,0,0,0,,İyi görünüyorsun.
Dialogue: 0,0:05:00.49,0:05:01.96,main,Claris,0,0,0,,Çok teşekkür ederim.
Dialogue: 0,0:05:03.73,0:05:06.50,main,Ludie,0,0,0,,Yardımınız için teşekkür ederim.
Dialogue: 0,0:05:06.50,0:05:07.90,main - italics,Kousuke(M),0,0,0,,Çok tatlı.
Dialogue: 0,0:05:08.44,0:05:11.61,main - italics,Kousuke(M),0,0,0,,Eteğini de yırtmışlar.
Dialogue: 0,0:05:12.12,0:05:13.46,main,Kousuke,0,0,0,,Şey...
Dialogue: 0,0:05:14.08,0:05:15.99,main,Kousuke,0,0,0,,Eteğin...
Dialogue: 0,0:05:15.99,0:05:17.00,main,Ludie,0,0,0,,Hı?
Dialogue: 0,0:05:19.45,0:05:20.33,main,Ludie,0,0,0,,Bakma!
Dialogue: 0,0:05:20.33,0:05:23.76,main,Kousuke,0,0,0,,Biliyorum ama... üstüne örtecek bir şey...
Dialogue: 0,0:05:23.76,0:05:25.08,main,Kousuke,0,0,0,,Ha, doğru. Bunu al!
Dialogue: 0,0:05:34.36,0:05:36.55,main,Kousuke,0,0,0,,İki elim de hâlâ titriyor sanki.
Dialogue: 0,0:05:37.21,0:05:40.06,main,Kousuke,0,0,0,,Bu da ne?
Dialogue: 0,0:05:46.56,0:05:49.36,main,Kousuke,0,0,0,,Çok özür dilerim!
Dialogue: 0,0:05:52.53,0:05:55.41,main,Marino,0,0,0,,Onlara bilerek dokunmadın ki.
Dialogue: 0,0:05:55.41,0:05:56.45,main,Kousuke,0,0,0,,Tabii ki bilerek yapmadım!
Dialogue: 0,0:05:57.48,0:05:59.90,main,Marino,0,0,0,,Yani bunu bilerek yapmadın, değil mi?
Dialogue: 0,0:05:59.90,0:06:01.40,main,Kousuke,0,0,0,,Hayır!
Dialogue: 0,0:06:01.40,0:06:03.24,main,Marino,0,0,0,,Güzel!
Dialogue: 0,0:06:03.24,0:06:06.21,main,Marino,0,0,0,,Bir dahaki sefere sana daha sağlam bir telefon alırım.
Dialogue: 0,0:06:06.83,0:06:08.22,main,Kousuke,0,0,0,,Çok özür dilerim.
Dialogue: 0,0:06:10.04,0:06:11.09,main,Ludie,0,0,0,,İzin verin, kendimi tanıtayım.
Dialogue: 0,0:06:11.43,0:06:14.84,main,Ludie,0,0,0,,Ben Ludivine Marie-Ange de la Tréfle.
Dialogue: 0,0:06:15.37,0:06:17.48,main,Ludie,0,0,0,,Bu da hizmetçim.
Dialogue: 0,0:06:17.83,0:06:19.34,main,Claris,0,0,0,,Adım Claris.
Dialogue: 0,0:06:20.48,0:06:22.39,main,Kousuke,0,0,0,,Ben Takioto Kousuke.
Dialogue: 0,0:06:26.31,0:06:30.15,main - italics,Kousuke(M),0,0,0,,Şu an yerlere kadar eğilip özür mü dilemeliyim?
Dialogue: 0,0:06:30.15,0:06:34.67,main,Ludie,0,0,0,,Takioto-sama, az önceki yardımınız için çok teşekkür ederim.
Dialogue: 0,0:06:34.67,0:06:39.66,main,Kousuke,0,0,0,,Yok, asıl benim özür dilemem gerek.
Dialogue: 0,0:06:39.66,0:06:41.99,main,Ludie,0,0,0,,Ama hayatımızı kurtardınız.
Dialogue: 0,0:06:42.51,0:06:45.20,main,Ludie,0,0,0,,Özür dileyecek bir şey yok.
Dialogue: 0,0:06:45.64,0:06:48.08,main,Ludie,0,0,0,,O bir kazaydı, değil mi?
Dialogue: 0,0:06:49.54,0:06:52.01,main,Kousuke,0,0,0,,Bunun için gerçekten çok özür dilerim!
Dialogue: 0,0:06:53.36,0:06:54.43,main,Ludie,0,0,0,,Anlıyorum.
Dialogue: 0,0:06:54.43,0:06:56.29,main,Ludie,0,0,0,,Özrünüzü kabul ediyorum.
Dialogue: 0,0:06:56.29,0:06:57.66,main,Ludie,0,0,0,,Ama daha önemli bir şey var...
Dialogue: 0,0:06:57.66,0:06:59.51,main,Marino,0,0,0,,...şimdi ne yapacağımız.
Dialogue: 0,0:06:59.51,0:07:00.28,main,Ludie,0,0,0,,Evet.
Dialogue: 0,0:07:00.70,0:07:03.43,main,Ludie,0,0,0,,Önce ülkemizin istihbarat raporu var.
Dialogue: 0,0:07:04.11,0:07:06.10,main,Ludie,0,0,0,,Bu kez ülkemizdeki bir grup\Nbeni hedef aldı.
Dialogue: 0,0:07:06.10,0:07:10.15,main,Ludie,0,0,0,,Bu grup, Kötücül Lord Kilisesi'yle\Niş birliği yapmış.
Dialogue: 0,0:07:10.49,0:07:17.07,main,Ludie,0,0,0,,Akademiye kaydolunca saldırılar \Ndurur diye düşünüyorum.
Dialogue: 0,0:07:17.62,0:07:18.58,main,Ludie,0,0,0,,Ancak...
Dialogue: 0,0:07:18.58,0:07:21.28,main,Marino,0,0,0,,Tamamen durmaz.
Dialogue: 0,0:07:21.61,0:07:23.06,main,Marino,0,0,0,,Biri kaçmayı başarmış.
Dialogue: 0,0:07:24.38,0:07:27.16,main - italics,Kousuke(M),0,0,0,,Bunca şeyin arasından nasıl kaçmış?
Dialogue: 0,0:07:29.66,0:07:33.02,main,Ludie,0,0,0,,Bunun için gerçekten üzgünüm,\NTakioto-sama.
Dialogue: 0,0:07:33.71,0:07:35.67,main,Claris,0,0,0,,Hanamura ailesi hep
Dialogue: 0,0:07:35.67,0:07:38.39,main,Claris,0,0,0,,Kötücül Lord Kilisesi'nin hedefindeydi.
Dialogue: 0,0:07:39.00,0:07:42.21,main,Claris,0,0,0,,Otele yapılan son saldırı da bunun parçasıydı.
Dialogue: 0,0:07:42.68,0:07:43.85,main,Marino,0,0,0,,Doğru.
Dialogue: 0,0:07:43.85,0:07:46.76,main,Marino,0,0,0,,Dedemin zamanından beri bu işin içindeyiz...
Dialogue: 0,0:07:47.27,0:07:48.89,main,Marino,0,0,0,,İşler biraz karışık.
Dialogue: 0,0:07:49.52,0:07:51.70,main,Claris,0,0,0,,Takioto-sama da artık
Dialogue: 0,0:07:51.70,0:07:55.72,main,Claris,0,0,0,,ortadan kaldırılması gereken biri sayılabilir.
Dialogue: 0,0:07:56.36,0:07:57.07,main,Kousuke,0,0,0,,Ne?
Dialogue: 0,0:07:57.07,0:07:59.76,main,Ludie,0,0,0,,Çünkü beni kurtardınız.
Dialogue: 0,0:07:59.76,0:08:01.20,main,Ludie,0,0,0,,Çok üzgünüm.
Dialogue: 0,0:08:01.20,0:08:07.41,main,Kousuke,0,0,0,,Zaten Hanamuraları gözlerine kestirmişler,
Dialogue: 0,0:08:07.41,0:08:08.69,main,Kousuke,0,0,0,,o yüzden lütfen endişelenmeyin.
Dialogue: 0,0:08:09.08,0:08:11.72,main,Ludie,0,0,0,,Yine de endişelenmemek elde değil.
Dialogue: 0,0:08:11.72,0:08:15.24,main,Ludie,0,0,0,,Bundan sonra hep endişe edeceğim.
Dialogue: 0,0:08:15.66,0:08:18.28,main,Kousuke,0,0,0,,H-Haklısınız.
Dialogue: 0,0:08:18.87,0:08:21.01,main - italics,Kousuke(M),0,0,0,,Bu oyunda böyle olmamıştı.
Dialogue: 0,0:08:21.01,0:08:24.11,main,Ludie,0,0,0,,Claris, babamdan gelen mesajı aç lütfen.
Dialogue: 0,0:08:24.11,0:08:24.73,main,Claris,0,0,0,,Tabii.
Dialogue: 0,0:08:35.18,0:08:36.90,main - italics,Father,0,0,0,,Takioto Kousuke-dono.
Dialogue: 0,0:08:37.31,0:08:43.17,main - italics,Father,0,0,0,,Kıymetli kızımız Ludie'yi kurtardığınız için\Nen içten teşekkürlerimizi kabul edin.
Dialogue: 0,0:08:44.28,0:08:47.91,main - italics,Father,0,0,0,,Ülkemiz sizin için elinden geleni yapacak.
Dialogue: 0,0:08:47.91,0:08:50.83,main - italics,Father,0,0,0,,Akademide huzurlu bir öğrencilik geçirmenizi sağlayacağız.
Dialogue: 0,0:08:51.95,0:08:54.58,main - italics,Father,0,0,0,,Bir de size açıkça söylemem gereken bir şey var.
Dialogue: 0,0:08:55.56,0:08:57.95,main - italics,Father,0,0,0,,Kızıma el sürmeyin.
Dialogue: 0,0:08:57.95,0:09:03.72,main - italics,Father,0,0,0,,Yoksa ordumuzun başında bizzat\Nakademiye yürürüm.
Dialogue: 0,0:09:04.82,0:09:05.60,main - italics,Father,0,0,0,,Anlaşıldı mı?
Dialogue: 0,0:09:05.60,0:09:07.72,main - italics,Father,0,0,0,,Kızıma hiçbir koşulda dokunmayın.
Dialogue: 0,0:09:08.08,0:09:09.72,main - italics,Father,0,0,0,,Sakın dokunmayın—
Dialogue: 0,0:09:11.65,0:09:15.09,main,Kousuke,0,0,0,,Böyle bir imparator varken ülke nasıl ayakta kalıyor?
Dialogue: 0,0:09:15.09,0:09:18.65,main,Claris,0,0,0,,Siyaset konusunda gayet başarılı.
Dialogue: 0,0:09:18.65,0:09:20.65,main,Marino,0,0,0,,Biz de soruşturmaya devam edeceğiz.
Dialogue: 0,0:09:24.12,0:09:29.03,main,Marino,0,0,0,,Otelimizde böyle bir saldırı yapmalarını\Nyanlarına bırakmam.
Dialogue: 0,0:09:29.51,0:09:32.88,main,Ludie,0,0,0,,Babamın bir önerisi var.
Dialogue: 0,0:09:32.88,0:09:34.65,main,Claris,0,0,0,,Tréfle İmparatorluğu, akademide
Dialogue: 0,0:09:34.65,0:09:41.13,main,Claris,0,0,0,,başlıca hedeflerin Ludie-sama ile Takioto-sama olacağını düşünüyor.
Dialogue: 0,0:09:41.73,0:09:43.23,main - italics,Kousuke(M),0,0,0,,Haklılar.
Dialogue: 0,0:09:43.56,0:09:47.07,main - italics,Kousuke(M),0,0,0,,Kötücül Lord Kilisesi kesin Ludie'yi hedef alacak.
Dialogue: 0,0:09:47.59,0:09:52.56,main - italics,Kousuke(M),0,0,0,,Bu da onun ana karakterle hızla yakınlaşmasına yol açmalı.
Dialogue: 0,0:09:53.16,0:09:54.91,main - italics,Kousuke(M),0,0,0,,Aklıma geldi.
Dialogue: 0,0:09:54.91,0:09:59.77,main - italics,Kousuke(M),0,0,0,,Önce rehineler alıp yasak \Nçağırma büyüleri kullanıyorlar.
Dialogue: 0,0:10:00.06,0:10:03.43,main - italics,Kousuke(M),0,0,0,,Sonra kasabada birden zindan beliriyor.
Dialogue: 0,0:10:04.17,0:10:06.58,main,Claris,0,0,0,,Sadece Ludie-sama'yı korumak istemiyoruz.
Dialogue: 0,0:10:06.58,0:10:09.62,main,Claris,0,0,0,,Sizi de korumak istiyoruz.
Dialogue: 0,0:10:10.08,0:10:10.74,main,Claris,0,0,0,,Bu yüzden...
Dialogue: 0,0:10:11.06,0:10:12.12,main,Marino,0,0,0,,Aynen.
Dialogue: 0,0:10:12.63,0:10:16.37,main,Marino,0,0,0,,En iyisi Ludie-chan ile Claris-chan\Nbizimle yaşasın.
Dialogue: 0,0:10:16.61,0:10:17.12,main,Kousuke,0,0,0,,Ne?
Dialogue: 0,0:10:19.88,0:10:21.39,main,Claris,0,0,0,,Harikasınız, Marino-sama.
Dialogue: 0,0:10:21.39,0:10:23.27,main,Claris,0,0,0,,Hemen anlamanız çok işimize yaradı.
Dialogue: 0,0:10:23.68,0:10:25.17,main,Claris,0,0,0,,Eşyalarımız birazdan gelir.
Dialogue: 0,0:10:25.50,0:10:28.05,main,Claris,0,0,0,,Yarından itibaren sizinle yaşamaya başlayacağız.
Dialogue: 0,0:10:28.05,0:10:29.01,main,Kousuke,0,0,0,,Ne?!
Dialogue: 0,0:10:29.27,0:10:30.22,main,Marino,0,0,0,,Harika!
Dialogue: 0,0:10:30.73,0:10:32.18,main - italics,Kousuke(M),0,0,0,,Yok artık!
Dialogue: 0,0:10:35.73,0:10:37.55,main,Marino,0,0,0,,Banyo hazır.
Dialogue: 0,0:10:37.55,0:10:39.46,main,Marino,0,0,0,,Önce sen girsene.
Dialogue: 0,0:10:39.90,0:10:41.33,main,Kousuke,0,0,0,,Sağ ol.
Dialogue: 0,0:10:41.33,0:10:43.16,main,Marino,0,0,0,,Sonra görüşürüz.
Dialogue: 0,0:10:46.39,0:10:49.28,main,Kousuke,0,0,0,,Hikâye ne kadar değişecek acaba?
Dialogue: 0,0:10:53.95,0:10:56.71,main - italics,Kousuke(M),0,0,0,,Elimden geldiğince hazırlık yapmalıyım.
Dialogue: 0,0:10:56.71,0:10:59.66,main - italics,Kousuke(M),0,0,0,,Önce kondisyonumu ve manamı artırmam gerek.
Dialogue: 0,0:10:59.66,0:11:01.79,main - italics,Kousuke(M),0,0,0,,Biraz da yeni yetenekler öğrenmeliyim...
Dialogue: 0,0:11:07.76,0:11:10.72,main,Kousuke,0,0,0,,Çok özür dilerim!
Dialogue: 0,0:11:10.72,0:11:11.93,main,Marino,0,0,0,,Ne oldu?
Dialogue: 0,0:11:25.39,0:11:26.90,main,Marino,0,0,0,,Aman aman!
Dialogue: 0,0:11:31.32,0:11:32.99,main,Marino,0,0,0,,Yaramaz seni.
Dialogue: 0,0:11:32.99,0:11:36.73,main,Marino,0,0,0,,Hatsumi yetmedi mi?\N Bir de bana mı göz diktin?
Dialogue: 0,0:11:36.73,0:11:38.08,main,Marino,0,0,0,,Ne de hızlısın!
Dialogue: 0,0:11:38.08,0:11:40.26,main,Kousuke,0,0,0,,H-Hayır, öyle değil.
Dialogue: 0,0:11:58.17,0:12:00.52,main - italics,Kousuke(M),0,0,0,,Öldüm mü ben?
Dialogue: 0,0:12:02.45,0:12:05.29,main,Kousuke,0,0,0,,Dün gece için çok özür dilerim!
Dialogue: 0,0:12:05.29,0:12:09.33,main - italics,Kousuke(m),0,0,0,,Yaşı genç ama Hanamura Hatsumi \Nakademide profesör.
Dialogue: 0,0:12:09.88,0:12:13.30,main - italics,Kousuke(m),0,0,0,,Ana karaktere önemli teknikleri öğretiyor.
Dialogue: 0,0:12:13.80,0:12:17.59,main - italics,Kousuke(m),0,0,0,,Orijinal oyunda ölen babasının\Naraştırmalarını sürdürüyor.
Dialogue: 0,0:12:21.14,0:12:23.72,main,Hatsumi,0,0,0,,Başını kaldır, Kousuke.
Dialogue: 0,0:12:23.72,0:12:25.43,main,Kousuke,0,0,0,,Evet.
Dialogue: 0,0:12:26.48,0:12:28.02,main,Hatsumi,0,0,0,,Sana bir şey soracağım.
Dialogue: 0,0:12:28.35,0:12:29.48,main,Kousuke,0,0,0,,Nedir?
Dialogue: 0,0:12:30.10,0:12:33.44,main,Hatsumi,0,0,0,,Olgun kadınlardan hoşlanır mısın?
Dialogue: 0,0:12:34.27,0:12:35.03,main,Kousuke,0,0,0,,Ne?
Dialogue: 0,0:12:35.86,0:12:37.36,main,Hatsumi,0,0,0,,Yetişkin kadınlardan hoşlanır mısın?
Dialogue: 0,0:12:39.32,0:12:41.32,main,Hatsumi,0,0,0,,Annem yaşlı bir kadın.
Dialogue: 0,0:12:41.32,0:12:45.66,main,Kousuke,0,0,0,,Bu sonuca nereden vardın?
Dialogue: 0,0:12:46.12,0:12:49.62,main,Hatsumi,0,0,0,,Annemle çok iyi anlaşıyorsun ya,
Dialogue: 0,0:12:49.62,0:12:52.33,main,Hatsumi,0,0,0,,acaba benim yeni babam mı olmak istiyorsun diye düşündüm.
Dialogue: 0,0:12:52.33,0:12:53.29,main,Kousuke,0,0,0,,Ne?!
Dialogue: 0,0:12:53.29,0:12:55.05,main - italics,Kousuke(M),0,0,0,,Nasıl bir yetişkin oyunu olurdu bu?!
Dialogue: 0,0:12:55.05,0:12:57.51,main - italics,Kousuke(M),0,0,0,,Varsa adını söyleyin de oynayayım!
Dialogue: 0,0:12:58.17,0:13:01.30,main - italics,Kousuke(M),0,0,0,,Tabii ki Marino-san hayalimdeki kadın,
Dialogue: 0,0:13:01.30,0:13:02.84,main - italics,Kousuke(M),0,0,0,,onunla birlikte olabiliyorsam...
Dialogue: 0,0:13:02.84,0:13:05.35,main - italics,Kousuke(M),0,0,0,,Ben ne düşünüyorum?!
Dialogue: 0,0:13:06.18,0:13:08.31,main,Kousuke,0,0,0,,Her neyse, bu söz konusu bile olamaz.
Dialogue: 0,0:13:09.64,0:13:13.48,main,Hatsumi,0,0,0,,O zaman benimle daha samimi konuşmanı istiyorum.
Dialogue: 0,0:13:13.81,0:13:14.94,main,Hatsumi,0,0,0,,Bana Onee-chan de.
Dialogue: 0,0:13:16.15,0:13:17.36,main,Kousuke,0,0,0,,Şey...
Dialogue: 0,0:13:18.74,0:13:19.82,main,Hatsumi,0,0,0,,Onee-chan.
Dialogue: 0,0:13:20.57,0:13:24.03,main,Kousuke,0,0,0,,O zaman H-Hatsumi-neesan diyeyim.
Dialogue: 0,0:13:25.87,0:13:28.75,italics,Kousuke(M),0,0,0,,Onee-chan dememi bu kadar mı istiyordu?
Dialogue: 0,0:13:31.67,0:13:33.08,main,Kousuke,0,0,0,,Ee, Nee-san,
Dialogue: 0,0:13:33.08,0:13:36.46,main,Kousuke,0,0,0,,Tsukuyomi Büyü Akademisi'nde profesörsün,\Nbir de oradan mezunsun, değil mi?
Dialogue: 0,0:13:36.80,0:13:39.13,main,Kousuke,0,0,0,,Öğrenciyken nasıldı?
Dialogue: 0,0:13:39.67,0:13:41.72,main,Hatsumi,0,0,0,,Orada çok etkileyici insanlar vardı,
Dialogue: 0,0:13:42.09,0:13:45.60,main,Hatsumi,0,0,0,,ama neredeyse hiç arkadaşım yoktu.
Dialogue: 0,0:13:48.14,0:13:53.02,main,Hatsumi,0,0,0,,Yine de bilgini ve gücünü geliştirmek için\Nbundan iyi bir yer yok.
Dialogue: 0,0:13:53.65,0:13:55.69,main,Hatsumi,0,0,0,,Sana büyü öğreteyim mi?
Dialogue: 0,0:13:55.69,0:14:00.15,main,Kousuke,0,0,0,,Aslında yaradılışım yüzünden büyülerin çoğunu kullanamıyorum.
Dialogue: 0,0:14:00.65,0:14:01.61,main,Hatsumi,0,0,0,,Anladım...
Dialogue: 0,0:14:01.61,0:14:05.53,main,Kousuke,0,0,0,,Aslında sana danışmak\N istediğim bir şey vardı,
Dialogue: 0,0:14:05.53,0:14:06.58,main,Kousuke,0,0,0,,yaradılışımla ilgili.
Dialogue: 0,0:14:06.99,0:14:10.79,main,Kousuke,0,0,0,,Bu konuda bana yardım edebilir misin?
Dialogue: 0,0:14:13.08,0:14:14.08,main,Hatsumi,0,0,0,,Tabii ki.
Dialogue: 0,0:14:14.08,0:14:15.25,main,Hatsumi,0,0,0,,Hemen hazırlanayım.
Dialogue: 0,0:14:15.63,0:14:17.25,main,Kousuke,0,0,0,,Çok teşekkür ederim.
Dialogue: 0,0:14:18.34,0:14:20.88,main,Kousuke,0,0,0,,O zaman biraz koşup geleyim.
Dialogue: 0,0:14:36.77,0:14:40.53,main - italics,Kousuke(M),0,0,0,,Demek Tréfle prensesi taşınınca böyle oluyormuş.
Dialogue: 0,0:14:45.32,0:14:48.07,main - italics,Kousuke(M),0,0,0,,Bunlar Claris-san'ın kıyafetleri mi?!
Dialogue: 0,0:14:49.66,0:14:53.83,main - italics,Kousuke(M),0,0,0,,Hizmetçi üniforması dışında ne giyiyor acaba?
Dialogue: 0,0:14:55.25,0:14:56.63,main,Claris,0,0,0,,Bir sorun mu var?
Dialogue: 0,0:15:00.17,0:15:02.84,main,Kousuke,0,0,0,,B-Bir şey düşünüyordum sadece!
Dialogue: 0,0:15:02.84,0:15:04.01,main,Claris,0,0,0,,Öyle mi?
Dialogue: 0,0:15:04.01,0:15:06.38,main,Kousuke,0,0,0,,Ben aslında...
Dialogue: 0,0:15:06.38,0:15:07.89,main,Claris,0,0,0,,Kendi kendini ele mi veriyorsun?
Dialogue: 0,0:15:07.89,0:15:09.43,main,Kousuke,0,0,0,,Hayır!
Dialogue: 0,0:15:09.43,0:15:12.10,main,Kousuke,0,0,0,,Doğru ya. Bir şey taşımana yardım edeyim mi?
Dialogue: 0,0:15:12.10,0:15:14.73,main,Claris,0,0,0,,Yok, bazıları çok ağır.
Dialogue: 0,0:15:14.73,0:15:16.73,main,Kousuke,0,0,0,,Tam da bu yüzden taşımalıyım!
Dialogue: 0,0:15:17.10,0:15:20.15,main,Kousuke,0,0,0,,Yeteneklerle ilgili birkaç şey soracaktım,
Dialogue: 0,0:15:20.15,0:15:22.23,main,Kousuke,0,0,0,,bari yardım edip bir iyiliğini kazanayım.
Dialogue: 0,0:15:23.15,0:15:25.86,main,Claris,0,0,0,,O zaman bunları ikinci kata çıkarır mısın?
Dialogue: 0,0:15:26.20,0:15:27.82,main,Kousuke,0,0,0,,Bana bırak.
Dialogue: 0,0:15:29.74,0:15:30.49,main,Kousuke,0,0,0,,Hı?
Dialogue: 0,0:15:30.49,0:15:31.20,main,Kousuke,0,0,0,,Bu çok hafifmiş.
Dialogue: 0,0:15:31.20,0:15:35.21,main,Claris,0,0,0,,Yok, şunu sen taşı lütfen!
Dialogue: 0,0:15:35.54,0:15:37.92,main,Claris,0,0,0,,Bunu ben alırım.
Dialogue: 0,0:15:40.79,0:15:42.67,main,Claris,0,0,0,,Dikkatli ol lütfen.
Dialogue: 0,0:15:42.67,0:15:43.84,main,Kousuke,0,0,0,,Tamam.
Dialogue: 0,0:15:52.39,0:15:53.52,main,Claris,0,0,0,,Takioto-sama!
Dialogue: 0,0:15:55.60,0:15:57.77,main,Claris,0,0,0,,Çok özür dilerim!
Dialogue: 0,0:15:58.10,0:15:59.69,main,Kousuke,0,0,0,,Sorun değil.
Dialogue: 0,0:16:00.19,0:16:00.73,main,Kousuke,0,0,0,,Hı?
Dialogue: 0,0:16:06.53,0:16:07.24,main,Kousuke,0,0,0,,Bir ip mi?
Dialogue: 0,0:16:17.33,0:16:18.29,main,Ludie,0,0,0,,Gerçekten mi?
Dialogue: 0,0:16:18.62,0:16:20.00,main,Kousuke,0,0,0,,Gerçekten.
Dialogue: 0,0:16:20.75,0:16:22.09,main,Ludie,0,0,0,,Gerçekten mi?
Dialogue: 0,0:16:22.09,0:16:25.38,main,Claris,0,0,0,,G-Gerçekten.
Dialogue: 0,0:16:25.38,0:16:28.26,main,Kousuke,0,0,0,,Demek Claris-san'ın eşyaları...
Dialogue: 0,0:16:28.26,0:16:30.14,main,Ludie,0,0,0,,İç çamaşırı.
Dialogue: 0,0:16:30.14,0:16:31.72,main,Kousuke,0,0,0,,Kafama düşmüş.
Dialogue: 0,0:16:31.72,0:16:32.93,main,Hatsumi,0,0,0,,Ne güzel.
Dialogue: 0,0:16:32.93,0:16:35.27,main,Kousuke,0,0,0,,Ben de öyle düşünmüştüm...
Dialogue: 0,0:16:35.64,0:16:37.64,main,Kousuke,0,0,0,,Ludie-san, ellerinden mana saçılıyor!
Dialogue: 0,0:16:37.89,0:16:39.77,main,Kousuke,0,0,0,,Şakaydı, lütfen durun!
Dialogue: 0,0:16:39.77,0:16:41.10,main,Ludie,0,0,0,,Bana ne dedin?
Dialogue: 0,0:16:42.19,0:16:44.90,main,Kousuke,0,0,0,,Özür dilerim, Prenses Ludivine!
Dialogue: 0,0:16:46.69,0:16:48.28,main,Ludie,0,0,0,,Bana sadece Ludie de.
Dialogue: 0,0:16:48.28,0:16:50.16,main,Ludie,0,0,0,,Ben de seninle daha samimi konuşurum.
Dialogue: 0,0:16:50.53,0:16:51.61,main,Ludie,0,0,0,,Ama asıl önemli olan,
Dialogue: 0,0:16:52.16,0:16:56.20,main,Ludie,0,0,0,,Claris'i bilerek düşürmedin, değil mi?
Dialogue: 0,0:16:56.20,0:16:58.12,main,Ludie,0,0,0,,İç çamaşırını görmek için?
Dialogue: 0,0:16:58.12,0:17:01.50,main,Kousuke,0,0,0,,Tabii ki hayır!
Dialogue: 0,0:17:01.50,0:17:03.25,main,Ludie,0,0,0,,Öyle tahmin etmiştim.
Dialogue: 0,0:17:03.25,0:17:05.09,main,Ludie,0,0,0,,Ama bunu unutma.
Dialogue: 0,0:17:05.42,0:17:09.01,main,Ludie,0,0,0,,Bize art niyetle yaklaşmaya kalkarsan...
Dialogue: 0,0:17:10.34,0:17:12.39,main,Kousuke,0,0,0,,Hiçbir art niyetim yok!
Dialogue: 0,0:17:12.97,0:17:15.43,main,Kousuke,0,0,0,,Bu arada, Nee-san, ne yapıyordun?
Dialogue: 0,0:17:15.93,0:17:17.68,main,Kousuke,0,0,0,,Deney yapıyorsan yardım edebilirim.
Dialogue: 0,0:17:18.10,0:17:18.98,main,Hatsumi,0,0,0,,Yemek yapıyorum.
Dialogue: 0,0:17:19.39,0:17:21.10,main,Hatsumi,0,0,0,,Akşam yemeğini hazırlıyordum.
Dialogue: 0,0:17:22.48,0:17:23.27,main,Kousuke,0,0,0,,Anladım.
Dialogue: 0,0:17:23.27,0:17:24.40,main,Kousuke,0,0,0,,Yemek ha?
Dialogue: 0,0:17:25.11,0:17:25.82,main,Kousuke,0,0,0,,Yemek mi...?
Dialogue: 0,0:17:35.53,0:17:40.91,main - italics,Kousuke(M),0,0,0,,Bu dünyanın yemekleri belki de\Ngöründüğü kadar kötü değildir.
Dialogue: 0,0:17:41.37,0:17:42.71,main - italics,Kousuke(M),0,0,0,,Doğru ya!
Dialogue: 0,0:17:42.71,0:17:45.63,main - italics,Kousuke(M),0,0,0,,Öyle görünüyor ama\Ntadı gayet iyi olmalı!
Dialogue: 0,0:17:45.63,0:17:47.96,main - italics,Kousuke(M),0,0,0,,Elbette güzeldir.
Dialogue: 0,0:17:51.17,0:17:52.97,main,Hatsumi,0,0,0,,Bu akşam hoş geldin partisi veriyoruz.
Dialogue: 0,0:17:54.18,0:17:55.51,main - italics,Kousuke(M),0,0,0,,Eyvah.
Dialogue: 0,0:18:04.15,0:18:05.48,main,Marino,0,0,0,,Aman!
Dialogue: 0,0:18:05.48,0:18:07.61,main,Marino,0,0,0,,Renkleri... pek güzelmiş.
Dialogue: 0,0:18:07.61,0:18:08.78,main,Hatsumi,0,0,0,,Güzel olduğuna eminim.
Dialogue: 0,0:18:12.32,0:18:14.07,main,Hatsumi,0,0,0,,Hadi, ye.
Dialogue: 0,0:18:20.45,0:18:21.54,main,Kousuke,0,0,0,,Eline sağlık.
Dialogue: 0,0:18:24.29,0:18:25.96,main - italics,Kousuke(M),0,0,0,,Kıvamı pudinge benziyor.
Dialogue: 0,0:18:26.63,0:18:27.71,main - italics,Kousuke(M),0,0,0,,Ama garip bir şekilde...
Dialogue: 0,0:18:28.29,0:18:30.67,main - italics,Kousuke(M),0,0,0,,Denizin üstündeki yağ gibi,
Dialogue: 0,0:18:30.67,0:18:32.88,main - italics,Kousuke(M),0,0,0,,açısına göre rengi değişiyor.
Dialogue: 0,0:18:32.88,0:18:34.80,main,Hatsumi,0,0,0,,Eti uzun süre pişirdim,
Dialogue: 0,0:18:34.80,0:18:36.09,main,Hatsumi,0,0,0,,çok lezzetli olmalı.
Dialogue: 0,0:18:36.09,0:18:39.76,main - italics,Kousuke(M),0,0,0,,Bu... yenebilir bir et, değil mi?
Dialogue: 0,0:18:43.52,0:18:45.06,main - italics,Kousuke(M),0,0,0,,Bir ses duyuyorum...
Dialogue: 0,0:18:45.44,0:18:48.65,main - italics,Kousuke(M),0,0,0,,Bana gel diyor.
Dialogue: 0,0:18:48.65,0:18:51.94,main - italics,Kousuke(M),0,0,0,,Ne güzel kızlar var.
Dialogue: 0,0:18:51.94,0:18:54.15,main,Hatsumi,0,0,0,,Çabuk uyan, Onii-chan.
Dialogue: 0,0:18:54.15,0:18:56.03,main,Marino,0,0,0,,İstediğin kadar ye.
Dialogue: 0,0:18:56.32,0:18:57.87,main,Claris,0,0,0,,Günaydın.
Dialogue: 0,0:18:57.87,0:19:00.70,main,Ludie,0,0,0,,Sen kaderimdeki kişiymişsin!
Dialogue: 0,0:19:00.70,0:19:01.41,main,Ludie,0,0,0,,Kousuke.
Dialogue: 0,0:19:01.70,0:19:02.87,main,Ludie,0,0,0,,Kousuke!
Dialogue: 0,0:19:02.87,0:19:04.12,main,Kousuke,0,0,0,,Ah!
Dialogue: 0,0:19:04.37,0:19:05.33,main,Hatsumi,0,0,0,,Nasıl olmuş?
Dialogue: 0,0:19:05.33,0:19:08.71,main,Kousuke,0,0,0,,B-Bence biraz daha\Npratik yapmanız gerek.
Dialogue: 0,0:19:11.17,0:19:15.26,main,Marino,0,0,0,,Hatsumi, pirinci deterjanla mı yıkadın?
Dialogue: 0,0:19:15.72,0:19:18.60,main,Hatsumi,0,0,0,,Evet. Güçlü olanı kullandım.
Dialogue: 0,0:19:18.97,0:19:20.35,main,Marino,0,0,0,,A-Anladım.
Dialogue: 0,0:19:20.35,0:19:25.44,main,Marino,0,0,0,,Hatsumi, pirinci yıkarken deterjan değil,\Nsadece su kullanıyoruz.
Dialogue: 0,0:19:25.73,0:19:27.10,main,Hatsumi,0,0,0,,Özür dilerim.
Dialogue: 0,0:19:27.10,0:19:28.81,main,Hatsumi,0,0,0,,Bir dahaki sefere dikkat ederim.
Dialogue: 0,0:19:29.31,0:19:31.69,main,Hatsumi,0,0,0,,Ludie, pirinç dışındakileri de dene.
Dialogue: 0,0:19:33.53,0:19:34.40,main,Ludie,0,0,0,,Tamam.
Dialogue: 0,0:19:53.63,0:19:57.43,main,Marino,0,0,0,,Aman, Ludie-chan nereye gitti acaba?
Dialogue: 0,0:19:57.43,0:19:59.01,main,Marino,0,0,0,,Yoksa hamile mi?
Dialogue: 0,0:20:02.51,0:20:03.64,main,Kousuke,0,0,0,,Ben yerim.
Dialogue: 0,0:20:11.77,0:20:16.28,main - italics,Kousuke(M),0,0,0,,Hatsumi-neesan üzülmesin diye yedim sadece.
Dialogue: 0,0:20:38.34,0:20:42.22,main - italics,Kousuke(M),0,0,0,,Ben ne hâle geldim?
Dialogue: 0,0:20:47.98,0:20:51.10,main,Ludie,0,0,0,,Peki, “yaşamak” ne demek?
Dialogue: 0,0:20:51.52,0:20:54.86,main,Kousuke,0,0,0,,Mutluluk aramak tabii ki.
Dialogue: 0,0:20:54.86,0:20:57.94,main,Ludie,0,0,0,,Peki... mutluluk nedir?
Dialogue: 0,0:21:12.83,0:21:14.46,main,Ludie,0,0,0,,Bu ne?
Dialogue: 0,0:21:14.46,0:21:15.38,main,Kousuke,0,0,0,,Ye hadi.
Dialogue: 0,0:21:15.67,0:21:17.05,main,Kousuke,0,0,0,,Çabucak kendine gelirsin.
Dialogue: 0,0:21:35.11,0:21:36.32,main - italics,Kousuke(M),0,0,0,,Onu ağlarken yalnızca bir kez görmüştüm,
Dialogue: 0,0:21:36.32,0:21:39.07,main - italics,Kousuke(M),0,0,0,,Kötücül Lord Kilisesi'yle yapılan\Nson savaşta.
Dialogue: 0,0:21:39.74,0:21:42.41,main - italics,Kousuke(M),0,0,0,,Hazır erişteyle de ağlayacağını\Nhiç düşünmezdim...
Dialogue: 0,0:21:40.24,0:21:41.45,main - top,Ludie,0,0,0,,Çok güzel!
Dialogue: 0,0:21:41.74,0:21:44.03,main - top,Ludie,0,0,0,,Çok güzel!
Dialogue: 0,0:23:25.80,0:23:26.47,main,KnightA,0,0,0,,Onu bulabildiniz mi?
Dialogue: 0,0:23:26.97,0:23:29.51,main,KnightB,0,0,0,,Hayır. İzine rastladık ama...
Dialogue: 0,0:23:29.51,0:23:32.22,main,KnightA,0,0,0,,Yakında olmalı. Hadi bulalım!
